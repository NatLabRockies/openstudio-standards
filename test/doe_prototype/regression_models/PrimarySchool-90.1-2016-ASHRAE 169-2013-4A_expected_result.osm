OS:EnergyManagementSystem:Program,
  {eadaf654-bd4b-4477-8c3c-e08a405393e2}, !- Handle
  ems_PVAV_POD_2_OptimumStartProg0,       !- Name
  IF DaylightSavings==0 && DayOfWeek>1 && Hour==5 && {676e6524-f045-41dd-847c-2b84080a9510}<23.9 && {676e6524-f045-41dd-847c-2b84080a9510}>1.7, !- Program Line 1
  SET {0971b21d-b4af-456f-afa4-031dbbdaf988} = 29.4, !- Program Line 2
  SET {b5b5cf8e-bb28-43d4-ad8b-12c325edf76c} = 15.6, !- Program Line 3
  ELSEIF DaylightSavings==0 && DayOfWeek==1 && Hour==7 && {676e6524-f045-41dd-847c-2b84080a9510}<23.9 && {676e6524-f045-41dd-847c-2b84080a9510}>1.7, !- Program Line 4
  SET {0971b21d-b4af-456f-afa4-031dbbdaf988} = 29.4, !- Program Line 5
  SET {b5b5cf8e-bb28-43d4-ad8b-12c325edf76c} = 15.6, !- Program Line 6
  ELSEIF DaylightSavings==1 && DayOfWeek>1 && Hour==4 && {676e6524-f045-41dd-847c-2b84080a9510}<23.9 && {676e6524-f045-41dd-847c-2b84080a9510}>1.7, !- Program Line 7
  SET {0971b21d-b4af-456f-afa4-031dbbdaf988} = 29.4, !- Program Line 8
  SET {b5b5cf8e-bb28-43d4-ad8b-12c325edf76c} = 15.6, !- Program Line 9
  ELSEIF DaylightSavings==1 && DayOfWeek==1 && Hour==6 && {676e6524-f045-41dd-847c-2b84080a9510}<23.9 && {676e6524-f045-41dd-847c-2b84080a9510}>1.7, !- Program Line 10
  SET {0971b21d-b4af-456f-afa4-031dbbdaf988} = 29.4, !- Program Line 11
  SET {b5b5cf8e-bb28-43d4-ad8b-12c325edf76c} = 15.6, !- Program Line 12
  ELSE,                                   !- Program Line 13
  SET {0971b21d-b4af-456f-afa4-031dbbdaf988} = NULL, !- Program Line 14
  SET {b5b5cf8e-bb28-43d4-ad8b-12c325edf76c} = NULL, !- Program Line 15
  ENDIF;                                  !- Program Line 16

