OS:EnergyManagementSystem:Program,
  {27b7a33f-d3d1-4ea6-a383-5841d3a047bc}, !- Handle
  ems_PVAV_POD_2_OptimumStartProg0,       !- Name
  IF DaylightSavings==0 && DayOfWeek>1 && Hour==5 && {c5e0392b-6a4b-4cb7-91de-864be1297f18}<23.9 && {c5e0392b-6a4b-4cb7-91de-864be1297f18}>1.7, !- Program Line 1
  SET {3ec987ce-a9a4-4bca-8cce-3ea02fbf11a6} = 29.4, !- Program Line 2
  SET {8f606661-626e-4c2a-8f74-a757d799578a} = 15.6, !- Program Line 3
  ELSEIF DaylightSavings==0 && DayOfWeek==1 && Hour==7 && {c5e0392b-6a4b-4cb7-91de-864be1297f18}<23.9 && {c5e0392b-6a4b-4cb7-91de-864be1297f18}>1.7, !- Program Line 4
  SET {3ec987ce-a9a4-4bca-8cce-3ea02fbf11a6} = 29.4, !- Program Line 5
  SET {8f606661-626e-4c2a-8f74-a757d799578a} = 15.6, !- Program Line 6
  ELSEIF DaylightSavings==1 && DayOfWeek>1 && Hour==4 && {c5e0392b-6a4b-4cb7-91de-864be1297f18}<23.9 && {c5e0392b-6a4b-4cb7-91de-864be1297f18}>1.7, !- Program Line 7
  SET {3ec987ce-a9a4-4bca-8cce-3ea02fbf11a6} = 29.4, !- Program Line 8
  SET {8f606661-626e-4c2a-8f74-a757d799578a} = 15.6, !- Program Line 9
  ELSEIF DaylightSavings==1 && DayOfWeek==1 && Hour==6 && {c5e0392b-6a4b-4cb7-91de-864be1297f18}<23.9 && {c5e0392b-6a4b-4cb7-91de-864be1297f18}>1.7, !- Program Line 10
  SET {3ec987ce-a9a4-4bca-8cce-3ea02fbf11a6} = 29.4, !- Program Line 11
  SET {8f606661-626e-4c2a-8f74-a757d799578a} = 15.6, !- Program Line 12
  ELSE,                                   !- Program Line 13
  SET {3ec987ce-a9a4-4bca-8cce-3ea02fbf11a6} = NULL, !- Program Line 14
  SET {8f606661-626e-4c2a-8f74-a757d799578a} = NULL, !- Program Line 15
