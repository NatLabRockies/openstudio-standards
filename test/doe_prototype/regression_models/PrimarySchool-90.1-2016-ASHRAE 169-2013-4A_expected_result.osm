OS:EnergyManagementSystem:Program,
  {8606042c-4bcf-4732-b7b8-6b928b428698}, !- Handle
  ems_PVAV_OTHER_OptimumStartProg0,       !- Name
  IF DaylightSavings==0 && DayOfWeek>1 && Hour==5 && {4d607f4f-bdda-4382-904f-c15af1ed6acc}<23.9 && {4d607f4f-bdda-4382-904f-c15af1ed6acc}>1.7, !- Program Line 1
  SET {26e4304b-2337-4af2-964b-cbe579f14db3} = 29.4, !- Program Line 2
  SET {c4eec86e-f4a9-4af7-947d-07b437682428} = 15.6, !- Program Line 3
  ELSEIF DaylightSavings==0 && DayOfWeek==1 && Hour==7 && {4d607f4f-bdda-4382-904f-c15af1ed6acc}<23.9 && {4d607f4f-bdda-4382-904f-c15af1ed6acc}>1.7, !- Program Line 4
  SET {26e4304b-2337-4af2-964b-cbe579f14db3} = 29.4, !- Program Line 5
  SET {c4eec86e-f4a9-4af7-947d-07b437682428} = 15.6, !- Program Line 6
  ELSEIF DaylightSavings==1 && DayOfWeek>1 && Hour==4 && {4d607f4f-bdda-4382-904f-c15af1ed6acc}<23.9 && {4d607f4f-bdda-4382-904f-c15af1ed6acc}>1.7, !- Program Line 7
  SET {26e4304b-2337-4af2-964b-cbe579f14db3} = 29.4, !- Program Line 8
  SET {c4eec86e-f4a9-4af7-947d-07b437682428} = 15.6, !- Program Line 9
  ELSEIF DaylightSavings==1 && DayOfWeek==1 && Hour==6 && {4d607f4f-bdda-4382-904f-c15af1ed6acc}<23.9 && {4d607f4f-bdda-4382-904f-c15af1ed6acc}>1.7, !- Program Line 10
  SET {26e4304b-2337-4af2-964b-cbe579f14db3} = 29.4, !- Program Line 11
  SET {c4eec86e-f4a9-4af7-947d-07b437682428} = 15.6, !- Program Line 12
  ELSE,                                   !- Program Line 13
  SET {26e4304b-2337-4af2-964b-cbe579f14db3} = NULL, !- Program Line 14
  SET {c4eec86e-f4a9-4af7-947d-07b437682428} = NULL, !- Program Line 15
  ENDIF;                                  !- Program Line 16

