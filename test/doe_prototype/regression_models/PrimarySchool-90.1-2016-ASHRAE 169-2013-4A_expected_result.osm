OS:EnergyManagementSystem:Program,
  {8915734e-9c05-4102-928b-c1fd0910a1d8}, !- Handle
  ems_PVAV_OTHER_OptimumStartProg0,       !- Name
  IF DaylightSavings==0 && DayOfWeek>1 && Hour==5 && {cf1d1a54-b4ae-404a-a6ba-6df14e7b6106}<23.9 && {cf1d1a54-b4ae-404a-a6ba-6df14e7b6106}>1.7, !- Program Line 1
  SET {fd2f9dce-2b8a-4837-868a-bfd3df1c0ab2} = 29.4, !- Program Line 2
  SET {1f5823ee-932f-473b-9ce6-936fa9c8ba30} = 15.6, !- Program Line 3
  ELSEIF DaylightSavings==0 && DayOfWeek==1 && Hour==7 && {cf1d1a54-b4ae-404a-a6ba-6df14e7b6106}<23.9 && {cf1d1a54-b4ae-404a-a6ba-6df14e7b6106}>1.7, !- Program Line 4
  SET {fd2f9dce-2b8a-4837-868a-bfd3df1c0ab2} = 29.4, !- Program Line 5
  SET {1f5823ee-932f-473b-9ce6-936fa9c8ba30} = 15.6, !- Program Line 6
  ELSEIF DaylightSavings==1 && DayOfWeek>1 && Hour==4 && {cf1d1a54-b4ae-404a-a6ba-6df14e7b6106}<23.9 && {cf1d1a54-b4ae-404a-a6ba-6df14e7b6106}>1.7, !- Program Line 7
  SET {fd2f9dce-2b8a-4837-868a-bfd3df1c0ab2} = 29.4, !- Program Line 8
  SET {1f5823ee-932f-473b-9ce6-936fa9c8ba30} = 15.6, !- Program Line 9
  ELSEIF DaylightSavings==1 && DayOfWeek==1 && Hour==6 && {cf1d1a54-b4ae-404a-a6ba-6df14e7b6106}<23.9 && {cf1d1a54-b4ae-404a-a6ba-6df14e7b6106}>1.7, !- Program Line 10
  SET {fd2f9dce-2b8a-4837-868a-bfd3df1c0ab2} = 29.4, !- Program Line 11
  SET {1f5823ee-932f-473b-9ce6-936fa9c8ba30} = 15.6, !- Program Line 12
  ELSE,                                   !- Program Line 13
  SET {fd2f9dce-2b8a-4837-868a-bfd3df1c0ab2} = NULL, !- Program Line 14
  SET {1f5823ee-932f-473b-9ce6-936fa9c8ba30} = NULL, !- Program Line 15
  ENDIF;                                  !- Program Line 16

