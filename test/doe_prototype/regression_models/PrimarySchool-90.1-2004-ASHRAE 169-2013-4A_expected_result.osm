OS:EnergyManagementSystem:Program,
  {1b974580-5ef7-4cc6-a7bd-31fd0ce71ae8}, !- Handle
  ems_PVAV_OTHER_OptimumStartProg0,       !- Name
  IF DaylightSavings==0 && DayOfWeek>1 && Hour==5 && {da4028b3-3fa0-42ff-8d6e-347e86b690a9}<23.9 && {da4028b3-3fa0-42ff-8d6e-347e86b690a9}>1.7, !- Program Line 1
  SET {059bc238-9c38-45d2-bf5a-eb1914ca7add} = 29.4, !- Program Line 2
  SET {ce134338-73b9-4301-80bc-66079b3ac3f5} = 15.6, !- Program Line 3
  ELSEIF DaylightSavings==0 && DayOfWeek==1 && Hour==7 && {da4028b3-3fa0-42ff-8d6e-347e86b690a9}<23.9 && {da4028b3-3fa0-42ff-8d6e-347e86b690a9}>1.7, !- Program Line 4
