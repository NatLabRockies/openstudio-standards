  {46bac1e4-dab1-479d-a3b8-ca6b522bf6e4}, !- Handle
  ems_PVAV_OTHER_OptimumStartProg0,       !- Name
  IF DaylightSavings==0 && DayOfWeek>1 && Hour==5 && {29b6ce2f-670c-49da-8145-67d797abff68}<23.9 && {29b6ce2f-670c-49da-8145-67d797abff68}>1.7, !- Program Line 1
  SET {0c3cea74-79a0-4305-be1e-a419bf5c1c6c} = 29.4, !- Program Line 2
  SET {a54e66b2-efd3-45bb-9804-53129fe12ea9} = 15.6, !- Program Line 3
  ELSEIF DaylightSavings==0 && DayOfWeek==1 && Hour==7 && {29b6ce2f-670c-49da-8145-67d797abff68}<23.9 && {29b6ce2f-670c-49da-8145-67d797abff68}>1.7, !- Program Line 4
  SET {0c3cea74-79a0-4305-be1e-a419bf5c1c6c} = 29.4, !- Program Line 5
  SET {a54e66b2-efd3-45bb-9804-53129fe12ea9} = 15.6, !- Program Line 6
  ELSEIF DaylightSavings==1 && DayOfWeek>1 && Hour==4 && {29b6ce2f-670c-49da-8145-67d797abff68}<23.9 && {29b6ce2f-670c-49da-8145-67d797abff68}>1.7, !- Program Line 7
