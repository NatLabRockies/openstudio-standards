OS:EnergyManagementSystem:Program,
  {f308706d-e93b-42b3-8a55-47ae31e008e3}, !- Handle
  ems_PVAV_OTHER_OptimumStartProg0,       !- Name
  IF DaylightSavings==0 && DayOfWeek>1 && Hour==5 && {78bd6aa2-b726-49e6-828d-48e56b55f1ac}<23.9 && {78bd6aa2-b726-49e6-828d-48e56b55f1ac}>1.7, !- Program Line 1
  SET {33321236-5a2b-4674-94f1-d5a7b01ccd1b} = 29.4, !- Program Line 2
  SET {fb8c0790-2916-47d4-96d2-0c7446c99492} = 15.6, !- Program Line 3
  ELSEIF DaylightSavings==0 && DayOfWeek==1 && Hour==7 && {78bd6aa2-b726-49e6-828d-48e56b55f1ac}<23.9 && {78bd6aa2-b726-49e6-828d-48e56b55f1ac}>1.7, !- Program Line 4
  SET {33321236-5a2b-4674-94f1-d5a7b01ccd1b} = 29.4, !- Program Line 5
  SET {fb8c0790-2916-47d4-96d2-0c7446c99492} = 15.6, !- Program Line 6
  ELSEIF DaylightSavings==1 && DayOfWeek>1 && Hour==4 && {78bd6aa2-b726-49e6-828d-48e56b55f1ac}<23.9 && {78bd6aa2-b726-49e6-828d-48e56b55f1ac}>1.7, !- Program Line 7
  SET {33321236-5a2b-4674-94f1-d5a7b01ccd1b} = 29.4, !- Program Line 8
  SET {fb8c0790-2916-47d4-96d2-0c7446c99492} = 15.6, !- Program Line 9
  ELSEIF DaylightSavings==1 && DayOfWeek==1 && Hour==6 && {78bd6aa2-b726-49e6-828d-48e56b55f1ac}<23.9 && {78bd6aa2-b726-49e6-828d-48e56b55f1ac}>1.7, !- Program Line 10
  SET {33321236-5a2b-4674-94f1-d5a7b01ccd1b} = 29.4, !- Program Line 11
  SET {fb8c0790-2916-47d4-96d2-0c7446c99492} = 15.6, !- Program Line 12
  ELSE,                                   !- Program Line 13
  SET {33321236-5a2b-4674-94f1-d5a7b01ccd1b} = NULL, !- Program Line 14
  SET {fb8c0790-2916-47d4-96d2-0c7446c99492} = NULL, !- Program Line 15
  ENDIF;                                  !- Program Line 16

