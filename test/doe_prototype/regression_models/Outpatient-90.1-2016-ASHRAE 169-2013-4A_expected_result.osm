  {e6cdfae6-3a63-4fad-8fbb-750169820c72}, !- Handle
  ems_PVAV_Outpatient_F1_OptimumStartProg0, !- Name
  IF DaylightSavings==0 && DayOfWeek>1 && Hour==5 && {072ae167-302b-425e-81bd-3e06d50fe4a6}<23.9 && {072ae167-302b-425e-81bd-3e06d50fe4a6}>1.7, !- Program Line 1
  SET {5bbf1d6e-f127-4ad8-a971-f50289886e00} = 29.4, !- Program Line 2
  SET {5a47948d-931c-47cc-af75-6e3d861b5f9c} = 15.6, !- Program Line 3
  ELSEIF DaylightSavings==0 && DayOfWeek==1 && Hour==7 && {072ae167-302b-425e-81bd-3e06d50fe4a6}<23.9 && {072ae167-302b-425e-81bd-3e06d50fe4a6}>1.7, !- Program Line 4
  SET {5bbf1d6e-f127-4ad8-a971-f50289886e00} = 29.4, !- Program Line 5
  SET {5a47948d-931c-47cc-af75-6e3d861b5f9c} = 15.6, !- Program Line 6
  ELSEIF DaylightSavings==1 && DayOfWeek>1 && Hour==4 && {072ae167-302b-425e-81bd-3e06d50fe4a6}<23.9 && {072ae167-302b-425e-81bd-3e06d50fe4a6}>1.7, !- Program Line 7
  SET {5bbf1d6e-f127-4ad8-a971-f50289886e00} = 29.4, !- Program Line 8
  SET {5a47948d-931c-47cc-af75-6e3d861b5f9c} = 15.6, !- Program Line 9
  ELSEIF DaylightSavings==1 && DayOfWeek==1 && Hour==6 && {072ae167-302b-425e-81bd-3e06d50fe4a6}<23.9 && {072ae167-302b-425e-81bd-3e06d50fe4a6}>1.7, !- Program Line 10
  SET {5bbf1d6e-f127-4ad8-a971-f50289886e00} = 29.4, !- Program Line 11
  SET {5a47948d-931c-47cc-af75-6e3d861b5f9c} = 15.6, !- Program Line 12
  ELSE,                                   !- Program Line 13
  SET {5bbf1d6e-f127-4ad8-a971-f50289886e00} = NULL, !- Program Line 14
  SET {5a47948d-931c-47cc-af75-6e3d861b5f9c} = NULL, !- Program Line 15
