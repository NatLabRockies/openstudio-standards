  {22c0272c-8e24-4c96-9487-183eda17425d}, !- Handle
  ems_PVAV_Outpatient_F1_OptimumStartProg0, !- Name
  IF DaylightSavings==0 && DayOfWeek>1 && Hour==5 && {bd98c5c7-a010-402f-ace9-0167226f6c6e}<23.9 && {bd98c5c7-a010-402f-ace9-0167226f6c6e}>1.7, !- Program Line 1
  SET {f6396da5-9d08-4203-b945-967905ce6f99} = 29.4, !- Program Line 2
  SET {1887e238-2f64-469d-81b8-97444fcfcc69} = 15.6, !- Program Line 3
  ELSEIF DaylightSavings==0 && DayOfWeek==1 && Hour==7 && {bd98c5c7-a010-402f-ace9-0167226f6c6e}<23.9 && {bd98c5c7-a010-402f-ace9-0167226f6c6e}>1.7, !- Program Line 4
  SET {f6396da5-9d08-4203-b945-967905ce6f99} = 29.4, !- Program Line 5
  SET {1887e238-2f64-469d-81b8-97444fcfcc69} = 15.6, !- Program Line 6
  ELSEIF DaylightSavings==1 && DayOfWeek>1 && Hour==4 && {bd98c5c7-a010-402f-ace9-0167226f6c6e}<23.9 && {bd98c5c7-a010-402f-ace9-0167226f6c6e}>1.7, !- Program Line 7
  SET {f6396da5-9d08-4203-b945-967905ce6f99} = 29.4, !- Program Line 8
  SET {1887e238-2f64-469d-81b8-97444fcfcc69} = 15.6, !- Program Line 9
  ELSEIF DaylightSavings==1 && DayOfWeek==1 && Hour==6 && {bd98c5c7-a010-402f-ace9-0167226f6c6e}<23.9 && {bd98c5c7-a010-402f-ace9-0167226f6c6e}>1.7, !- Program Line 10
  SET {f6396da5-9d08-4203-b945-967905ce6f99} = 29.4, !- Program Line 11
  SET {1887e238-2f64-469d-81b8-97444fcfcc69} = 15.6, !- Program Line 12
  ELSE,                                   !- Program Line 13
  SET {f6396da5-9d08-4203-b945-967905ce6f99} = NULL, !- Program Line 14
  SET {1887e238-2f64-469d-81b8-97444fcfcc69} = NULL, !- Program Line 15
