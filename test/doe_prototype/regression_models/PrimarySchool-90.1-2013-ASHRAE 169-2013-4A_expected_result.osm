  ELSEIF DaylightSavings==0 && DayOfWeek==1 && Hour==7 && {915be29a-fdab-467f-bb48-b1213eda1c21}<23.9 && {915be29a-fdab-467f-bb48-b1213eda1c21}>1.7, !- Program Line 4
  SET {b7ca957f-4201-46af-bc46-d3a1e0f0d506} = 29.4, !- Program Line 5
  SET {3308ad1e-559e-4c63-b8d0-9ae84bdb18cd} = 15.6, !- Program Line 6
  ELSEIF DaylightSavings==1 && DayOfWeek>1 && Hour==4 && {915be29a-fdab-467f-bb48-b1213eda1c21}<23.9 && {915be29a-fdab-467f-bb48-b1213eda1c21}>1.7, !- Program Line 7
  SET {b7ca957f-4201-46af-bc46-d3a1e0f0d506} = 29.4, !- Program Line 8
  SET {3308ad1e-559e-4c63-b8d0-9ae84bdb18cd} = 15.6, !- Program Line 9
  ELSEIF DaylightSavings==1 && DayOfWeek==1 && Hour==6 && {915be29a-fdab-467f-bb48-b1213eda1c21}<23.9 && {915be29a-fdab-467f-bb48-b1213eda1c21}>1.7, !- Program Line 10
  SET {b7ca957f-4201-46af-bc46-d3a1e0f0d506} = 29.4, !- Program Line 11
  SET {3308ad1e-559e-4c63-b8d0-9ae84bdb18cd} = 15.6, !- Program Line 12
  ELSE,                                   !- Program Line 13
  SET {b7ca957f-4201-46af-bc46-d3a1e0f0d506} = NULL, !- Program Line 14
  SET {3308ad1e-559e-4c63-b8d0-9ae84bdb18cd} = NULL, !- Program Line 15
