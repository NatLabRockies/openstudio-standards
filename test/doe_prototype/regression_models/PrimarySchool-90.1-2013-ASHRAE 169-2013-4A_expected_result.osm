OS:EnergyManagementSystem:Program,
  {76b55559-d21b-48a1-ae25-ba903f9f4e5e}, !- Handle
  ems_PVAV_OTHER_OptimumStartProg0,       !- Name
  IF DaylightSavings==0 && DayOfWeek>1 && Hour==5 && {48d8d7c4-40c2-42db-b4a2-97f43494baf2}<23.9 && {48d8d7c4-40c2-42db-b4a2-97f43494baf2}>1.7, !- Program Line 1
  SET {d93ac53d-4c35-42ee-8897-47ad251d27bc} = 29.4, !- Program Line 2
  SET {0d3181b6-3741-4cbf-a85e-819b8e688a47} = 15.6, !- Program Line 3
  ELSEIF DaylightSavings==0 && DayOfWeek==1 && Hour==7 && {48d8d7c4-40c2-42db-b4a2-97f43494baf2}<23.9 && {48d8d7c4-40c2-42db-b4a2-97f43494baf2}>1.7, !- Program Line 4
  SET {d93ac53d-4c35-42ee-8897-47ad251d27bc} = 29.4, !- Program Line 5
  SET {0d3181b6-3741-4cbf-a85e-819b8e688a47} = 15.6, !- Program Line 6
  ELSEIF DaylightSavings==1 && DayOfWeek>1 && Hour==4 && {48d8d7c4-40c2-42db-b4a2-97f43494baf2}<23.9 && {48d8d7c4-40c2-42db-b4a2-97f43494baf2}>1.7, !- Program Line 7
  SET {d93ac53d-4c35-42ee-8897-47ad251d27bc} = 29.4, !- Program Line 8
  SET {0d3181b6-3741-4cbf-a85e-819b8e688a47} = 15.6, !- Program Line 9
  ELSEIF DaylightSavings==1 && DayOfWeek==1 && Hour==6 && {48d8d7c4-40c2-42db-b4a2-97f43494baf2}<23.9 && {48d8d7c4-40c2-42db-b4a2-97f43494baf2}>1.7, !- Program Line 10
  SET {d93ac53d-4c35-42ee-8897-47ad251d27bc} = 29.4, !- Program Line 11
  SET {0d3181b6-3741-4cbf-a85e-819b8e688a47} = 15.6, !- Program Line 12
  ELSE,                                   !- Program Line 13
  SET {d93ac53d-4c35-42ee-8897-47ad251d27bc} = NULL, !- Program Line 14
  SET {0d3181b6-3741-4cbf-a85e-819b8e688a47} = NULL, !- Program Line 15
  ENDIF;                                  !- Program Line 16

