OS:EnergyManagementSystem:Program,
  {8f831e2c-a364-4968-81cc-26914ade7b16}, !- Handle
  ems_PVAV_OTHER_OptimumStartProg0,       !- Name
  IF DaylightSavings==0 && DayOfWeek>1 && Hour==5 && {64307fd5-8e60-4184-8f35-1a41b8905be9}<23.9 && {64307fd5-8e60-4184-8f35-1a41b8905be9}>1.7, !- Program Line 1
  SET {d111cfa7-aad6-4452-a32c-60b2ceadd01f} = 29.4, !- Program Line 2
  SET {073e3c83-22bc-41af-b018-0b654619e55a} = 15.6, !- Program Line 3
  ELSEIF DaylightSavings==0 && DayOfWeek==1 && Hour==7 && {64307fd5-8e60-4184-8f35-1a41b8905be9}<23.9 && {64307fd5-8e60-4184-8f35-1a41b8905be9}>1.7, !- Program Line 4
  SET {d111cfa7-aad6-4452-a32c-60b2ceadd01f} = 29.4, !- Program Line 5
  SET {073e3c83-22bc-41af-b018-0b654619e55a} = 15.6, !- Program Line 6
  ELSEIF DaylightSavings==1 && DayOfWeek>1 && Hour==4 && {64307fd5-8e60-4184-8f35-1a41b8905be9}<23.9 && {64307fd5-8e60-4184-8f35-1a41b8905be9}>1.7, !- Program Line 7
  SET {d111cfa7-aad6-4452-a32c-60b2ceadd01f} = 29.4, !- Program Line 8
  SET {073e3c83-22bc-41af-b018-0b654619e55a} = 15.6, !- Program Line 9
  ELSEIF DaylightSavings==1 && DayOfWeek==1 && Hour==6 && {64307fd5-8e60-4184-8f35-1a41b8905be9}<23.9 && {64307fd5-8e60-4184-8f35-1a41b8905be9}>1.7, !- Program Line 10
  SET {d111cfa7-aad6-4452-a32c-60b2ceadd01f} = 29.4, !- Program Line 11
  SET {073e3c83-22bc-41af-b018-0b654619e55a} = 15.6, !- Program Line 12
  ELSE,                                   !- Program Line 13
  SET {d111cfa7-aad6-4452-a32c-60b2ceadd01f} = NULL, !- Program Line 14
  SET {073e3c83-22bc-41af-b018-0b654619e55a} = NULL, !- Program Line 15
  ENDIF;                                  !- Program Line 16

