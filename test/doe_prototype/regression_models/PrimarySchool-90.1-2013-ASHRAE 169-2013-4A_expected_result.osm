  ELSEIF DaylightSavings==0 && DayOfWeek==1 && Hour==7 && {0d8006ee-6c93-4b79-80ab-70416a666dc4}<23.9 && {0d8006ee-6c93-4b79-80ab-70416a666dc4}>1.7, !- Program Line 4
  SET {91638a63-4e44-45ad-99a9-4e1cb302ba7b} = 29.4, !- Program Line 5
  SET {c89d4833-f013-423c-8a41-00b56aada963} = 15.6, !- Program Line 6
  ELSEIF DaylightSavings==1 && DayOfWeek>1 && Hour==4 && {0d8006ee-6c93-4b79-80ab-70416a666dc4}<23.9 && {0d8006ee-6c93-4b79-80ab-70416a666dc4}>1.7, !- Program Line 7
  SET {91638a63-4e44-45ad-99a9-4e1cb302ba7b} = 29.4, !- Program Line 8
  SET {c89d4833-f013-423c-8a41-00b56aada963} = 15.6, !- Program Line 9
  ELSEIF DaylightSavings==1 && DayOfWeek==1 && Hour==6 && {0d8006ee-6c93-4b79-80ab-70416a666dc4}<23.9 && {0d8006ee-6c93-4b79-80ab-70416a666dc4}>1.7, !- Program Line 10
  SET {91638a63-4e44-45ad-99a9-4e1cb302ba7b} = 29.4, !- Program Line 11
  SET {c89d4833-f013-423c-8a41-00b56aada963} = 15.6, !- Program Line 12
