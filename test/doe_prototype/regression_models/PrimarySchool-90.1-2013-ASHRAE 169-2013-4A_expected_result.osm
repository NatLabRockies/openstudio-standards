  ems_PVAV_OTHER_OptimumStartProg0,       !- Name
  IF DaylightSavings==0 && DayOfWeek>1 && Hour==5 && {0d8006ee-6c93-4b79-80ab-70416a666dc4}<23.9 && {0d8006ee-6c93-4b79-80ab-70416a666dc4}>1.7, !- Program Line 1
