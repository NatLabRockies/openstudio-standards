OS:EnergyManagementSystem:Program,
  {d1fe78ff-731d-4235-9a01-dd88885704de}, !- Handle
  ems_PVAV_OTHER_OptimumStartProg0,       !- Name
  IF DaylightSavings==0 && DayOfWeek>1 && Hour==5 && {5f7c758c-36a1-4770-87aa-47a91750acf3}<23.9 && {5f7c758c-36a1-4770-87aa-47a91750acf3}>1.7, !- Program Line 1
  SET {6e34ad4f-67f2-424d-a80f-29e35e5afd24} = 29.4, !- Program Line 2
  SET {c1776a54-e7e3-4747-861f-d712cb2ecaf4} = 15.6, !- Program Line 3
  ELSEIF DaylightSavings==0 && DayOfWeek==1 && Hour==7 && {5f7c758c-36a1-4770-87aa-47a91750acf3}<23.9 && {5f7c758c-36a1-4770-87aa-47a91750acf3}>1.7, !- Program Line 4
  SET {6e34ad4f-67f2-424d-a80f-29e35e5afd24} = 29.4, !- Program Line 5
  SET {c1776a54-e7e3-4747-861f-d712cb2ecaf4} = 15.6, !- Program Line 6
  ELSEIF DaylightSavings==1 && DayOfWeek>1 && Hour==4 && {5f7c758c-36a1-4770-87aa-47a91750acf3}<23.9 && {5f7c758c-36a1-4770-87aa-47a91750acf3}>1.7, !- Program Line 7
  SET {6e34ad4f-67f2-424d-a80f-29e35e5afd24} = 29.4, !- Program Line 8
  SET {c1776a54-e7e3-4747-861f-d712cb2ecaf4} = 15.6, !- Program Line 9
  ELSEIF DaylightSavings==1 && DayOfWeek==1 && Hour==6 && {5f7c758c-36a1-4770-87aa-47a91750acf3}<23.9 && {5f7c758c-36a1-4770-87aa-47a91750acf3}>1.7, !- Program Line 10
  SET {6e34ad4f-67f2-424d-a80f-29e35e5afd24} = 29.4, !- Program Line 11
  SET {c1776a54-e7e3-4747-861f-d712cb2ecaf4} = 15.6, !- Program Line 12
  ELSE,                                   !- Program Line 13
  SET {6e34ad4f-67f2-424d-a80f-29e35e5afd24} = NULL, !- Program Line 14
  SET {c1776a54-e7e3-4747-861f-d712cb2ecaf4} = NULL, !- Program Line 15
  ENDIF;                                  !- Program Line 16

