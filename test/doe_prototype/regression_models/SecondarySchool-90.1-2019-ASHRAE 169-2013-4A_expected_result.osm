  {b916e859-ed56-4c6f-807b-96b9accbaa98}, !- Handle
  ems_VAV_POD_3_OptimumStartProg0,        !- Name
  IF DaylightSavings==0 && DayOfWeek>1 && Hour==5 && {e2c18b0b-411f-477f-8994-4faeff622179}<23.9 && {e2c18b0b-411f-477f-8994-4faeff622179}>1.7, !- Program Line 1
  SET {6de0341f-3b16-499b-ba58-393a1473412a} = 29.4, !- Program Line 2
  SET {03c19ac3-884a-4392-a1a9-e23f74082e0b} = 15.6, !- Program Line 3
  ELSEIF DaylightSavings==0 && DayOfWeek==1 && Hour==7 && {e2c18b0b-411f-477f-8994-4faeff622179}<23.9 && {e2c18b0b-411f-477f-8994-4faeff622179}>1.7, !- Program Line 4
  SET {6de0341f-3b16-499b-ba58-393a1473412a} = 29.4, !- Program Line 5
  SET {03c19ac3-884a-4392-a1a9-e23f74082e0b} = 15.6, !- Program Line 6
  ELSEIF DaylightSavings==1 && DayOfWeek>1 && Hour==4 && {e2c18b0b-411f-477f-8994-4faeff622179}<23.9 && {e2c18b0b-411f-477f-8994-4faeff622179}>1.7, !- Program Line 7
  SET {6de0341f-3b16-499b-ba58-393a1473412a} = 29.4, !- Program Line 8
  SET {03c19ac3-884a-4392-a1a9-e23f74082e0b} = 15.6, !- Program Line 9
  ELSEIF DaylightSavings==1 && DayOfWeek==1 && Hour==6 && {e2c18b0b-411f-477f-8994-4faeff622179}<23.9 && {e2c18b0b-411f-477f-8994-4faeff622179}>1.7, !- Program Line 10
  SET {6de0341f-3b16-499b-ba58-393a1473412a} = 29.4, !- Program Line 11
  SET {03c19ac3-884a-4392-a1a9-e23f74082e0b} = 15.6, !- Program Line 12
  ELSE,                                   !- Program Line 13
  SET {6de0341f-3b16-499b-ba58-393a1473412a} = NULL, !- Program Line 14
  SET {03c19ac3-884a-4392-a1a9-e23f74082e0b} = NULL, !- Program Line 15
  ENDIF;                                  !- Program Line 16

