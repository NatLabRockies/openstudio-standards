  ems_Gym_ZN_1_FLR_1_ZN_PSZ_AC_1_5_OptimumStartProg0, !- Name
  IF DaylightSavings==0 && DayOfWeek>1 && Hour==5 && {cd02fe69-7ec1-4861-ab8b-dd4f56aee2b6}<23.9 && {cd02fe69-7ec1-4861-ab8b-dd4f56aee2b6}>1.7, !- Program Line 1
