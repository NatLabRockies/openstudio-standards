  {7bd047ee-ba54-4500-81e6-33d87e8c161f}, !- Handle
  ems_Auditorium_ZN_1_FLR_1_ZN_PSZ_AC_3_7_OptimumStartProg0, !- Name
  IF DaylightSavings==0 && DayOfWeek>1 && Hour==5 && {db86921c-f13d-4ff2-b5ec-f5400cafe4d9}<23.9 && {db86921c-f13d-4ff2-b5ec-f5400cafe4d9}>1.7, !- Program Line 1
  SET {0f31f41f-1475-4bb2-9f82-08d066cbfb27} = 29.4, !- Program Line 2
  SET {c8a30161-7bb7-4dee-a854-1646acb01de4} = 15.6, !- Program Line 3
  ELSEIF DaylightSavings==0 && DayOfWeek==1 && Hour==7 && {db86921c-f13d-4ff2-b5ec-f5400cafe4d9}<23.9 && {db86921c-f13d-4ff2-b5ec-f5400cafe4d9}>1.7, !- Program Line 4
  SET {0f31f41f-1475-4bb2-9f82-08d066cbfb27} = 29.4, !- Program Line 5
  SET {c8a30161-7bb7-4dee-a854-1646acb01de4} = 15.6, !- Program Line 6
  ELSEIF DaylightSavings==1 && DayOfWeek>1 && Hour==4 && {db86921c-f13d-4ff2-b5ec-f5400cafe4d9}<23.9 && {db86921c-f13d-4ff2-b5ec-f5400cafe4d9}>1.7, !- Program Line 7
  SET {0f31f41f-1475-4bb2-9f82-08d066cbfb27} = 29.4, !- Program Line 8
  SET {c8a30161-7bb7-4dee-a854-1646acb01de4} = 15.6, !- Program Line 9
  ELSEIF DaylightSavings==1 && DayOfWeek==1 && Hour==6 && {db86921c-f13d-4ff2-b5ec-f5400cafe4d9}<23.9 && {db86921c-f13d-4ff2-b5ec-f5400cafe4d9}>1.7, !- Program Line 10
  SET {0f31f41f-1475-4bb2-9f82-08d066cbfb27} = 29.4, !- Program Line 11
  SET {c8a30161-7bb7-4dee-a854-1646acb01de4} = 15.6, !- Program Line 12
  ELSE,                                   !- Program Line 13
  SET {0f31f41f-1475-4bb2-9f82-08d066cbfb27} = NULL, !- Program Line 14
  SET {c8a30161-7bb7-4dee-a854-1646acb01de4} = NULL, !- Program Line 15
  ENDIF;                                  !- Program Line 16

