OS:EnergyManagementSystem:Program,
  {b524ad33-0ee9-4e75-9d25-45e66055f731}, !- Handle
  ems_VAV_POD_3_OptimumStartProg0,        !- Name
  IF DaylightSavings==0 && DayOfWeek>1 && Hour==5 && {dc679e5d-4464-4ddf-b5de-a9e61502c0c2}<23.9 && {dc679e5d-4464-4ddf-b5de-a9e61502c0c2}>1.7, !- Program Line 1
  SET {88b127da-5091-4e49-852a-56f752bc66b1} = 29.4, !- Program Line 2
  SET {656ce8a3-dbac-4cec-838d-51656543cacd} = 15.6, !- Program Line 3
  ELSEIF DaylightSavings==0 && DayOfWeek==1 && Hour==7 && {dc679e5d-4464-4ddf-b5de-a9e61502c0c2}<23.9 && {dc679e5d-4464-4ddf-b5de-a9e61502c0c2}>1.7, !- Program Line 4
  SET {88b127da-5091-4e49-852a-56f752bc66b1} = 29.4, !- Program Line 5
  SET {656ce8a3-dbac-4cec-838d-51656543cacd} = 15.6, !- Program Line 6
  ELSEIF DaylightSavings==1 && DayOfWeek>1 && Hour==4 && {dc679e5d-4464-4ddf-b5de-a9e61502c0c2}<23.9 && {dc679e5d-4464-4ddf-b5de-a9e61502c0c2}>1.7, !- Program Line 7
  SET {88b127da-5091-4e49-852a-56f752bc66b1} = 29.4, !- Program Line 8
  SET {656ce8a3-dbac-4cec-838d-51656543cacd} = 15.6, !- Program Line 9
  ELSEIF DaylightSavings==1 && DayOfWeek==1 && Hour==6 && {dc679e5d-4464-4ddf-b5de-a9e61502c0c2}<23.9 && {dc679e5d-4464-4ddf-b5de-a9e61502c0c2}>1.7, !- Program Line 10
  SET {88b127da-5091-4e49-852a-56f752bc66b1} = 29.4, !- Program Line 11
  SET {656ce8a3-dbac-4cec-838d-51656543cacd} = 15.6, !- Program Line 12
  ELSE,                                   !- Program Line 13
  SET {88b127da-5091-4e49-852a-56f752bc66b1} = NULL, !- Program Line 14
  SET {656ce8a3-dbac-4cec-838d-51656543cacd} = NULL, !- Program Line 15
  ENDIF;                                  !- Program Line 16

