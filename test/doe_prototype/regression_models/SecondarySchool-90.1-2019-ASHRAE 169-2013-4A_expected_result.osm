  SET {88e63f27-f8e4-4c8a-840c-253d6b3a22ac} = 29.4, !- Program Line 2
  SET {7fff5c2c-49e8-4f18-9df6-3969f76f8780} = 15.6, !- Program Line 3
  ELSEIF DaylightSavings==0 && DayOfWeek==1 && Hour==7 && {5ad06b2b-3c59-48ce-a0e7-03e5a7597b35}<23.9 && {5ad06b2b-3c59-48ce-a0e7-03e5a7597b35}>1.7, !- Program Line 4
  SET {88e63f27-f8e4-4c8a-840c-253d6b3a22ac} = 29.4, !- Program Line 5
  SET {7fff5c2c-49e8-4f18-9df6-3969f76f8780} = 15.6, !- Program Line 6
  ELSEIF DaylightSavings==1 && DayOfWeek>1 && Hour==4 && {5ad06b2b-3c59-48ce-a0e7-03e5a7597b35}<23.9 && {5ad06b2b-3c59-48ce-a0e7-03e5a7597b35}>1.7, !- Program Line 7
  SET {88e63f27-f8e4-4c8a-840c-253d6b3a22ac} = 29.4, !- Program Line 8
  SET {7fff5c2c-49e8-4f18-9df6-3969f76f8780} = 15.6, !- Program Line 9
  ELSEIF DaylightSavings==1 && DayOfWeek==1 && Hour==6 && {5ad06b2b-3c59-48ce-a0e7-03e5a7597b35}<23.9 && {5ad06b2b-3c59-48ce-a0e7-03e5a7597b35}>1.7, !- Program Line 10
  SET {88e63f27-f8e4-4c8a-840c-253d6b3a22ac} = 29.4, !- Program Line 11
  SET {7fff5c2c-49e8-4f18-9df6-3969f76f8780} = 15.6, !- Program Line 12
  ELSE,                                   !- Program Line 13
  SET {88e63f27-f8e4-4c8a-840c-253d6b3a22ac} = NULL, !- Program Line 14
  SET {7fff5c2c-49e8-4f18-9df6-3969f76f8780} = NULL, !- Program Line 15
