  ELSEIF DaylightSavings==0 && DayOfWeek==1 && Hour==7 && {39755cc3-bd71-4184-b34f-265311ea28ea}<23.9 && {39755cc3-bd71-4184-b34f-265311ea28ea}>1.7, !- Program Line 4
  SET {f523899b-1e8e-43b5-94bb-6ed093b1a2b6} = 29.4, !- Program Line 5
  SET {be0b4810-a037-47ad-a892-ed334a3757b9} = 15.6, !- Program Line 6
  ELSEIF DaylightSavings==1 && DayOfWeek>1 && Hour==4 && {39755cc3-bd71-4184-b34f-265311ea28ea}<23.9 && {39755cc3-bd71-4184-b34f-265311ea28ea}>1.7, !- Program Line 7
  SET {f523899b-1e8e-43b5-94bb-6ed093b1a2b6} = 29.4, !- Program Line 8
  SET {be0b4810-a037-47ad-a892-ed334a3757b9} = 15.6, !- Program Line 9
  ELSEIF DaylightSavings==1 && DayOfWeek==1 && Hour==6 && {39755cc3-bd71-4184-b34f-265311ea28ea}<23.9 && {39755cc3-bd71-4184-b34f-265311ea28ea}>1.7, !- Program Line 10
  SET {f523899b-1e8e-43b5-94bb-6ed093b1a2b6} = 29.4, !- Program Line 11
