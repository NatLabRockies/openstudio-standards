  {c8c4a2b2-4118-4872-9487-576a122d1bec}, !- Handle
  ems_Aux_Gym_ZN_1_FLR_1_ZN_PSZ_AC_2_6_OptimumStartProg0, !- Name
  IF DaylightSavings==0 && DayOfWeek>1 && Hour==5 && {6a18b93d-741c-4d3b-9d63-e4777496db22}<23.9 && {6a18b93d-741c-4d3b-9d63-e4777496db22}>1.7, !- Program Line 1
  SET {c638967a-8134-4fc0-ac47-308312b89791} = 29.4, !- Program Line 2
  SET {8fd81516-8831-4a47-98c5-87101ed7229a} = 15.6, !- Program Line 3
  ELSEIF DaylightSavings==0 && DayOfWeek==1 && Hour==7 && {6a18b93d-741c-4d3b-9d63-e4777496db22}<23.9 && {6a18b93d-741c-4d3b-9d63-e4777496db22}>1.7, !- Program Line 4
  SET {c638967a-8134-4fc0-ac47-308312b89791} = 29.4, !- Program Line 5
  SET {8fd81516-8831-4a47-98c5-87101ed7229a} = 15.6, !- Program Line 6
  ELSEIF DaylightSavings==1 && DayOfWeek>1 && Hour==4 && {6a18b93d-741c-4d3b-9d63-e4777496db22}<23.9 && {6a18b93d-741c-4d3b-9d63-e4777496db22}>1.7, !- Program Line 7
  SET {c638967a-8134-4fc0-ac47-308312b89791} = 29.4, !- Program Line 8
  SET {8fd81516-8831-4a47-98c5-87101ed7229a} = 15.6, !- Program Line 9
  ELSEIF DaylightSavings==1 && DayOfWeek==1 && Hour==6 && {6a18b93d-741c-4d3b-9d63-e4777496db22}<23.9 && {6a18b93d-741c-4d3b-9d63-e4777496db22}>1.7, !- Program Line 10
  SET {c638967a-8134-4fc0-ac47-308312b89791} = 29.4, !- Program Line 11
  SET {8fd81516-8831-4a47-98c5-87101ed7229a} = 15.6, !- Program Line 12
  ELSE,                                   !- Program Line 13
  SET {c638967a-8134-4fc0-ac47-308312b89791} = NULL, !- Program Line 14
  SET {8fd81516-8831-4a47-98c5-87101ed7229a} = NULL, !- Program Line 15
  ENDIF;                                  !- Program Line 16

