  SET {cda90828-5942-46aa-9f09-8030d4eed49a} = 15.6, !- Program Line 3
  ELSEIF DaylightSavings==0 && DayOfWeek==1 && Hour==7 && {cd02fe69-7ec1-4861-ab8b-dd4f56aee2b6}<23.9 && {cd02fe69-7ec1-4861-ab8b-dd4f56aee2b6}>1.7, !- Program Line 4
  SET {a561c104-21f4-4a66-ab88-961a79158e57} = 29.4, !- Program Line 5
  SET {cda90828-5942-46aa-9f09-8030d4eed49a} = 15.6, !- Program Line 6
  ELSEIF DaylightSavings==1 && DayOfWeek>1 && Hour==4 && {cd02fe69-7ec1-4861-ab8b-dd4f56aee2b6}<23.9 && {cd02fe69-7ec1-4861-ab8b-dd4f56aee2b6}>1.7, !- Program Line 7
  SET {a561c104-21f4-4a66-ab88-961a79158e57} = 29.4, !- Program Line 8
  SET {cda90828-5942-46aa-9f09-8030d4eed49a} = 15.6, !- Program Line 9
  ELSEIF DaylightSavings==1 && DayOfWeek==1 && Hour==6 && {cd02fe69-7ec1-4861-ab8b-dd4f56aee2b6}<23.9 && {cd02fe69-7ec1-4861-ab8b-dd4f56aee2b6}>1.7, !- Program Line 10
  SET {a561c104-21f4-4a66-ab88-961a79158e57} = 29.4, !- Program Line 11
  SET {cda90828-5942-46aa-9f09-8030d4eed49a} = 15.6, !- Program Line 12
  ELSE,                                   !- Program Line 13
  SET {a561c104-21f4-4a66-ab88-961a79158e57} = NULL, !- Program Line 14
  SET {cda90828-5942-46aa-9f09-8030d4eed49a} = NULL, !- Program Line 15
