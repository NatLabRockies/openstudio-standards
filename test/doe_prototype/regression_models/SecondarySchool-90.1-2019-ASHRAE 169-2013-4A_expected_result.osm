OS:EnergyManagementSystem:Program,
  {f41d4da8-9642-49d3-be37-0dfd50958814}, !- Handle
  ems_VAV_POD_1_OptimumStartProg0,        !- Name
  IF DaylightSavings==0 && DayOfWeek>1 && Hour==5 && {df743bcc-38c1-4873-8d97-6f8f9614ebf4}<23.9 && {df743bcc-38c1-4873-8d97-6f8f9614ebf4}>1.7, !- Program Line 1
  SET {161be81e-2e1f-435c-80d6-530fdf156182} = 29.4, !- Program Line 2
  SET {f6c01773-e2b6-4409-9955-917543aeb8b0} = 15.6, !- Program Line 3
  ELSEIF DaylightSavings==0 && DayOfWeek==1 && Hour==7 && {df743bcc-38c1-4873-8d97-6f8f9614ebf4}<23.9 && {df743bcc-38c1-4873-8d97-6f8f9614ebf4}>1.7, !- Program Line 4
  SET {161be81e-2e1f-435c-80d6-530fdf156182} = 29.4, !- Program Line 5
  SET {f6c01773-e2b6-4409-9955-917543aeb8b0} = 15.6, !- Program Line 6
  ELSEIF DaylightSavings==1 && DayOfWeek>1 && Hour==4 && {df743bcc-38c1-4873-8d97-6f8f9614ebf4}<23.9 && {df743bcc-38c1-4873-8d97-6f8f9614ebf4}>1.7, !- Program Line 7
  SET {161be81e-2e1f-435c-80d6-530fdf156182} = 29.4, !- Program Line 8
  SET {f6c01773-e2b6-4409-9955-917543aeb8b0} = 15.6, !- Program Line 9
  ELSEIF DaylightSavings==1 && DayOfWeek==1 && Hour==6 && {df743bcc-38c1-4873-8d97-6f8f9614ebf4}<23.9 && {df743bcc-38c1-4873-8d97-6f8f9614ebf4}>1.7, !- Program Line 10
  SET {161be81e-2e1f-435c-80d6-530fdf156182} = 29.4, !- Program Line 11
  SET {f6c01773-e2b6-4409-9955-917543aeb8b0} = 15.6, !- Program Line 12
  ELSE,                                   !- Program Line 13
  SET {161be81e-2e1f-435c-80d6-530fdf156182} = NULL, !- Program Line 14
  SET {f6c01773-e2b6-4409-9955-917543aeb8b0} = NULL, !- Program Line 15
  ENDIF;                                  !- Program Line 16

