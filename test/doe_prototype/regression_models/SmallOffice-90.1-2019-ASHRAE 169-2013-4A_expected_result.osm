  SET_ems_Perimeter_ZN_4_Light_EMS_Program, !- Name
  SET ems_Perimeter_ZN_4_LSr_IP=0.093*ems_Perimeter_ZN_4_LSr/67.30000000000001, !- Program Line 1
  IF (Business_Sensor <= 0) && (ems_Perimeter_ZN_4_LSr_IP >= 0.02), !- Program Line 2
  SET ems_Perimeter_ZN_4_Light1_Actuator = 0.02*67.30000000000001/0.09290304, !- Program Line 3
  ELSE,                                   !- Program Line 4
  SET ems_Perimeter_ZN_4_Light1_Actuator = NULL, !- Program Line 5
  ENDIF;                                  !- Program Line 6

