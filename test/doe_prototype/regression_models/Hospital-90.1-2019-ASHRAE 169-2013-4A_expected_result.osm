OS:EnergyManagementSystem:Program,
  {542e0de9-7cd4-4e12-9b9e-3706d325f0fc}, !- Handle
  ems_CAV_KITCHEN_OptimumStartProg0,      !- Name
  IF DaylightSavings==0 && DayOfWeek>1 && Hour==5 && {d542ccbd-1fab-48f7-9db5-69e084a18440}<23.9 && {d542ccbd-1fab-48f7-9db5-69e084a18440}>1.7, !- Program Line 1
  SET {b1673ebc-50ad-45dd-a0ff-d9c94f339c20} = 29.4, !- Program Line 2
  SET {ebd8b9f8-07d7-4850-a643-a74a5a2b84cf} = 15.6, !- Program Line 3
  ELSEIF DaylightSavings==0 && DayOfWeek==1 && Hour==7 && {d542ccbd-1fab-48f7-9db5-69e084a18440}<23.9 && {d542ccbd-1fab-48f7-9db5-69e084a18440}>1.7, !- Program Line 4
  SET {b1673ebc-50ad-45dd-a0ff-d9c94f339c20} = 29.4, !- Program Line 5
  SET {ebd8b9f8-07d7-4850-a643-a74a5a2b84cf} = 15.6, !- Program Line 6
  ELSEIF DaylightSavings==1 && DayOfWeek>1 && Hour==4 && {d542ccbd-1fab-48f7-9db5-69e084a18440}<23.9 && {d542ccbd-1fab-48f7-9db5-69e084a18440}>1.7, !- Program Line 7
  SET {b1673ebc-50ad-45dd-a0ff-d9c94f339c20} = 29.4, !- Program Line 8
  SET {ebd8b9f8-07d7-4850-a643-a74a5a2b84cf} = 15.6, !- Program Line 9
  ELSEIF DaylightSavings==1 && DayOfWeek==1 && Hour==6 && {d542ccbd-1fab-48f7-9db5-69e084a18440}<23.9 && {d542ccbd-1fab-48f7-9db5-69e084a18440}>1.7, !- Program Line 10
  SET {b1673ebc-50ad-45dd-a0ff-d9c94f339c20} = 29.4, !- Program Line 11
  SET {ebd8b9f8-07d7-4850-a643-a74a5a2b84cf} = 15.6, !- Program Line 12
  ELSE,                                   !- Program Line 13
  SET {b1673ebc-50ad-45dd-a0ff-d9c94f339c20} = NULL, !- Program Line 14
  SET {ebd8b9f8-07d7-4850-a643-a74a5a2b84cf} = NULL, !- Program Line 15
  ENDIF;                                  !- Program Line 16

