OS:EnergyManagementSystem:Program,
  {5525cbed-8827-4067-98f9-e0039835cf85}, !- Handle
  ems_VAV_1_OptimumStartProg0,            !- Name
  IF DaylightSavings==0 && DayOfWeek>1 && Hour==5 && {86ec45ee-aea7-4dd8-859b-d5dc2456b4bf}<23.9 && {86ec45ee-aea7-4dd8-859b-d5dc2456b4bf}>1.7, !- Program Line 1
  SET {48f3d5b4-b1fa-4625-924e-2c79ed2640e9} = 29.4, !- Program Line 2
  SET {ed5271c4-bd74-499c-a590-0a2da0f70c7b} = 15.6, !- Program Line 3
  ELSEIF DaylightSavings==0 && DayOfWeek==1 && Hour==7 && {86ec45ee-aea7-4dd8-859b-d5dc2456b4bf}<23.9 && {86ec45ee-aea7-4dd8-859b-d5dc2456b4bf}>1.7, !- Program Line 4
