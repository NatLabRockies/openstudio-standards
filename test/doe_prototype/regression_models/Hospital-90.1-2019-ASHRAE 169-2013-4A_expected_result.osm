OS:EnergyManagementSystem:Program,
  {71c1cff0-e9b4-44c1-96dd-bc510aab480f}, !- Handle
  ems_VAV_PATRMS_OptimumStartProg0,       !- Name
  IF DaylightSavings==0 && DayOfWeek>1 && Hour==5 && {2f00fae2-dee4-4b21-896a-fa0ab73794d1}<23.9 && {2f00fae2-dee4-4b21-896a-fa0ab73794d1}>1.7, !- Program Line 1
  SET {39b38f61-70a0-4870-b81b-8db3993d59ea} = 29.4, !- Program Line 2
  SET {ffc011a5-39aa-4c99-91eb-586d7e684809} = 15.6, !- Program Line 3
  ELSEIF DaylightSavings==0 && DayOfWeek==1 && Hour==7 && {2f00fae2-dee4-4b21-896a-fa0ab73794d1}<23.9 && {2f00fae2-dee4-4b21-896a-fa0ab73794d1}>1.7, !- Program Line 4
  SET {39b38f61-70a0-4870-b81b-8db3993d59ea} = 29.4, !- Program Line 5
  SET {ffc011a5-39aa-4c99-91eb-586d7e684809} = 15.6, !- Program Line 6
  ELSEIF DaylightSavings==1 && DayOfWeek>1 && Hour==4 && {2f00fae2-dee4-4b21-896a-fa0ab73794d1}<23.9 && {2f00fae2-dee4-4b21-896a-fa0ab73794d1}>1.7, !- Program Line 7
  SET {39b38f61-70a0-4870-b81b-8db3993d59ea} = 29.4, !- Program Line 8
  SET {ffc011a5-39aa-4c99-91eb-586d7e684809} = 15.6, !- Program Line 9
  ELSEIF DaylightSavings==1 && DayOfWeek==1 && Hour==6 && {2f00fae2-dee4-4b21-896a-fa0ab73794d1}<23.9 && {2f00fae2-dee4-4b21-896a-fa0ab73794d1}>1.7, !- Program Line 10
  SET {39b38f61-70a0-4870-b81b-8db3993d59ea} = 29.4, !- Program Line 11
  SET {ffc011a5-39aa-4c99-91eb-586d7e684809} = 15.6, !- Program Line 12
  ELSE,                                   !- Program Line 13
  SET {39b38f61-70a0-4870-b81b-8db3993d59ea} = NULL, !- Program Line 14
  SET {ffc011a5-39aa-4c99-91eb-586d7e684809} = NULL, !- Program Line 15
  ENDIF;                                  !- Program Line 16

