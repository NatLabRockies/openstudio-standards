  ELSEIF DaylightSavings==1 && DayOfWeek>1 && Hour==4 && {68bac29e-ba6a-46bc-933d-89a54417fe53}<23.9 && {68bac29e-ba6a-46bc-933d-89a54417fe53}>1.7, !- Program Line 7
  SET {5dbf8e19-d096-4d53-9ed3-5a577e86f756} = 29.4, !- Program Line 8
  SET {1d249109-7525-4179-ba80-84df2282de3c} = 15.6, !- Program Line 9
  ELSEIF DaylightSavings==1 && DayOfWeek==1 && Hour==6 && {68bac29e-ba6a-46bc-933d-89a54417fe53}<23.9 && {68bac29e-ba6a-46bc-933d-89a54417fe53}>1.7, !- Program Line 10
  SET {5dbf8e19-d096-4d53-9ed3-5a577e86f756} = 29.4, !- Program Line 11
  SET {1d249109-7525-4179-ba80-84df2282de3c} = 15.6, !- Program Line 12
