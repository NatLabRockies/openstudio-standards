  ELSEIF DaylightSavings==1 && DayOfWeek>1 && Hour==4 && {86ec45ee-aea7-4dd8-859b-d5dc2456b4bf}<23.9 && {86ec45ee-aea7-4dd8-859b-d5dc2456b4bf}>1.7, !- Program Line 7
  SET {48f3d5b4-b1fa-4625-924e-2c79ed2640e9} = 29.4, !- Program Line 8
  SET {ed5271c4-bd74-499c-a590-0a2da0f70c7b} = 15.6, !- Program Line 9
