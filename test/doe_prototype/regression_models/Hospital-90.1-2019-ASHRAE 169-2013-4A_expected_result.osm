OS:EnergyManagementSystem:Program,
  {23dec466-b79d-43ca-a2ae-4a70de3e7031}, !- Handle
  ems_CAV_KITCHEN_OptimumStartProg0,      !- Name
  IF DaylightSavings==0 && DayOfWeek>1 && Hour==5 && {a6adba65-62b8-42bc-a1c4-b24c4a37f1bd}<23.9 && {a6adba65-62b8-42bc-a1c4-b24c4a37f1bd}>1.7, !- Program Line 1
  SET {b7b5ab08-efb4-4702-bce4-7c219332fdbf} = 29.4, !- Program Line 2
  SET {ee59b710-6887-40ef-9f57-2e0a630289c2} = 15.6, !- Program Line 3
  ELSEIF DaylightSavings==0 && DayOfWeek==1 && Hour==7 && {a6adba65-62b8-42bc-a1c4-b24c4a37f1bd}<23.9 && {a6adba65-62b8-42bc-a1c4-b24c4a37f1bd}>1.7, !- Program Line 4
  SET {b7b5ab08-efb4-4702-bce4-7c219332fdbf} = 29.4, !- Program Line 5
  SET {ee59b710-6887-40ef-9f57-2e0a630289c2} = 15.6, !- Program Line 6
  ELSEIF DaylightSavings==1 && DayOfWeek>1 && Hour==4 && {a6adba65-62b8-42bc-a1c4-b24c4a37f1bd}<23.9 && {a6adba65-62b8-42bc-a1c4-b24c4a37f1bd}>1.7, !- Program Line 7
  SET {b7b5ab08-efb4-4702-bce4-7c219332fdbf} = 29.4, !- Program Line 8
  SET {ee59b710-6887-40ef-9f57-2e0a630289c2} = 15.6, !- Program Line 9
  ELSEIF DaylightSavings==1 && DayOfWeek==1 && Hour==6 && {a6adba65-62b8-42bc-a1c4-b24c4a37f1bd}<23.9 && {a6adba65-62b8-42bc-a1c4-b24c4a37f1bd}>1.7, !- Program Line 10
  SET {b7b5ab08-efb4-4702-bce4-7c219332fdbf} = 29.4, !- Program Line 11
  SET {ee59b710-6887-40ef-9f57-2e0a630289c2} = 15.6, !- Program Line 12
  ELSE,                                   !- Program Line 13
  SET {b7b5ab08-efb4-4702-bce4-7c219332fdbf} = NULL, !- Program Line 14
  SET {ee59b710-6887-40ef-9f57-2e0a630289c2} = NULL, !- Program Line 15
  ENDIF;                                  !- Program Line 16

