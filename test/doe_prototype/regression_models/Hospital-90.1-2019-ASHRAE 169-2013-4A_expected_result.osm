  ELSEIF DaylightSavings==0 && DayOfWeek==1 && Hour==7 && {68bac29e-ba6a-46bc-933d-89a54417fe53}<23.9 && {68bac29e-ba6a-46bc-933d-89a54417fe53}>1.7, !- Program Line 4
  SET {5dbf8e19-d096-4d53-9ed3-5a577e86f756} = 29.4, !- Program Line 5
