OS:EnergyManagementSystem:Program,
  {3ee2e8ac-4d55-47b5-8d4e-c274fe8eaabb}, !- Handle
  ems_CAV_KITCHEN_OptimumStartProg0,      !- Name
  IF DaylightSavings==0 && DayOfWeek>1 && Hour==5 && {19e0c8ba-d96c-4d84-9cb6-8bf59fef889c}<23.9 && {19e0c8ba-d96c-4d84-9cb6-8bf59fef889c}>1.7, !- Program Line 1
  SET {9baf1ec4-51e0-4b8f-a108-c4849ddf3c57} = 29.4, !- Program Line 2
  SET {c6a60213-cb93-48dd-b28f-c053b325ed39} = 15.6, !- Program Line 3
  ELSEIF DaylightSavings==0 && DayOfWeek==1 && Hour==7 && {19e0c8ba-d96c-4d84-9cb6-8bf59fef889c}<23.9 && {19e0c8ba-d96c-4d84-9cb6-8bf59fef889c}>1.7, !- Program Line 4
  SET {9baf1ec4-51e0-4b8f-a108-c4849ddf3c57} = 29.4, !- Program Line 5
  SET {c6a60213-cb93-48dd-b28f-c053b325ed39} = 15.6, !- Program Line 6
  ELSEIF DaylightSavings==1 && DayOfWeek>1 && Hour==4 && {19e0c8ba-d96c-4d84-9cb6-8bf59fef889c}<23.9 && {19e0c8ba-d96c-4d84-9cb6-8bf59fef889c}>1.7, !- Program Line 7
  SET {9baf1ec4-51e0-4b8f-a108-c4849ddf3c57} = 29.4, !- Program Line 8
  SET {c6a60213-cb93-48dd-b28f-c053b325ed39} = 15.6, !- Program Line 9
  ELSEIF DaylightSavings==1 && DayOfWeek==1 && Hour==6 && {19e0c8ba-d96c-4d84-9cb6-8bf59fef889c}<23.9 && {19e0c8ba-d96c-4d84-9cb6-8bf59fef889c}>1.7, !- Program Line 10
  SET {9baf1ec4-51e0-4b8f-a108-c4849ddf3c57} = 29.4, !- Program Line 11
  SET {c6a60213-cb93-48dd-b28f-c053b325ed39} = 15.6, !- Program Line 12
  ELSE,                                   !- Program Line 13
  SET {9baf1ec4-51e0-4b8f-a108-c4849ddf3c57} = NULL, !- Program Line 14
  SET {c6a60213-cb93-48dd-b28f-c053b325ed39} = NULL, !- Program Line 15
  ENDIF;                                  !- Program Line 16

