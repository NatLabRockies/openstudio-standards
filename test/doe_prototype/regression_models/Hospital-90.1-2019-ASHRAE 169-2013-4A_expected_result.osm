OS:EnergyManagementSystem:Program,
  {ad5dd546-01fd-4457-b760-c777afe4abe6}, !- Handle
  ems_VAV_PATRMS_OptimumStartProg0,       !- Name
  IF DaylightSavings==0 && DayOfWeek>1 && Hour==5 && {05d3c322-148a-4bc5-b4ba-f68198c6de73}<23.9 && {05d3c322-148a-4bc5-b4ba-f68198c6de73}>1.7, !- Program Line 1
  SET {15c72554-6724-414c-8fcc-406a56099ea3} = 29.4, !- Program Line 2
  SET {32982034-788a-4643-bab7-d98b8f3f303f} = 15.6, !- Program Line 3
  ELSEIF DaylightSavings==0 && DayOfWeek==1 && Hour==7 && {05d3c322-148a-4bc5-b4ba-f68198c6de73}<23.9 && {05d3c322-148a-4bc5-b4ba-f68198c6de73}>1.7, !- Program Line 4
  SET {15c72554-6724-414c-8fcc-406a56099ea3} = 29.4, !- Program Line 5
  SET {32982034-788a-4643-bab7-d98b8f3f303f} = 15.6, !- Program Line 6
  ELSEIF DaylightSavings==1 && DayOfWeek>1 && Hour==4 && {05d3c322-148a-4bc5-b4ba-f68198c6de73}<23.9 && {05d3c322-148a-4bc5-b4ba-f68198c6de73}>1.7, !- Program Line 7
  SET {15c72554-6724-414c-8fcc-406a56099ea3} = 29.4, !- Program Line 8
  SET {32982034-788a-4643-bab7-d98b8f3f303f} = 15.6, !- Program Line 9
  ELSEIF DaylightSavings==1 && DayOfWeek==1 && Hour==6 && {05d3c322-148a-4bc5-b4ba-f68198c6de73}<23.9 && {05d3c322-148a-4bc5-b4ba-f68198c6de73}>1.7, !- Program Line 10
  SET {15c72554-6724-414c-8fcc-406a56099ea3} = 29.4, !- Program Line 11
  SET {32982034-788a-4643-bab7-d98b8f3f303f} = 15.6, !- Program Line 12
  ELSE,                                   !- Program Line 13
  SET {15c72554-6724-414c-8fcc-406a56099ea3} = NULL, !- Program Line 14
  SET {32982034-788a-4643-bab7-d98b8f3f303f} = NULL, !- Program Line 15
  ENDIF;                                  !- Program Line 16

