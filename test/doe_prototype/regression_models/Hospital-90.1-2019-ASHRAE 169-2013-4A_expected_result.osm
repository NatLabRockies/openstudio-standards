OS:EnergyManagementSystem:Program,
  {cb9853ea-1122-4eaf-82fe-30064b09a670}, !- Handle
  ems_VAV_PATRMS_OptimumStartProg0,       !- Name
  IF DaylightSavings==0 && DayOfWeek>1 && Hour==5 && {492c1995-900c-4f6e-b946-85ae4da401c5}<23.9 && {492c1995-900c-4f6e-b946-85ae4da401c5}>1.7, !- Program Line 1
  SET {9d4554e6-cd76-4c9e-a0eb-ac6830d6c93b} = 29.4, !- Program Line 2
  SET {0c4526b3-11fc-45bc-a256-e2a98070d61f} = 15.6, !- Program Line 3
  ELSEIF DaylightSavings==0 && DayOfWeek==1 && Hour==7 && {492c1995-900c-4f6e-b946-85ae4da401c5}<23.9 && {492c1995-900c-4f6e-b946-85ae4da401c5}>1.7, !- Program Line 4
  SET {9d4554e6-cd76-4c9e-a0eb-ac6830d6c93b} = 29.4, !- Program Line 5
  SET {0c4526b3-11fc-45bc-a256-e2a98070d61f} = 15.6, !- Program Line 6
  ELSEIF DaylightSavings==1 && DayOfWeek>1 && Hour==4 && {492c1995-900c-4f6e-b946-85ae4da401c5}<23.9 && {492c1995-900c-4f6e-b946-85ae4da401c5}>1.7, !- Program Line 7
  SET {9d4554e6-cd76-4c9e-a0eb-ac6830d6c93b} = 29.4, !- Program Line 8
  SET {0c4526b3-11fc-45bc-a256-e2a98070d61f} = 15.6, !- Program Line 9
  ELSEIF DaylightSavings==1 && DayOfWeek==1 && Hour==6 && {492c1995-900c-4f6e-b946-85ae4da401c5}<23.9 && {492c1995-900c-4f6e-b946-85ae4da401c5}>1.7, !- Program Line 10
  SET {9d4554e6-cd76-4c9e-a0eb-ac6830d6c93b} = 29.4, !- Program Line 11
  SET {0c4526b3-11fc-45bc-a256-e2a98070d61f} = 15.6, !- Program Line 12
  ELSE,                                   !- Program Line 13
  SET {9d4554e6-cd76-4c9e-a0eb-ac6830d6c93b} = NULL, !- Program Line 14
  SET {0c4526b3-11fc-45bc-a256-e2a98070d61f} = NULL, !- Program Line 15
  ENDIF;                                  !- Program Line 16

