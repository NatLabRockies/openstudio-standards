  {0e1045bf-1f19-4286-8700-07a698332333}, !- Handle
  ems_VAV_PATRMS_OptimumStartProg0,       !- Name
  IF DaylightSavings==0 && DayOfWeek>1 && Hour==5 && {8326e374-9ef6-40b4-ba76-fea4bc56886c}<23.9 && {8326e374-9ef6-40b4-ba76-fea4bc56886c}>1.7, !- Program Line 1
  SET {46d672a5-9cd5-4755-96da-609390d875d5} = 29.4, !- Program Line 2
  SET {c8ae74e2-8689-4b89-9081-6bdf970b128d} = 15.6, !- Program Line 3
  ELSEIF DaylightSavings==0 && DayOfWeek==1 && Hour==7 && {8326e374-9ef6-40b4-ba76-fea4bc56886c}<23.9 && {8326e374-9ef6-40b4-ba76-fea4bc56886c}>1.7, !- Program Line 4
  SET {46d672a5-9cd5-4755-96da-609390d875d5} = 29.4, !- Program Line 5
  SET {c8ae74e2-8689-4b89-9081-6bdf970b128d} = 15.6, !- Program Line 6
  ELSEIF DaylightSavings==1 && DayOfWeek>1 && Hour==4 && {8326e374-9ef6-40b4-ba76-fea4bc56886c}<23.9 && {8326e374-9ef6-40b4-ba76-fea4bc56886c}>1.7, !- Program Line 7
  SET {46d672a5-9cd5-4755-96da-609390d875d5} = 29.4, !- Program Line 8
  SET {c8ae74e2-8689-4b89-9081-6bdf970b128d} = 15.6, !- Program Line 9
  ELSEIF DaylightSavings==1 && DayOfWeek==1 && Hour==6 && {8326e374-9ef6-40b4-ba76-fea4bc56886c}<23.9 && {8326e374-9ef6-40b4-ba76-fea4bc56886c}>1.7, !- Program Line 10
  SET {46d672a5-9cd5-4755-96da-609390d875d5} = 29.4, !- Program Line 11
  SET {c8ae74e2-8689-4b89-9081-6bdf970b128d} = 15.6, !- Program Line 12
  ELSE,                                   !- Program Line 13
  SET {46d672a5-9cd5-4755-96da-609390d875d5} = NULL, !- Program Line 14
  SET {c8ae74e2-8689-4b89-9081-6bdf970b128d} = NULL, !- Program Line 15
