OS:EnergyManagementSystem:Program,
  {0adc1489-1bca-4c10-86b7-c36ba6b2c446}, !- Handle
  ems_CAV_KITCHEN_OptimumStartProg0,      !- Name
  IF DaylightSavings==0 && DayOfWeek>1 && Hour==5 && {30e1d9c3-15f6-4116-9880-f68da0ee23f6}<23.9 && {30e1d9c3-15f6-4116-9880-f68da0ee23f6}>1.7, !- Program Line 1
  SET {745dfe86-aaa1-4717-be51-49c52feb1575} = 29.4, !- Program Line 2
  SET {f63d14bb-be4f-4404-a5f1-8b1ae8d46726} = 15.6, !- Program Line 3
  ELSEIF DaylightSavings==0 && DayOfWeek==1 && Hour==7 && {30e1d9c3-15f6-4116-9880-f68da0ee23f6}<23.9 && {30e1d9c3-15f6-4116-9880-f68da0ee23f6}>1.7, !- Program Line 4
  SET {745dfe86-aaa1-4717-be51-49c52feb1575} = 29.4, !- Program Line 5
  SET {f63d14bb-be4f-4404-a5f1-8b1ae8d46726} = 15.6, !- Program Line 6
  ELSEIF DaylightSavings==1 && DayOfWeek>1 && Hour==4 && {30e1d9c3-15f6-4116-9880-f68da0ee23f6}<23.9 && {30e1d9c3-15f6-4116-9880-f68da0ee23f6}>1.7, !- Program Line 7
  SET {745dfe86-aaa1-4717-be51-49c52feb1575} = 29.4, !- Program Line 8
  SET {f63d14bb-be4f-4404-a5f1-8b1ae8d46726} = 15.6, !- Program Line 9
  ELSEIF DaylightSavings==1 && DayOfWeek==1 && Hour==6 && {30e1d9c3-15f6-4116-9880-f68da0ee23f6}<23.9 && {30e1d9c3-15f6-4116-9880-f68da0ee23f6}>1.7, !- Program Line 10
  SET {745dfe86-aaa1-4717-be51-49c52feb1575} = 29.4, !- Program Line 11
  SET {f63d14bb-be4f-4404-a5f1-8b1ae8d46726} = 15.6, !- Program Line 12
  ELSE,                                   !- Program Line 13
  SET {745dfe86-aaa1-4717-be51-49c52feb1575} = NULL, !- Program Line 14
  SET {f63d14bb-be4f-4404-a5f1-8b1ae8d46726} = NULL, !- Program Line 15
  ENDIF;                                  !- Program Line 16

