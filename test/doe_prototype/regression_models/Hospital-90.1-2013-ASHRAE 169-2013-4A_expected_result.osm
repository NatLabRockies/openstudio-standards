OS:EnergyManagementSystem:Program,
  {4dabb11c-8d23-48eb-ab56-0413714a6131}, !- Handle
  ems_VAV_PATRMS_OptimumStartProg0,       !- Name
  IF DaylightSavings==0 && DayOfWeek>1 && Hour==5 && {e08631dc-5790-4b29-a3ef-fc800eef3bd1}<23.9 && {e08631dc-5790-4b29-a3ef-fc800eef3bd1}>1.7, !- Program Line 1
  SET {6289f333-b39a-4839-988d-b76396ceed27} = 29.4, !- Program Line 2
  SET {5f274945-0b3e-4fb6-9fc2-3b842d65ebf2} = 15.6, !- Program Line 3
  ELSEIF DaylightSavings==0 && DayOfWeek==1 && Hour==7 && {e08631dc-5790-4b29-a3ef-fc800eef3bd1}<23.9 && {e08631dc-5790-4b29-a3ef-fc800eef3bd1}>1.7, !- Program Line 4
  SET {6289f333-b39a-4839-988d-b76396ceed27} = 29.4, !- Program Line 5
  SET {5f274945-0b3e-4fb6-9fc2-3b842d65ebf2} = 15.6, !- Program Line 6
  ELSEIF DaylightSavings==1 && DayOfWeek>1 && Hour==4 && {e08631dc-5790-4b29-a3ef-fc800eef3bd1}<23.9 && {e08631dc-5790-4b29-a3ef-fc800eef3bd1}>1.7, !- Program Line 7
  SET {6289f333-b39a-4839-988d-b76396ceed27} = 29.4, !- Program Line 8
  SET {5f274945-0b3e-4fb6-9fc2-3b842d65ebf2} = 15.6, !- Program Line 9
  ELSEIF DaylightSavings==1 && DayOfWeek==1 && Hour==6 && {e08631dc-5790-4b29-a3ef-fc800eef3bd1}<23.9 && {e08631dc-5790-4b29-a3ef-fc800eef3bd1}>1.7, !- Program Line 10
  SET {6289f333-b39a-4839-988d-b76396ceed27} = 29.4, !- Program Line 11
  SET {5f274945-0b3e-4fb6-9fc2-3b842d65ebf2} = 15.6, !- Program Line 12
  ELSE,                                   !- Program Line 13
  SET {6289f333-b39a-4839-988d-b76396ceed27} = NULL, !- Program Line 14
  SET {5f274945-0b3e-4fb6-9fc2-3b842d65ebf2} = NULL, !- Program Line 15
  ENDIF;                                  !- Program Line 16

