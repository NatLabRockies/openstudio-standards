OS:EnergyManagementSystem:Program,
  {3302f40a-f671-46f0-ba2b-452f1145adb7}, !- Handle
  ems_VAV_2_OptimumStartProg0,            !- Name
  IF DaylightSavings==0 && DayOfWeek>1 && Hour==5 && {e4618549-2b0a-4894-b971-7bed83249811}<23.9 && {e4618549-2b0a-4894-b971-7bed83249811}>1.7, !- Program Line 1
  SET {e8eadee5-ad3f-4a5a-a6bd-07aea44fb9fa} = 29.4, !- Program Line 2
  SET {2e62a981-03fc-4f95-af79-b236053b8fad} = 15.6, !- Program Line 3
  ELSEIF DaylightSavings==0 && DayOfWeek==1 && Hour==7 && {e4618549-2b0a-4894-b971-7bed83249811}<23.9 && {e4618549-2b0a-4894-b971-7bed83249811}>1.7, !- Program Line 4
  SET {e8eadee5-ad3f-4a5a-a6bd-07aea44fb9fa} = 29.4, !- Program Line 5
  SET {2e62a981-03fc-4f95-af79-b236053b8fad} = 15.6, !- Program Line 6
  ELSEIF DaylightSavings==1 && DayOfWeek>1 && Hour==4 && {e4618549-2b0a-4894-b971-7bed83249811}<23.9 && {e4618549-2b0a-4894-b971-7bed83249811}>1.7, !- Program Line 7
  SET {e8eadee5-ad3f-4a5a-a6bd-07aea44fb9fa} = 29.4, !- Program Line 8
  SET {2e62a981-03fc-4f95-af79-b236053b8fad} = 15.6, !- Program Line 9
  ELSEIF DaylightSavings==1 && DayOfWeek==1 && Hour==6 && {e4618549-2b0a-4894-b971-7bed83249811}<23.9 && {e4618549-2b0a-4894-b971-7bed83249811}>1.7, !- Program Line 10
  SET {e8eadee5-ad3f-4a5a-a6bd-07aea44fb9fa} = 29.4, !- Program Line 11
  SET {2e62a981-03fc-4f95-af79-b236053b8fad} = 15.6, !- Program Line 12
  ELSE,                                   !- Program Line 13
  SET {e8eadee5-ad3f-4a5a-a6bd-07aea44fb9fa} = NULL, !- Program Line 14
  SET {2e62a981-03fc-4f95-af79-b236053b8fad} = NULL, !- Program Line 15
  ENDIF;                                  !- Program Line 16

