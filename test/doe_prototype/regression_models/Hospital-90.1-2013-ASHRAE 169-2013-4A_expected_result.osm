OS:EnergyManagementSystem:Program,
  {acef33bc-dd04-40dc-9cf8-ce288355cea8}, !- Handle
  ems_VAV_PATRMS_OptimumStartProg0,       !- Name
  IF DaylightSavings==0 && DayOfWeek>1 && Hour==5 && {112ff66e-ec0d-4ec2-999d-fe9c601aad60}<23.9 && {112ff66e-ec0d-4ec2-999d-fe9c601aad60}>1.7, !- Program Line 1
  SET {658dba7b-5af9-4588-8f5b-c6c78ae51b01} = 29.4, !- Program Line 2
  SET {190ad3a1-2ffa-47cd-ae9c-9eb459d4cd41} = 15.6, !- Program Line 3
  ELSEIF DaylightSavings==0 && DayOfWeek==1 && Hour==7 && {112ff66e-ec0d-4ec2-999d-fe9c601aad60}<23.9 && {112ff66e-ec0d-4ec2-999d-fe9c601aad60}>1.7, !- Program Line 4
  SET {658dba7b-5af9-4588-8f5b-c6c78ae51b01} = 29.4, !- Program Line 5
  SET {190ad3a1-2ffa-47cd-ae9c-9eb459d4cd41} = 15.6, !- Program Line 6
  ELSEIF DaylightSavings==1 && DayOfWeek>1 && Hour==4 && {112ff66e-ec0d-4ec2-999d-fe9c601aad60}<23.9 && {112ff66e-ec0d-4ec2-999d-fe9c601aad60}>1.7, !- Program Line 7
  SET {658dba7b-5af9-4588-8f5b-c6c78ae51b01} = 29.4, !- Program Line 8
  SET {190ad3a1-2ffa-47cd-ae9c-9eb459d4cd41} = 15.6, !- Program Line 9
  ELSEIF DaylightSavings==1 && DayOfWeek==1 && Hour==6 && {112ff66e-ec0d-4ec2-999d-fe9c601aad60}<23.9 && {112ff66e-ec0d-4ec2-999d-fe9c601aad60}>1.7, !- Program Line 10
  SET {658dba7b-5af9-4588-8f5b-c6c78ae51b01} = 29.4, !- Program Line 11
  SET {190ad3a1-2ffa-47cd-ae9c-9eb459d4cd41} = 15.6, !- Program Line 12
  ELSE,                                   !- Program Line 13
  SET {658dba7b-5af9-4588-8f5b-c6c78ae51b01} = NULL, !- Program Line 14
  SET {190ad3a1-2ffa-47cd-ae9c-9eb459d4cd41} = NULL, !- Program Line 15
  ENDIF;                                  !- Program Line 16

