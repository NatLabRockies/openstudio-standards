OS:EnergyManagementSystem:Program,
  {b00323c3-3bb1-4f87-9285-3c48471f0985}, !- Handle
  ems_CAV_KITCHEN_OptimumStartProg0,      !- Name
  IF DaylightSavings==0 && DayOfWeek>1 && Hour==5 && {132d51c1-3608-47d4-8c5f-7e31b7cc0ba1}<23.9 && {132d51c1-3608-47d4-8c5f-7e31b7cc0ba1}>1.7, !- Program Line 1
  SET {69a954b1-3e2a-410a-ace6-c70e29f70fe5} = 29.4, !- Program Line 2
  SET {a23dab62-a26c-432e-aa6b-5db0fb09d064} = 15.6, !- Program Line 3
  ELSEIF DaylightSavings==0 && DayOfWeek==1 && Hour==7 && {132d51c1-3608-47d4-8c5f-7e31b7cc0ba1}<23.9 && {132d51c1-3608-47d4-8c5f-7e31b7cc0ba1}>1.7, !- Program Line 4
  SET {69a954b1-3e2a-410a-ace6-c70e29f70fe5} = 29.4, !- Program Line 5
  SET {a23dab62-a26c-432e-aa6b-5db0fb09d064} = 15.6, !- Program Line 6
  ELSEIF DaylightSavings==1 && DayOfWeek>1 && Hour==4 && {132d51c1-3608-47d4-8c5f-7e31b7cc0ba1}<23.9 && {132d51c1-3608-47d4-8c5f-7e31b7cc0ba1}>1.7, !- Program Line 7
  SET {69a954b1-3e2a-410a-ace6-c70e29f70fe5} = 29.4, !- Program Line 8
  SET {a23dab62-a26c-432e-aa6b-5db0fb09d064} = 15.6, !- Program Line 9
  ELSEIF DaylightSavings==1 && DayOfWeek==1 && Hour==6 && {132d51c1-3608-47d4-8c5f-7e31b7cc0ba1}<23.9 && {132d51c1-3608-47d4-8c5f-7e31b7cc0ba1}>1.7, !- Program Line 10
  SET {69a954b1-3e2a-410a-ace6-c70e29f70fe5} = 29.4, !- Program Line 11
  SET {a23dab62-a26c-432e-aa6b-5db0fb09d064} = 15.6, !- Program Line 12
  ELSE,                                   !- Program Line 13
  SET {69a954b1-3e2a-410a-ace6-c70e29f70fe5} = NULL, !- Program Line 14
  SET {a23dab62-a26c-432e-aa6b-5db0fb09d064} = NULL, !- Program Line 15
  ENDIF;                                  !- Program Line 16

