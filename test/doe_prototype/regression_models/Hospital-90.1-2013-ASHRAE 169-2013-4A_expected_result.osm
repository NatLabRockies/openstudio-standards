OS:EnergyManagementSystem:Program,
  {36b76685-583e-4565-8933-9c3d25542c8a}, !- Handle
  ems_VAV_2_OptimumStartProg0,            !- Name
  IF DaylightSavings==0 && DayOfWeek>1 && Hour==5 && {8d95f463-9691-4c2d-b9c2-a6d1afa24e15}<23.9 && {8d95f463-9691-4c2d-b9c2-a6d1afa24e15}>1.7, !- Program Line 1
  SET {3195b860-57c4-4135-95eb-682444d8e9e7} = 29.4, !- Program Line 2
  SET {a8d2826d-f274-4ee1-a307-20155901342d} = 15.6, !- Program Line 3
  ELSEIF DaylightSavings==0 && DayOfWeek==1 && Hour==7 && {8d95f463-9691-4c2d-b9c2-a6d1afa24e15}<23.9 && {8d95f463-9691-4c2d-b9c2-a6d1afa24e15}>1.7, !- Program Line 4
  SET {3195b860-57c4-4135-95eb-682444d8e9e7} = 29.4, !- Program Line 5
  SET {a8d2826d-f274-4ee1-a307-20155901342d} = 15.6, !- Program Line 6
  ELSEIF DaylightSavings==1 && DayOfWeek>1 && Hour==4 && {8d95f463-9691-4c2d-b9c2-a6d1afa24e15}<23.9 && {8d95f463-9691-4c2d-b9c2-a6d1afa24e15}>1.7, !- Program Line 7
  SET {3195b860-57c4-4135-95eb-682444d8e9e7} = 29.4, !- Program Line 8
  SET {a8d2826d-f274-4ee1-a307-20155901342d} = 15.6, !- Program Line 9
  ELSEIF DaylightSavings==1 && DayOfWeek==1 && Hour==6 && {8d95f463-9691-4c2d-b9c2-a6d1afa24e15}<23.9 && {8d95f463-9691-4c2d-b9c2-a6d1afa24e15}>1.7, !- Program Line 10
  SET {3195b860-57c4-4135-95eb-682444d8e9e7} = 29.4, !- Program Line 11
  SET {a8d2826d-f274-4ee1-a307-20155901342d} = 15.6, !- Program Line 12
  ELSE,                                   !- Program Line 13
  SET {3195b860-57c4-4135-95eb-682444d8e9e7} = NULL, !- Program Line 14
  SET {a8d2826d-f274-4ee1-a307-20155901342d} = NULL, !- Program Line 15
  ENDIF;                                  !- Program Line 16

