OS:EnergyManagementSystem:Program,
  {1c90e1b3-09d1-45b4-8ca6-3908d23e41cb}, !- Handle
  ems_VAV_PATRMS_OptimumStartProg0,       !- Name
  IF DaylightSavings==0 && DayOfWeek>1 && Hour==5 && {5c490d10-93e6-4bd6-9af2-23a582e6d587}<23.9 && {5c490d10-93e6-4bd6-9af2-23a582e6d587}>1.7, !- Program Line 1
  SET {b11fb975-e3cb-4c5a-823a-8557afffbc21} = 29.4, !- Program Line 2
  SET {023c0c05-4ac5-4fc9-b74a-4473bb886a9e} = 15.6, !- Program Line 3
  ELSEIF DaylightSavings==0 && DayOfWeek==1 && Hour==7 && {5c490d10-93e6-4bd6-9af2-23a582e6d587}<23.9 && {5c490d10-93e6-4bd6-9af2-23a582e6d587}>1.7, !- Program Line 4
  SET {b11fb975-e3cb-4c5a-823a-8557afffbc21} = 29.4, !- Program Line 5
  SET {023c0c05-4ac5-4fc9-b74a-4473bb886a9e} = 15.6, !- Program Line 6
  ELSEIF DaylightSavings==1 && DayOfWeek>1 && Hour==4 && {5c490d10-93e6-4bd6-9af2-23a582e6d587}<23.9 && {5c490d10-93e6-4bd6-9af2-23a582e6d587}>1.7, !- Program Line 7
  SET {b11fb975-e3cb-4c5a-823a-8557afffbc21} = 29.4, !- Program Line 8
  SET {023c0c05-4ac5-4fc9-b74a-4473bb886a9e} = 15.6, !- Program Line 9
  ELSEIF DaylightSavings==1 && DayOfWeek==1 && Hour==6 && {5c490d10-93e6-4bd6-9af2-23a582e6d587}<23.9 && {5c490d10-93e6-4bd6-9af2-23a582e6d587}>1.7, !- Program Line 10
  SET {b11fb975-e3cb-4c5a-823a-8557afffbc21} = 29.4, !- Program Line 11
  SET {023c0c05-4ac5-4fc9-b74a-4473bb886a9e} = 15.6, !- Program Line 12
  ELSE,                                   !- Program Line 13
  SET {b11fb975-e3cb-4c5a-823a-8557afffbc21} = NULL, !- Program Line 14
  SET {023c0c05-4ac5-4fc9-b74a-4473bb886a9e} = NULL, !- Program Line 15
