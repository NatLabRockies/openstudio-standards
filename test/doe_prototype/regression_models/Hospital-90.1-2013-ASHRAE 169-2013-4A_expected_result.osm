OS:EnergyManagementSystem:Program,
  {9b9e368b-4b02-404d-b4e7-9826fa1b54f6}, !- Handle
  ems_VAV_2_OptimumStartProg0,            !- Name
  IF DaylightSavings==0 && DayOfWeek>1 && Hour==5 && {a2fbcbea-aeb0-493b-a0cb-e7754cdc54df}<23.9 && {a2fbcbea-aeb0-493b-a0cb-e7754cdc54df}>1.7, !- Program Line 1
  SET {69a0af8b-3773-415c-9de5-131818f68a4a} = 29.4, !- Program Line 2
  SET {e09e44dd-24e3-4ecf-ab72-e696085f54ca} = 15.6, !- Program Line 3
  ELSEIF DaylightSavings==0 && DayOfWeek==1 && Hour==7 && {a2fbcbea-aeb0-493b-a0cb-e7754cdc54df}<23.9 && {a2fbcbea-aeb0-493b-a0cb-e7754cdc54df}>1.7, !- Program Line 4
  SET {69a0af8b-3773-415c-9de5-131818f68a4a} = 29.4, !- Program Line 5
  SET {e09e44dd-24e3-4ecf-ab72-e696085f54ca} = 15.6, !- Program Line 6
  ELSEIF DaylightSavings==1 && DayOfWeek>1 && Hour==4 && {a2fbcbea-aeb0-493b-a0cb-e7754cdc54df}<23.9 && {a2fbcbea-aeb0-493b-a0cb-e7754cdc54df}>1.7, !- Program Line 7
  SET {69a0af8b-3773-415c-9de5-131818f68a4a} = 29.4, !- Program Line 8
  SET {e09e44dd-24e3-4ecf-ab72-e696085f54ca} = 15.6, !- Program Line 9
  ELSEIF DaylightSavings==1 && DayOfWeek==1 && Hour==6 && {a2fbcbea-aeb0-493b-a0cb-e7754cdc54df}<23.9 && {a2fbcbea-aeb0-493b-a0cb-e7754cdc54df}>1.7, !- Program Line 10
  SET {69a0af8b-3773-415c-9de5-131818f68a4a} = 29.4, !- Program Line 11
  SET {e09e44dd-24e3-4ecf-ab72-e696085f54ca} = 15.6, !- Program Line 12
  ELSE,                                   !- Program Line 13
  SET {69a0af8b-3773-415c-9de5-131818f68a4a} = NULL, !- Program Line 14
  SET {e09e44dd-24e3-4ecf-ab72-e696085f54ca} = NULL, !- Program Line 15
  ENDIF;                                  !- Program Line 16

