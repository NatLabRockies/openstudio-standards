OS:EnergyManagementSystem:Program,
  {a9f85ecd-2f84-4b8f-b67a-682a01fb49a0}, !- Handle
  ems_VAV_POD_3_OptimumStartProg0,        !- Name
  IF DaylightSavings==0 && DayOfWeek>1 && Hour==5 && {a4db9eca-d3b2-477c-8902-4c1e293380fa}<23.9 && {a4db9eca-d3b2-477c-8902-4c1e293380fa}>1.7, !- Program Line 1
  SET {41a3c30c-cdd5-48ae-b3f5-aa03b26ebb61} = 29.4, !- Program Line 2
  SET {bea39de2-fe20-4d3b-a0c8-1a6e41955787} = 15.6, !- Program Line 3
  ELSEIF DaylightSavings==0 && DayOfWeek==1 && Hour==7 && {a4db9eca-d3b2-477c-8902-4c1e293380fa}<23.9 && {a4db9eca-d3b2-477c-8902-4c1e293380fa}>1.7, !- Program Line 4
  SET {41a3c30c-cdd5-48ae-b3f5-aa03b26ebb61} = 29.4, !- Program Line 5
  SET {bea39de2-fe20-4d3b-a0c8-1a6e41955787} = 15.6, !- Program Line 6
  ELSEIF DaylightSavings==1 && DayOfWeek>1 && Hour==4 && {a4db9eca-d3b2-477c-8902-4c1e293380fa}<23.9 && {a4db9eca-d3b2-477c-8902-4c1e293380fa}>1.7, !- Program Line 7
  SET {41a3c30c-cdd5-48ae-b3f5-aa03b26ebb61} = 29.4, !- Program Line 8
  SET {bea39de2-fe20-4d3b-a0c8-1a6e41955787} = 15.6, !- Program Line 9
  ELSEIF DaylightSavings==1 && DayOfWeek==1 && Hour==6 && {a4db9eca-d3b2-477c-8902-4c1e293380fa}<23.9 && {a4db9eca-d3b2-477c-8902-4c1e293380fa}>1.7, !- Program Line 10
  SET {41a3c30c-cdd5-48ae-b3f5-aa03b26ebb61} = 29.4, !- Program Line 11
  SET {bea39de2-fe20-4d3b-a0c8-1a6e41955787} = 15.6, !- Program Line 12
  ELSE,                                   !- Program Line 13
  SET {41a3c30c-cdd5-48ae-b3f5-aa03b26ebb61} = NULL, !- Program Line 14
  SET {bea39de2-fe20-4d3b-a0c8-1a6e41955787} = NULL, !- Program Line 15
