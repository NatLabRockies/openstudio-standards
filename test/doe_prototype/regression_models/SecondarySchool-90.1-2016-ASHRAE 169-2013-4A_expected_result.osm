  SET {9103a70b-62e8-42be-914e-8d33cb353fcb} = 15.6, !- Program Line 9
  ELSEIF DaylightSavings==1 && DayOfWeek==1 && Hour==6 && {c84517de-8265-43dd-805a-b470e066bbce}<23.9 && {c84517de-8265-43dd-805a-b470e066bbce}>1.7, !- Program Line 10
