  ELSEIF DaylightSavings==0 && DayOfWeek==1 && Hour==7 && {f2054173-5a45-4b1a-81ad-3cf178a3e7b8}<23.9 && {f2054173-5a45-4b1a-81ad-3cf178a3e7b8}>1.7, !- Program Line 4
  SET {fdb25972-1d30-463b-a6b3-7365da042698} = 29.4, !- Program Line 5
  SET {786936ea-1562-40be-9807-96e3af579bda} = 15.6, !- Program Line 6
  ELSEIF DaylightSavings==1 && DayOfWeek>1 && Hour==4 && {f2054173-5a45-4b1a-81ad-3cf178a3e7b8}<23.9 && {f2054173-5a45-4b1a-81ad-3cf178a3e7b8}>1.7, !- Program Line 7
  SET {fdb25972-1d30-463b-a6b3-7365da042698} = 29.4, !- Program Line 8
  SET {786936ea-1562-40be-9807-96e3af579bda} = 15.6, !- Program Line 9
  ELSEIF DaylightSavings==1 && DayOfWeek==1 && Hour==6 && {f2054173-5a45-4b1a-81ad-3cf178a3e7b8}<23.9 && {f2054173-5a45-4b1a-81ad-3cf178a3e7b8}>1.7, !- Program Line 10
  SET {fdb25972-1d30-463b-a6b3-7365da042698} = 29.4, !- Program Line 11
  SET {786936ea-1562-40be-9807-96e3af579bda} = 15.6, !- Program Line 12
  ELSE,                                   !- Program Line 13
  SET {fdb25972-1d30-463b-a6b3-7365da042698} = NULL, !- Program Line 14
  SET {786936ea-1562-40be-9807-96e3af579bda} = NULL, !- Program Line 15
