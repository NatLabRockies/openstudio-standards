  SET {f294cfbb-ddd7-473b-887d-1b7b4f320e93} = 29.4, !- Program Line 8
  SET {bddc8cf9-4b4f-4595-be47-a25761910099} = 15.6, !- Program Line 9
  ELSEIF DaylightSavings==1 && DayOfWeek==1 && Hour==6 && {6aa35731-1efb-4413-a93d-27127b5d52d8}<23.9 && {6aa35731-1efb-4413-a93d-27127b5d52d8}>1.7, !- Program Line 10
