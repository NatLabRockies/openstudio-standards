OS:EnergyManagementSystem:Program,
  {17c713eb-7ad2-457b-9cf9-550a4dcf7642}, !- Handle
  ems_VAV_POD_2_OptimumStartProg0,        !- Name
  IF DaylightSavings==0 && DayOfWeek>1 && Hour==5 && {1c6b2f90-b543-4d50-b155-744d0c216e7e}<23.9 && {1c6b2f90-b543-4d50-b155-744d0c216e7e}>1.7, !- Program Line 1
  SET {c459ae4a-5042-4283-a112-6ff4126f086f} = 29.4, !- Program Line 2
  SET {8b502a26-8434-44cd-8649-566ef9e42035} = 15.6, !- Program Line 3
  ELSEIF DaylightSavings==0 && DayOfWeek==1 && Hour==7 && {1c6b2f90-b543-4d50-b155-744d0c216e7e}<23.9 && {1c6b2f90-b543-4d50-b155-744d0c216e7e}>1.7, !- Program Line 4
  SET {c459ae4a-5042-4283-a112-6ff4126f086f} = 29.4, !- Program Line 5
  SET {8b502a26-8434-44cd-8649-566ef9e42035} = 15.6, !- Program Line 6
  ELSEIF DaylightSavings==1 && DayOfWeek>1 && Hour==4 && {1c6b2f90-b543-4d50-b155-744d0c216e7e}<23.9 && {1c6b2f90-b543-4d50-b155-744d0c216e7e}>1.7, !- Program Line 7
  SET {c459ae4a-5042-4283-a112-6ff4126f086f} = 29.4, !- Program Line 8
  SET {8b502a26-8434-44cd-8649-566ef9e42035} = 15.6, !- Program Line 9
  ELSEIF DaylightSavings==1 && DayOfWeek==1 && Hour==6 && {1c6b2f90-b543-4d50-b155-744d0c216e7e}<23.9 && {1c6b2f90-b543-4d50-b155-744d0c216e7e}>1.7, !- Program Line 10
  SET {c459ae4a-5042-4283-a112-6ff4126f086f} = 29.4, !- Program Line 11
  SET {8b502a26-8434-44cd-8649-566ef9e42035} = 15.6, !- Program Line 12
  ELSE,                                   !- Program Line 13
  SET {c459ae4a-5042-4283-a112-6ff4126f086f} = NULL, !- Program Line 14
  SET {8b502a26-8434-44cd-8649-566ef9e42035} = NULL, !- Program Line 15
  ENDIF;                                  !- Program Line 16

