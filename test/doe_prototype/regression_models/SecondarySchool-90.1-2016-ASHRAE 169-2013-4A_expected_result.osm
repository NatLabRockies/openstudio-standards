  ELSEIF DaylightSavings==0 && DayOfWeek==1 && Hour==7 && {c84517de-8265-43dd-805a-b470e066bbce}<23.9 && {c84517de-8265-43dd-805a-b470e066bbce}>1.7, !- Program Line 4
  SET {696374b1-5965-490e-9ef6-3d5552351bff} = 29.4, !- Program Line 5
  SET {9103a70b-62e8-42be-914e-8d33cb353fcb} = 15.6, !- Program Line 6
