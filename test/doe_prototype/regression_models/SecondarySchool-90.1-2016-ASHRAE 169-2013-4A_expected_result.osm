OS:EnergyManagementSystem:Program,
  {8847b214-6dd8-4e7e-af3d-cc24d7b7a1ff}, !- Handle
  ems_VAV_POD_2_OptimumStartProg0,        !- Name
  IF DaylightSavings==0 && DayOfWeek>1 && Hour==5 && {1b7ad7d9-7da0-4997-bf24-b0410ca19cc0}<23.9 && {1b7ad7d9-7da0-4997-bf24-b0410ca19cc0}>1.7, !- Program Line 1
  SET {4c7a504a-5561-488c-880c-50458aaae3bb} = 29.4, !- Program Line 2
  SET {845ccb2e-7b87-460e-a9cc-d055d8211a5e} = 15.6, !- Program Line 3
  ELSEIF DaylightSavings==0 && DayOfWeek==1 && Hour==7 && {1b7ad7d9-7da0-4997-bf24-b0410ca19cc0}<23.9 && {1b7ad7d9-7da0-4997-bf24-b0410ca19cc0}>1.7, !- Program Line 4
  SET {4c7a504a-5561-488c-880c-50458aaae3bb} = 29.4, !- Program Line 5
  SET {845ccb2e-7b87-460e-a9cc-d055d8211a5e} = 15.6, !- Program Line 6
  ELSEIF DaylightSavings==1 && DayOfWeek>1 && Hour==4 && {1b7ad7d9-7da0-4997-bf24-b0410ca19cc0}<23.9 && {1b7ad7d9-7da0-4997-bf24-b0410ca19cc0}>1.7, !- Program Line 7
  SET {4c7a504a-5561-488c-880c-50458aaae3bb} = 29.4, !- Program Line 8
  SET {845ccb2e-7b87-460e-a9cc-d055d8211a5e} = 15.6, !- Program Line 9
  ELSEIF DaylightSavings==1 && DayOfWeek==1 && Hour==6 && {1b7ad7d9-7da0-4997-bf24-b0410ca19cc0}<23.9 && {1b7ad7d9-7da0-4997-bf24-b0410ca19cc0}>1.7, !- Program Line 10
  SET {4c7a504a-5561-488c-880c-50458aaae3bb} = 29.4, !- Program Line 11
  SET {845ccb2e-7b87-460e-a9cc-d055d8211a5e} = 15.6, !- Program Line 12
  ELSE,                                   !- Program Line 13
  SET {4c7a504a-5561-488c-880c-50458aaae3bb} = NULL, !- Program Line 14
  SET {845ccb2e-7b87-460e-a9cc-d055d8211a5e} = NULL, !- Program Line 15
  ENDIF;                                  !- Program Line 16

