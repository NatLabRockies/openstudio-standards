  {9a05bc87-0ecf-483f-b387-2a77068e554e}, !- Handle
  ems_VAV_POD_3_OptimumStartProg0,        !- Name
  IF DaylightSavings==0 && DayOfWeek>1 && Hour==5 && {8e18f37b-365c-40db-b05e-dd6e4922fa64}<23.9 && {8e18f37b-365c-40db-b05e-dd6e4922fa64}>1.7, !- Program Line 1
  SET {f09a407d-1c24-4382-996a-aa5d7c7b0a72} = 29.4, !- Program Line 2
  SET {688d6219-dcc5-4382-839d-13f8882a914d} = 15.6, !- Program Line 3
  ELSEIF DaylightSavings==0 && DayOfWeek==1 && Hour==7 && {8e18f37b-365c-40db-b05e-dd6e4922fa64}<23.9 && {8e18f37b-365c-40db-b05e-dd6e4922fa64}>1.7, !- Program Line 4
  SET {f09a407d-1c24-4382-996a-aa5d7c7b0a72} = 29.4, !- Program Line 5
  SET {688d6219-dcc5-4382-839d-13f8882a914d} = 15.6, !- Program Line 6
  ELSEIF DaylightSavings==1 && DayOfWeek>1 && Hour==4 && {8e18f37b-365c-40db-b05e-dd6e4922fa64}<23.9 && {8e18f37b-365c-40db-b05e-dd6e4922fa64}>1.7, !- Program Line 7
  SET {f09a407d-1c24-4382-996a-aa5d7c7b0a72} = 29.4, !- Program Line 8
  SET {688d6219-dcc5-4382-839d-13f8882a914d} = 15.6, !- Program Line 9
  ELSEIF DaylightSavings==1 && DayOfWeek==1 && Hour==6 && {8e18f37b-365c-40db-b05e-dd6e4922fa64}<23.9 && {8e18f37b-365c-40db-b05e-dd6e4922fa64}>1.7, !- Program Line 10
  SET {f09a407d-1c24-4382-996a-aa5d7c7b0a72} = 29.4, !- Program Line 11
  SET {688d6219-dcc5-4382-839d-13f8882a914d} = 15.6, !- Program Line 12
  ELSE,                                   !- Program Line 13
  SET {f09a407d-1c24-4382-996a-aa5d7c7b0a72} = NULL, !- Program Line 14
  SET {688d6219-dcc5-4382-839d-13f8882a914d} = NULL, !- Program Line 15
