  ELSEIF DaylightSavings==1 && DayOfWeek>1 && Hour==4 && {7d0c5841-65bf-4a2e-80fd-9b7e6617d6da}<23.9 && {7d0c5841-65bf-4a2e-80fd-9b7e6617d6da}>1.7, !- Program Line 7
  SET {094fd2db-dc0a-4b3f-bfec-dfe40ca84c45} = 29.4, !- Program Line 8
  SET {ffd6f013-98b7-4f05-acf5-5d5dfe1de66b} = 15.6, !- Program Line 9
  ELSEIF DaylightSavings==1 && DayOfWeek==1 && Hour==6 && {7d0c5841-65bf-4a2e-80fd-9b7e6617d6da}<23.9 && {7d0c5841-65bf-4a2e-80fd-9b7e6617d6da}>1.7, !- Program Line 10
  SET {094fd2db-dc0a-4b3f-bfec-dfe40ca84c45} = 29.4, !- Program Line 11
  SET {ffd6f013-98b7-4f05-acf5-5d5dfe1de66b} = 15.6, !- Program Line 12
