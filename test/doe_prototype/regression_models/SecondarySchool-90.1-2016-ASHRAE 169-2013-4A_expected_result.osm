  ELSEIF DaylightSavings==0 && DayOfWeek==1 && Hour==7 && {6aa35731-1efb-4413-a93d-27127b5d52d8}<23.9 && {6aa35731-1efb-4413-a93d-27127b5d52d8}>1.7, !- Program Line 4
