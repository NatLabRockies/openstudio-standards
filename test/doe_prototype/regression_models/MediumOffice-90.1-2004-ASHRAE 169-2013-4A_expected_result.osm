  ems_5_Zone_PVAV_2_OptimumStartProg0,    !- Name
  IF DaylightSavings==0 && DayOfWeek>1 && Hour==5 && {eb68332e-8e5c-4a17-81b0-579d8a6c4d0e}<23.9 && {eb68332e-8e5c-4a17-81b0-579d8a6c4d0e}>1.7, !- Program Line 1
  SET {5a551bf9-2b9d-4af1-928b-0526bb62c94d} = 29.4, !- Program Line 2
  SET {797a5a53-d133-4060-b42c-f775e309731f} = 15.6, !- Program Line 3
  ELSEIF DaylightSavings==0 && DayOfWeek==1 && Hour==7 && {eb68332e-8e5c-4a17-81b0-579d8a6c4d0e}<23.9 && {eb68332e-8e5c-4a17-81b0-579d8a6c4d0e}>1.7, !- Program Line 4
  SET {5a551bf9-2b9d-4af1-928b-0526bb62c94d} = 29.4, !- Program Line 5
  SET {797a5a53-d133-4060-b42c-f775e309731f} = 15.6, !- Program Line 6
  ELSEIF DaylightSavings==1 && DayOfWeek>1 && Hour==4 && {eb68332e-8e5c-4a17-81b0-579d8a6c4d0e}<23.9 && {eb68332e-8e5c-4a17-81b0-579d8a6c4d0e}>1.7, !- Program Line 7
  SET {5a551bf9-2b9d-4af1-928b-0526bb62c94d} = 29.4, !- Program Line 8
  SET {797a5a53-d133-4060-b42c-f775e309731f} = 15.6, !- Program Line 9
  ELSEIF DaylightSavings==1 && DayOfWeek==1 && Hour==6 && {eb68332e-8e5c-4a17-81b0-579d8a6c4d0e}<23.9 && {eb68332e-8e5c-4a17-81b0-579d8a6c4d0e}>1.7, !- Program Line 10
  SET {5a551bf9-2b9d-4af1-928b-0526bb62c94d} = 29.4, !- Program Line 11
  SET {797a5a53-d133-4060-b42c-f775e309731f} = 15.6, !- Program Line 12
  ELSE,                                   !- Program Line 13
  SET {5a551bf9-2b9d-4af1-928b-0526bb62c94d} = NULL, !- Program Line 14
  SET {797a5a53-d133-4060-b42c-f775e309731f} = NULL, !- Program Line 15
  ENDIF;                                  !- Program Line 16

