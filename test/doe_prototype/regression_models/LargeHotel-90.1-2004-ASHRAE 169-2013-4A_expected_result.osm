OS:EnergyManagementSystem:Program,
  {e38cb14f-edb6-4398-ac4b-db2bd650a8ba}, !- Handle
  ems_VAV_WITH_REHEAT_OptimumStartProg0,  !- Name
  IF DaylightSavings==0 && DayOfWeek>1 && Hour==5 && {779cf688-f2b5-4cb6-aece-343452d2f56c}<23.9 && {779cf688-f2b5-4cb6-aece-343452d2f56c}>1.7, !- Program Line 1
  SET {84aa7d6a-d0f0-4154-b546-fe054f7d2701} = 29.4, !- Program Line 2
  SET {1a3902d0-2326-4f54-add1-3dafaa9e4d2a} = 15.6, !- Program Line 3
  ELSEIF DaylightSavings==0 && DayOfWeek==1 && Hour==7 && {779cf688-f2b5-4cb6-aece-343452d2f56c}<23.9 && {779cf688-f2b5-4cb6-aece-343452d2f56c}>1.7, !- Program Line 4
  SET {84aa7d6a-d0f0-4154-b546-fe054f7d2701} = 29.4, !- Program Line 5
  SET {1a3902d0-2326-4f54-add1-3dafaa9e4d2a} = 15.6, !- Program Line 6
  ELSEIF DaylightSavings==1 && DayOfWeek>1 && Hour==4 && {779cf688-f2b5-4cb6-aece-343452d2f56c}<23.9 && {779cf688-f2b5-4cb6-aece-343452d2f56c}>1.7, !- Program Line 7
  SET {84aa7d6a-d0f0-4154-b546-fe054f7d2701} = 29.4, !- Program Line 8
  SET {1a3902d0-2326-4f54-add1-3dafaa9e4d2a} = 15.6, !- Program Line 9
  ELSEIF DaylightSavings==1 && DayOfWeek==1 && Hour==6 && {779cf688-f2b5-4cb6-aece-343452d2f56c}<23.9 && {779cf688-f2b5-4cb6-aece-343452d2f56c}>1.7, !- Program Line 10
  SET {84aa7d6a-d0f0-4154-b546-fe054f7d2701} = 29.4, !- Program Line 11
  SET {1a3902d0-2326-4f54-add1-3dafaa9e4d2a} = 15.6, !- Program Line 12
  ELSE,                                   !- Program Line 13
  SET {84aa7d6a-d0f0-4154-b546-fe054f7d2701} = NULL, !- Program Line 14
  SET {1a3902d0-2326-4f54-add1-3dafaa9e4d2a} = NULL, !- Program Line 15
  ENDIF;                                  !- Program Line 16

