OS:EnergyManagementSystem:Program,
  {511b84a7-6a1e-4f9c-99d8-e89f6972095e}, !- Handle
  ems_VAV_WITH_REHEAT_OptimumStartProg0,  !- Name
  IF DaylightSavings==0 && DayOfWeek>1 && Hour==5 && {e8cd62a1-48c9-4429-a520-57373ce36ffd}<23.9 && {e8cd62a1-48c9-4429-a520-57373ce36ffd}>1.7, !- Program Line 1
  SET {ddb807d0-b5b0-4f46-8d5b-ecd027e4ed57} = 29.4, !- Program Line 2
  SET {858b2a43-3018-41f4-b736-8b24aaa2542d} = 15.6, !- Program Line 3
  ELSEIF DaylightSavings==0 && DayOfWeek==1 && Hour==7 && {e8cd62a1-48c9-4429-a520-57373ce36ffd}<23.9 && {e8cd62a1-48c9-4429-a520-57373ce36ffd}>1.7, !- Program Line 4
  SET {ddb807d0-b5b0-4f46-8d5b-ecd027e4ed57} = 29.4, !- Program Line 5
  SET {858b2a43-3018-41f4-b736-8b24aaa2542d} = 15.6, !- Program Line 6
  ELSEIF DaylightSavings==1 && DayOfWeek>1 && Hour==4 && {e8cd62a1-48c9-4429-a520-57373ce36ffd}<23.9 && {e8cd62a1-48c9-4429-a520-57373ce36ffd}>1.7, !- Program Line 7
  SET {ddb807d0-b5b0-4f46-8d5b-ecd027e4ed57} = 29.4, !- Program Line 8
  SET {858b2a43-3018-41f4-b736-8b24aaa2542d} = 15.6, !- Program Line 9
  ELSEIF DaylightSavings==1 && DayOfWeek==1 && Hour==6 && {e8cd62a1-48c9-4429-a520-57373ce36ffd}<23.9 && {e8cd62a1-48c9-4429-a520-57373ce36ffd}>1.7, !- Program Line 10
  SET {ddb807d0-b5b0-4f46-8d5b-ecd027e4ed57} = 29.4, !- Program Line 11
  SET {858b2a43-3018-41f4-b736-8b24aaa2542d} = 15.6, !- Program Line 12
  ELSE,                                   !- Program Line 13
  SET {ddb807d0-b5b0-4f46-8d5b-ecd027e4ed57} = NULL, !- Program Line 14
  SET {858b2a43-3018-41f4-b736-8b24aaa2542d} = NULL, !- Program Line 15
