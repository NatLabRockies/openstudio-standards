OS:EnergyManagementSystem:Program,
  {b26d003b-d1c5-4730-9bfe-69479f2b8723}, !- Handle
  ems_VAV_WITH_REHEAT_OptimumStartProg0,  !- Name
  IF DaylightSavings==0 && DayOfWeek>1 && Hour==5 && {1c4440d6-bd43-4eb0-8f8e-3a494672ed0f}<23.9 && {1c4440d6-bd43-4eb0-8f8e-3a494672ed0f}>1.7, !- Program Line 1
  SET {9f3d3c3f-c3d0-4492-a578-4f1b635513c4} = 29.4, !- Program Line 2
  SET {a2fc301c-223f-412a-ad23-e67206033769} = 15.6, !- Program Line 3
  ELSEIF DaylightSavings==0 && DayOfWeek==1 && Hour==7 && {1c4440d6-bd43-4eb0-8f8e-3a494672ed0f}<23.9 && {1c4440d6-bd43-4eb0-8f8e-3a494672ed0f}>1.7, !- Program Line 4
  SET {9f3d3c3f-c3d0-4492-a578-4f1b635513c4} = 29.4, !- Program Line 5
  SET {a2fc301c-223f-412a-ad23-e67206033769} = 15.6, !- Program Line 6
  ELSEIF DaylightSavings==1 && DayOfWeek>1 && Hour==4 && {1c4440d6-bd43-4eb0-8f8e-3a494672ed0f}<23.9 && {1c4440d6-bd43-4eb0-8f8e-3a494672ed0f}>1.7, !- Program Line 7
  SET {9f3d3c3f-c3d0-4492-a578-4f1b635513c4} = 29.4, !- Program Line 8
  SET {a2fc301c-223f-412a-ad23-e67206033769} = 15.6, !- Program Line 9
  ELSEIF DaylightSavings==1 && DayOfWeek==1 && Hour==6 && {1c4440d6-bd43-4eb0-8f8e-3a494672ed0f}<23.9 && {1c4440d6-bd43-4eb0-8f8e-3a494672ed0f}>1.7, !- Program Line 10
  SET {9f3d3c3f-c3d0-4492-a578-4f1b635513c4} = 29.4, !- Program Line 11
  SET {a2fc301c-223f-412a-ad23-e67206033769} = 15.6, !- Program Line 12
  ELSE,                                   !- Program Line 13
  SET {9f3d3c3f-c3d0-4492-a578-4f1b635513c4} = NULL, !- Program Line 14
  SET {a2fc301c-223f-412a-ad23-e67206033769} = NULL, !- Program Line 15
  ENDIF;                                  !- Program Line 16

