  {24d9d1da-ac9b-40ea-bd61-c9aacdd26ebd}, !- Handle
  ems_VAV_WITH_REHEAT_OptimumStartProg0,  !- Name
  IF DaylightSavings==0 && DayOfWeek>1 && Hour==5 && {d86802fd-cd93-40c5-ad5d-c1534c33e478}<23.9 && {d86802fd-cd93-40c5-ad5d-c1534c33e478}>1.7, !- Program Line 1
  SET {e90f86e4-b444-40e1-979e-3645cf6d0c64} = 29.4, !- Program Line 2
  SET {bff68690-ff4e-41df-b342-ecd60dfff8a8} = 15.6, !- Program Line 3
  ELSEIF DaylightSavings==0 && DayOfWeek==1 && Hour==7 && {d86802fd-cd93-40c5-ad5d-c1534c33e478}<23.9 && {d86802fd-cd93-40c5-ad5d-c1534c33e478}>1.7, !- Program Line 4
  SET {e90f86e4-b444-40e1-979e-3645cf6d0c64} = 29.4, !- Program Line 5
  SET {bff68690-ff4e-41df-b342-ecd60dfff8a8} = 15.6, !- Program Line 6
  ELSEIF DaylightSavings==1 && DayOfWeek>1 && Hour==4 && {d86802fd-cd93-40c5-ad5d-c1534c33e478}<23.9 && {d86802fd-cd93-40c5-ad5d-c1534c33e478}>1.7, !- Program Line 7
  SET {e90f86e4-b444-40e1-979e-3645cf6d0c64} = 29.4, !- Program Line 8
  SET {bff68690-ff4e-41df-b342-ecd60dfff8a8} = 15.6, !- Program Line 9
  ELSEIF DaylightSavings==1 && DayOfWeek==1 && Hour==6 && {d86802fd-cd93-40c5-ad5d-c1534c33e478}<23.9 && {d86802fd-cd93-40c5-ad5d-c1534c33e478}>1.7, !- Program Line 10
  SET {e90f86e4-b444-40e1-979e-3645cf6d0c64} = 29.4, !- Program Line 11
  SET {bff68690-ff4e-41df-b342-ecd60dfff8a8} = 15.6, !- Program Line 12
  ELSE,                                   !- Program Line 13
  SET {e90f86e4-b444-40e1-979e-3645cf6d0c64} = NULL, !- Program Line 14
  SET {bff68690-ff4e-41df-b342-ecd60dfff8a8} = NULL, !- Program Line 15
