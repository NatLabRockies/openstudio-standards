OS:EnergyManagementSystem:Program,
  {50677f11-c907-4054-8f5a-6f882efa9b66}, !- Handle
  ems_5_Zone_PVAV_OptimumStartProg0,      !- Name
  IF DaylightSavings==0 && DayOfWeek>1 && Hour==5 && {a8b7285e-0250-4066-81a2-9f4ac2b9aefd}<23.9 && {a8b7285e-0250-4066-81a2-9f4ac2b9aefd}>1.7, !- Program Line 1
  SET {68f3f9b6-36fd-4742-a1b5-ef0056548f75} = 29.4, !- Program Line 2
  SET {0fa59568-bd8d-4941-a438-1a77e9c2e666} = 15.6, !- Program Line 3
  ELSEIF DaylightSavings==0 && DayOfWeek==1 && Hour==7 && {a8b7285e-0250-4066-81a2-9f4ac2b9aefd}<23.9 && {a8b7285e-0250-4066-81a2-9f4ac2b9aefd}>1.7, !- Program Line 4
  SET {68f3f9b6-36fd-4742-a1b5-ef0056548f75} = 29.4, !- Program Line 5
  SET {0fa59568-bd8d-4941-a438-1a77e9c2e666} = 15.6, !- Program Line 6
  ELSEIF DaylightSavings==1 && DayOfWeek>1 && Hour==4 && {a8b7285e-0250-4066-81a2-9f4ac2b9aefd}<23.9 && {a8b7285e-0250-4066-81a2-9f4ac2b9aefd}>1.7, !- Program Line 7
  SET {68f3f9b6-36fd-4742-a1b5-ef0056548f75} = 29.4, !- Program Line 8
  SET {0fa59568-bd8d-4941-a438-1a77e9c2e666} = 15.6, !- Program Line 9
  ELSEIF DaylightSavings==1 && DayOfWeek==1 && Hour==6 && {a8b7285e-0250-4066-81a2-9f4ac2b9aefd}<23.9 && {a8b7285e-0250-4066-81a2-9f4ac2b9aefd}>1.7, !- Program Line 10
  SET {68f3f9b6-36fd-4742-a1b5-ef0056548f75} = 29.4, !- Program Line 11
  SET {0fa59568-bd8d-4941-a438-1a77e9c2e666} = 15.6, !- Program Line 12
  ELSE,                                   !- Program Line 13
  SET {68f3f9b6-36fd-4742-a1b5-ef0056548f75} = NULL, !- Program Line 14
  SET {0fa59568-bd8d-4941-a438-1a77e9c2e666} = NULL, !- Program Line 15
  ENDIF;                                  !- Program Line 16

