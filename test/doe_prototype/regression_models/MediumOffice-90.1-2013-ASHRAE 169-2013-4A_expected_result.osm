OS:EnergyManagementSystem:Program,
  {9e8c31bf-6027-4f0d-8f88-18a79003be64}, !- Handle
  ems_5_Zone_PVAV_OptimumStartProg0,      !- Name
  IF DaylightSavings==0 && DayOfWeek>1 && Hour==5 && {bc7ec340-2d6c-4c11-bbc4-45a1a079b314}<23.9 && {bc7ec340-2d6c-4c11-bbc4-45a1a079b314}>1.7, !- Program Line 1
  SET {7b4b435d-9bd6-40f8-aed1-fa3231c2b9a2} = 29.4, !- Program Line 2
  SET {bb8fb80b-c66e-4e49-bda2-cf6723e0c263} = 15.6, !- Program Line 3
  ELSEIF DaylightSavings==0 && DayOfWeek==1 && Hour==7 && {bc7ec340-2d6c-4c11-bbc4-45a1a079b314}<23.9 && {bc7ec340-2d6c-4c11-bbc4-45a1a079b314}>1.7, !- Program Line 4
  SET {7b4b435d-9bd6-40f8-aed1-fa3231c2b9a2} = 29.4, !- Program Line 5
  SET {bb8fb80b-c66e-4e49-bda2-cf6723e0c263} = 15.6, !- Program Line 6
  ELSEIF DaylightSavings==1 && DayOfWeek>1 && Hour==4 && {bc7ec340-2d6c-4c11-bbc4-45a1a079b314}<23.9 && {bc7ec340-2d6c-4c11-bbc4-45a1a079b314}>1.7, !- Program Line 7
  SET {7b4b435d-9bd6-40f8-aed1-fa3231c2b9a2} = 29.4, !- Program Line 8
  SET {bb8fb80b-c66e-4e49-bda2-cf6723e0c263} = 15.6, !- Program Line 9
  ELSEIF DaylightSavings==1 && DayOfWeek==1 && Hour==6 && {bc7ec340-2d6c-4c11-bbc4-45a1a079b314}<23.9 && {bc7ec340-2d6c-4c11-bbc4-45a1a079b314}>1.7, !- Program Line 10
  SET {7b4b435d-9bd6-40f8-aed1-fa3231c2b9a2} = 29.4, !- Program Line 11
  SET {bb8fb80b-c66e-4e49-bda2-cf6723e0c263} = 15.6, !- Program Line 12
  ELSE,                                   !- Program Line 13
  SET {7b4b435d-9bd6-40f8-aed1-fa3231c2b9a2} = NULL, !- Program Line 14
  SET {bb8fb80b-c66e-4e49-bda2-cf6723e0c263} = NULL, !- Program Line 15
  ENDIF;                                  !- Program Line 16

