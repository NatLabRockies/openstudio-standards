OS:EnergyManagementSystem:Program,
  {81d43c7d-c466-4e6c-94fe-56218315258c}, !- Handle
  ems_CAV_KITCHEN_OptimumStartProg0,      !- Name
  IF DaylightSavings==0 && DayOfWeek>1 && Hour==5 && {b493f409-d471-421d-880d-01cb9dd052b6}<23.9 && {b493f409-d471-421d-880d-01cb9dd052b6}>1.7, !- Program Line 1
  SET {f13e2153-1cbc-4192-90fe-8ec0718dba83} = 29.4, !- Program Line 2
  SET {9a1614fd-8b67-4b07-92b9-19fe906e6008} = 15.6, !- Program Line 3
  ELSEIF DaylightSavings==0 && DayOfWeek==1 && Hour==7 && {b493f409-d471-421d-880d-01cb9dd052b6}<23.9 && {b493f409-d471-421d-880d-01cb9dd052b6}>1.7, !- Program Line 4
  SET {f13e2153-1cbc-4192-90fe-8ec0718dba83} = 29.4, !- Program Line 5
  SET {9a1614fd-8b67-4b07-92b9-19fe906e6008} = 15.6, !- Program Line 6
  ELSEIF DaylightSavings==1 && DayOfWeek>1 && Hour==4 && {b493f409-d471-421d-880d-01cb9dd052b6}<23.9 && {b493f409-d471-421d-880d-01cb9dd052b6}>1.7, !- Program Line 7
  SET {f13e2153-1cbc-4192-90fe-8ec0718dba83} = 29.4, !- Program Line 8
  SET {9a1614fd-8b67-4b07-92b9-19fe906e6008} = 15.6, !- Program Line 9
  ELSEIF DaylightSavings==1 && DayOfWeek==1 && Hour==6 && {b493f409-d471-421d-880d-01cb9dd052b6}<23.9 && {b493f409-d471-421d-880d-01cb9dd052b6}>1.7, !- Program Line 10
  SET {f13e2153-1cbc-4192-90fe-8ec0718dba83} = 29.4, !- Program Line 11
  SET {9a1614fd-8b67-4b07-92b9-19fe906e6008} = 15.6, !- Program Line 12
  ELSE,                                   !- Program Line 13
  SET {f13e2153-1cbc-4192-90fe-8ec0718dba83} = NULL, !- Program Line 14
  SET {9a1614fd-8b67-4b07-92b9-19fe906e6008} = NULL, !- Program Line 15
  ENDIF;                                  !- Program Line 16

