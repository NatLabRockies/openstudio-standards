OS:EnergyManagementSystem:Program,
  {79828bd3-c144-4cb7-be1e-c5d2daf9caca}, !- Handle
  ems_VAV_2_OptimumStartProg0,            !- Name
  IF DaylightSavings==0 && DayOfWeek>1 && Hour==5 && {bee18709-7075-4ba4-9cd7-c822e564cf97}<23.9 && {bee18709-7075-4ba4-9cd7-c822e564cf97}>1.7, !- Program Line 1
  SET {8949480a-a460-497f-9b88-b3882802c4c7} = 29.4, !- Program Line 2
  SET {a4c3fc4d-c2ff-4432-a3c2-ee5fffb2f6ae} = 15.6, !- Program Line 3
  ELSEIF DaylightSavings==0 && DayOfWeek==1 && Hour==7 && {bee18709-7075-4ba4-9cd7-c822e564cf97}<23.9 && {bee18709-7075-4ba4-9cd7-c822e564cf97}>1.7, !- Program Line 4
  SET {8949480a-a460-497f-9b88-b3882802c4c7} = 29.4, !- Program Line 5
  SET {a4c3fc4d-c2ff-4432-a3c2-ee5fffb2f6ae} = 15.6, !- Program Line 6
  ELSEIF DaylightSavings==1 && DayOfWeek>1 && Hour==4 && {bee18709-7075-4ba4-9cd7-c822e564cf97}<23.9 && {bee18709-7075-4ba4-9cd7-c822e564cf97}>1.7, !- Program Line 7
  SET {8949480a-a460-497f-9b88-b3882802c4c7} = 29.4, !- Program Line 8
  SET {a4c3fc4d-c2ff-4432-a3c2-ee5fffb2f6ae} = 15.6, !- Program Line 9
  ELSEIF DaylightSavings==1 && DayOfWeek==1 && Hour==6 && {bee18709-7075-4ba4-9cd7-c822e564cf97}<23.9 && {bee18709-7075-4ba4-9cd7-c822e564cf97}>1.7, !- Program Line 10
  SET {8949480a-a460-497f-9b88-b3882802c4c7} = 29.4, !- Program Line 11
  SET {a4c3fc4d-c2ff-4432-a3c2-ee5fffb2f6ae} = 15.6, !- Program Line 12
  ELSE,                                   !- Program Line 13
  SET {8949480a-a460-497f-9b88-b3882802c4c7} = NULL, !- Program Line 14
  SET {a4c3fc4d-c2ff-4432-a3c2-ee5fffb2f6ae} = NULL, !- Program Line 15
  ENDIF;                                  !- Program Line 16

