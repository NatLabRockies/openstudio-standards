OS:EnergyManagementSystem:Program,
  {6c8b1583-62db-4cc6-b480-874b409af08b}, !- Handle
  ems_VAV_PATRMS_OptimumStartProg0,       !- Name
  IF DaylightSavings==0 && DayOfWeek>1 && Hour==5 && {cff2cee1-6b0d-4661-902b-3bee44e2d348}<23.9 && {cff2cee1-6b0d-4661-902b-3bee44e2d348}>1.7, !- Program Line 1
  SET {db0d3596-ee3f-40f8-a1d5-17183a1085f1} = 29.4, !- Program Line 2
  SET {7bb1ad2f-f66b-4a4f-afc4-c068868fc5d7} = 15.6, !- Program Line 3
  ELSEIF DaylightSavings==0 && DayOfWeek==1 && Hour==7 && {cff2cee1-6b0d-4661-902b-3bee44e2d348}<23.9 && {cff2cee1-6b0d-4661-902b-3bee44e2d348}>1.7, !- Program Line 4
  SET {db0d3596-ee3f-40f8-a1d5-17183a1085f1} = 29.4, !- Program Line 5
  SET {7bb1ad2f-f66b-4a4f-afc4-c068868fc5d7} = 15.6, !- Program Line 6
  ELSEIF DaylightSavings==1 && DayOfWeek>1 && Hour==4 && {cff2cee1-6b0d-4661-902b-3bee44e2d348}<23.9 && {cff2cee1-6b0d-4661-902b-3bee44e2d348}>1.7, !- Program Line 7
