OS:EnergyManagementSystem:Program,
  {3e2d97f4-5c74-45a5-99a5-7f46b46034db}, !- Handle
  ems_VAV_PATRMS_OptimumStartProg0,       !- Name
  IF DaylightSavings==0 && DayOfWeek>1 && Hour==5 && {414ac74f-ef33-4ab7-95ed-026f4f8cbe5a}<23.9 && {414ac74f-ef33-4ab7-95ed-026f4f8cbe5a}>1.7, !- Program Line 1
  SET {137a06de-783c-4ef1-af1f-c13d8920f7b0} = 29.4, !- Program Line 2
  SET {14d15e2e-e306-4304-ac06-34a882c2524e} = 15.6, !- Program Line 3
  ELSEIF DaylightSavings==0 && DayOfWeek==1 && Hour==7 && {414ac74f-ef33-4ab7-95ed-026f4f8cbe5a}<23.9 && {414ac74f-ef33-4ab7-95ed-026f4f8cbe5a}>1.7, !- Program Line 4
  SET {137a06de-783c-4ef1-af1f-c13d8920f7b0} = 29.4, !- Program Line 5
  SET {14d15e2e-e306-4304-ac06-34a882c2524e} = 15.6, !- Program Line 6
  ELSEIF DaylightSavings==1 && DayOfWeek>1 && Hour==4 && {414ac74f-ef33-4ab7-95ed-026f4f8cbe5a}<23.9 && {414ac74f-ef33-4ab7-95ed-026f4f8cbe5a}>1.7, !- Program Line 7
  SET {137a06de-783c-4ef1-af1f-c13d8920f7b0} = 29.4, !- Program Line 8
  SET {14d15e2e-e306-4304-ac06-34a882c2524e} = 15.6, !- Program Line 9
  ELSEIF DaylightSavings==1 && DayOfWeek==1 && Hour==6 && {414ac74f-ef33-4ab7-95ed-026f4f8cbe5a}<23.9 && {414ac74f-ef33-4ab7-95ed-026f4f8cbe5a}>1.7, !- Program Line 10
  SET {137a06de-783c-4ef1-af1f-c13d8920f7b0} = 29.4, !- Program Line 11
  SET {14d15e2e-e306-4304-ac06-34a882c2524e} = 15.6, !- Program Line 12
  ELSE,                                   !- Program Line 13
  SET {137a06de-783c-4ef1-af1f-c13d8920f7b0} = NULL, !- Program Line 14
  SET {14d15e2e-e306-4304-ac06-34a882c2524e} = NULL, !- Program Line 15
  ENDIF;                                  !- Program Line 16

