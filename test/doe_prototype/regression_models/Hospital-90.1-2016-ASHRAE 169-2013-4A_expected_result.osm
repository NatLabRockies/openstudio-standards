OS:EnergyManagementSystem:Program,
  {b0170cc5-d491-49a5-947b-da02788c34fa}, !- Handle
  ems_VAV_PATRMS_OptimumStartProg0,       !- Name
  IF DaylightSavings==0 && DayOfWeek>1 && Hour==5 && {388bc939-1d1e-4741-b47c-15ed6b46d3f8}<23.9 && {388bc939-1d1e-4741-b47c-15ed6b46d3f8}>1.7, !- Program Line 1
  SET {27afc1f3-1ec9-49f3-af39-8ce7159df569} = 29.4, !- Program Line 2
  SET {693df006-7e5b-473a-9856-7a0b5811fe4e} = 15.6, !- Program Line 3
  ELSEIF DaylightSavings==0 && DayOfWeek==1 && Hour==7 && {388bc939-1d1e-4741-b47c-15ed6b46d3f8}<23.9 && {388bc939-1d1e-4741-b47c-15ed6b46d3f8}>1.7, !- Program Line 4
  SET {27afc1f3-1ec9-49f3-af39-8ce7159df569} = 29.4, !- Program Line 5
  SET {693df006-7e5b-473a-9856-7a0b5811fe4e} = 15.6, !- Program Line 6
  ELSEIF DaylightSavings==1 && DayOfWeek>1 && Hour==4 && {388bc939-1d1e-4741-b47c-15ed6b46d3f8}<23.9 && {388bc939-1d1e-4741-b47c-15ed6b46d3f8}>1.7, !- Program Line 7
  SET {27afc1f3-1ec9-49f3-af39-8ce7159df569} = 29.4, !- Program Line 8
  SET {693df006-7e5b-473a-9856-7a0b5811fe4e} = 15.6, !- Program Line 9
  ELSEIF DaylightSavings==1 && DayOfWeek==1 && Hour==6 && {388bc939-1d1e-4741-b47c-15ed6b46d3f8}<23.9 && {388bc939-1d1e-4741-b47c-15ed6b46d3f8}>1.7, !- Program Line 10
  SET {27afc1f3-1ec9-49f3-af39-8ce7159df569} = 29.4, !- Program Line 11
  SET {693df006-7e5b-473a-9856-7a0b5811fe4e} = 15.6, !- Program Line 12
  ELSE,                                   !- Program Line 13
  SET {27afc1f3-1ec9-49f3-af39-8ce7159df569} = NULL, !- Program Line 14
  SET {693df006-7e5b-473a-9856-7a0b5811fe4e} = NULL, !- Program Line 15
  ENDIF;                                  !- Program Line 16

