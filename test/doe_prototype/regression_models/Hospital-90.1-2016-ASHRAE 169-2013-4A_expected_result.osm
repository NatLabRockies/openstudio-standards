  {6490703c-e485-4ffc-b979-7bca6f18a016}, !- Handle
  ems_VAV_PATRMS_OptimumStartProg0,       !- Name
  IF DaylightSavings==0 && DayOfWeek>1 && Hour==5 && {61800025-4773-45b9-a18d-2c3f535adc4e}<23.9 && {61800025-4773-45b9-a18d-2c3f535adc4e}>1.7, !- Program Line 1
  SET {b5dbc640-3258-4ea0-9a60-cc3170b1db62} = 29.4, !- Program Line 2
  SET {406b1f34-c06c-4599-abcf-101f330a48b1} = 15.6, !- Program Line 3
  ELSEIF DaylightSavings==0 && DayOfWeek==1 && Hour==7 && {61800025-4773-45b9-a18d-2c3f535adc4e}<23.9 && {61800025-4773-45b9-a18d-2c3f535adc4e}>1.7, !- Program Line 4
  SET {b5dbc640-3258-4ea0-9a60-cc3170b1db62} = 29.4, !- Program Line 5
  SET {406b1f34-c06c-4599-abcf-101f330a48b1} = 15.6, !- Program Line 6
  ELSEIF DaylightSavings==1 && DayOfWeek>1 && Hour==4 && {61800025-4773-45b9-a18d-2c3f535adc4e}<23.9 && {61800025-4773-45b9-a18d-2c3f535adc4e}>1.7, !- Program Line 7
  SET {b5dbc640-3258-4ea0-9a60-cc3170b1db62} = 29.4, !- Program Line 8
  SET {406b1f34-c06c-4599-abcf-101f330a48b1} = 15.6, !- Program Line 9
  ELSEIF DaylightSavings==1 && DayOfWeek==1 && Hour==6 && {61800025-4773-45b9-a18d-2c3f535adc4e}<23.9 && {61800025-4773-45b9-a18d-2c3f535adc4e}>1.7, !- Program Line 10
  SET {b5dbc640-3258-4ea0-9a60-cc3170b1db62} = 29.4, !- Program Line 11
  SET {406b1f34-c06c-4599-abcf-101f330a48b1} = 15.6, !- Program Line 12
  ELSE,                                   !- Program Line 13
  SET {b5dbc640-3258-4ea0-9a60-cc3170b1db62} = NULL, !- Program Line 14
  SET {406b1f34-c06c-4599-abcf-101f330a48b1} = NULL, !- Program Line 15
  ENDIF;                                  !- Program Line 16

