OS:EnergyManagementSystem:Program,
  {ed3fd236-4c23-4e65-83ee-ba33ad0a5bc0}, !- Handle
  ems_VAV_2_OptimumStartProg0,            !- Name
  IF DaylightSavings==0 && DayOfWeek>1 && Hour==5 && {f7328697-b7b1-4295-a94f-2c4626995b2e}<23.9 && {f7328697-b7b1-4295-a94f-2c4626995b2e}>1.7, !- Program Line 1
  SET {ee3d64a6-6723-44ac-9740-1ef030f87639} = 29.4, !- Program Line 2
  SET {57491c48-e648-4c46-b081-8bec41df6cfe} = 15.6, !- Program Line 3
  ELSEIF DaylightSavings==0 && DayOfWeek==1 && Hour==7 && {f7328697-b7b1-4295-a94f-2c4626995b2e}<23.9 && {f7328697-b7b1-4295-a94f-2c4626995b2e}>1.7, !- Program Line 4
  SET {ee3d64a6-6723-44ac-9740-1ef030f87639} = 29.4, !- Program Line 5
  SET {57491c48-e648-4c46-b081-8bec41df6cfe} = 15.6, !- Program Line 6
  ELSEIF DaylightSavings==1 && DayOfWeek>1 && Hour==4 && {f7328697-b7b1-4295-a94f-2c4626995b2e}<23.9 && {f7328697-b7b1-4295-a94f-2c4626995b2e}>1.7, !- Program Line 7
  SET {ee3d64a6-6723-44ac-9740-1ef030f87639} = 29.4, !- Program Line 8
  SET {57491c48-e648-4c46-b081-8bec41df6cfe} = 15.6, !- Program Line 9
  ELSEIF DaylightSavings==1 && DayOfWeek==1 && Hour==6 && {f7328697-b7b1-4295-a94f-2c4626995b2e}<23.9 && {f7328697-b7b1-4295-a94f-2c4626995b2e}>1.7, !- Program Line 10
  SET {ee3d64a6-6723-44ac-9740-1ef030f87639} = 29.4, !- Program Line 11
  SET {57491c48-e648-4c46-b081-8bec41df6cfe} = 15.6, !- Program Line 12
  ELSE,                                   !- Program Line 13
  SET {ee3d64a6-6723-44ac-9740-1ef030f87639} = NULL, !- Program Line 14
  SET {57491c48-e648-4c46-b081-8bec41df6cfe} = NULL, !- Program Line 15
  ENDIF;                                  !- Program Line 16

