OS:EnergyManagementSystem:Program,
  {bfa451ba-d2cf-4861-a06b-181e4b026733}, !- Handle
  ems_VAV_PATRMS_OptimumStartProg0,       !- Name
  IF DaylightSavings==0 && DayOfWeek>1 && Hour==5 && {4829f5b4-f7e4-4ada-9617-123b48dedd02}<23.9 && {4829f5b4-f7e4-4ada-9617-123b48dedd02}>1.7, !- Program Line 1
  SET {fc4813fb-3028-4aab-93a5-796a9315d6b7} = 29.4, !- Program Line 2
  SET {58136986-fa16-4424-8f4a-90236d25e21a} = 15.6, !- Program Line 3
  ELSEIF DaylightSavings==0 && DayOfWeek==1 && Hour==7 && {4829f5b4-f7e4-4ada-9617-123b48dedd02}<23.9 && {4829f5b4-f7e4-4ada-9617-123b48dedd02}>1.7, !- Program Line 4
  SET {fc4813fb-3028-4aab-93a5-796a9315d6b7} = 29.4, !- Program Line 5
  SET {58136986-fa16-4424-8f4a-90236d25e21a} = 15.6, !- Program Line 6
  ELSEIF DaylightSavings==1 && DayOfWeek>1 && Hour==4 && {4829f5b4-f7e4-4ada-9617-123b48dedd02}<23.9 && {4829f5b4-f7e4-4ada-9617-123b48dedd02}>1.7, !- Program Line 7
  SET {fc4813fb-3028-4aab-93a5-796a9315d6b7} = 29.4, !- Program Line 8
  SET {58136986-fa16-4424-8f4a-90236d25e21a} = 15.6, !- Program Line 9
  ELSEIF DaylightSavings==1 && DayOfWeek==1 && Hour==6 && {4829f5b4-f7e4-4ada-9617-123b48dedd02}<23.9 && {4829f5b4-f7e4-4ada-9617-123b48dedd02}>1.7, !- Program Line 10
  SET {fc4813fb-3028-4aab-93a5-796a9315d6b7} = 29.4, !- Program Line 11
  SET {58136986-fa16-4424-8f4a-90236d25e21a} = 15.6, !- Program Line 12
  ELSE,                                   !- Program Line 13
  SET {fc4813fb-3028-4aab-93a5-796a9315d6b7} = NULL, !- Program Line 14
  SET {58136986-fa16-4424-8f4a-90236d25e21a} = NULL, !- Program Line 15
  ENDIF;                                  !- Program Line 16

