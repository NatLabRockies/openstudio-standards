OS:EnergyManagementSystem:Program,
  {9f62751e-6706-4cc4-84c9-e872f869dad7}, !- Handle
  ems_CAV_KITCHEN_OptimumStartProg0,      !- Name
  IF DaylightSavings==0 && DayOfWeek>1 && Hour==5 && {b710abcc-5746-4d07-ad2e-f9d2949c0ace}<23.9 && {b710abcc-5746-4d07-ad2e-f9d2949c0ace}>1.7, !- Program Line 1
  SET {e2c7206c-bd9b-481c-b8f7-041a24f05c0f} = 29.4, !- Program Line 2
  SET {c7a5dfc2-e78d-4156-8c77-a65c8d01cb80} = 15.6, !- Program Line 3
  ELSEIF DaylightSavings==0 && DayOfWeek==1 && Hour==7 && {b710abcc-5746-4d07-ad2e-f9d2949c0ace}<23.9 && {b710abcc-5746-4d07-ad2e-f9d2949c0ace}>1.7, !- Program Line 4
  SET {e2c7206c-bd9b-481c-b8f7-041a24f05c0f} = 29.4, !- Program Line 5
  SET {c7a5dfc2-e78d-4156-8c77-a65c8d01cb80} = 15.6, !- Program Line 6
  ELSEIF DaylightSavings==1 && DayOfWeek>1 && Hour==4 && {b710abcc-5746-4d07-ad2e-f9d2949c0ace}<23.9 && {b710abcc-5746-4d07-ad2e-f9d2949c0ace}>1.7, !- Program Line 7
  SET {e2c7206c-bd9b-481c-b8f7-041a24f05c0f} = 29.4, !- Program Line 8
  SET {c7a5dfc2-e78d-4156-8c77-a65c8d01cb80} = 15.6, !- Program Line 9
  ELSEIF DaylightSavings==1 && DayOfWeek==1 && Hour==6 && {b710abcc-5746-4d07-ad2e-f9d2949c0ace}<23.9 && {b710abcc-5746-4d07-ad2e-f9d2949c0ace}>1.7, !- Program Line 10
  SET {e2c7206c-bd9b-481c-b8f7-041a24f05c0f} = 29.4, !- Program Line 11
  SET {c7a5dfc2-e78d-4156-8c77-a65c8d01cb80} = 15.6, !- Program Line 12
  ELSE,                                   !- Program Line 13
  SET {e2c7206c-bd9b-481c-b8f7-041a24f05c0f} = NULL, !- Program Line 14
  SET {c7a5dfc2-e78d-4156-8c77-a65c8d01cb80} = NULL, !- Program Line 15
  ENDIF;                                  !- Program Line 16

