OS:EnergyManagementSystem:Program,
  {c9fed81a-6636-49ec-b9d8-4ddbee8c596f}, !- Handle
  ems_VAV_WITH_REHEAT_OptimumStartProg0,  !- Name
  IF DaylightSavings==0 && DayOfWeek>1 && Hour==5 && {f2bd665e-c03b-4411-865b-fbc8a62741c7}<23.9 && {f2bd665e-c03b-4411-865b-fbc8a62741c7}>1.7, !- Program Line 1
  SET {3b02e850-19fb-4cc8-b122-8471a0ce79d0} = 29.4, !- Program Line 2
  SET {5b8a26ad-eea2-4d7f-969c-d52f97e7479d} = 15.6, !- Program Line 3
  ELSEIF DaylightSavings==0 && DayOfWeek==1 && Hour==7 && {f2bd665e-c03b-4411-865b-fbc8a62741c7}<23.9 && {f2bd665e-c03b-4411-865b-fbc8a62741c7}>1.7, !- Program Line 4
  SET {3b02e850-19fb-4cc8-b122-8471a0ce79d0} = 29.4, !- Program Line 5
  SET {5b8a26ad-eea2-4d7f-969c-d52f97e7479d} = 15.6, !- Program Line 6
  ELSEIF DaylightSavings==1 && DayOfWeek>1 && Hour==4 && {f2bd665e-c03b-4411-865b-fbc8a62741c7}<23.9 && {f2bd665e-c03b-4411-865b-fbc8a62741c7}>1.7, !- Program Line 7
  SET {3b02e850-19fb-4cc8-b122-8471a0ce79d0} = 29.4, !- Program Line 8
  SET {5b8a26ad-eea2-4d7f-969c-d52f97e7479d} = 15.6, !- Program Line 9
  ELSEIF DaylightSavings==1 && DayOfWeek==1 && Hour==6 && {f2bd665e-c03b-4411-865b-fbc8a62741c7}<23.9 && {f2bd665e-c03b-4411-865b-fbc8a62741c7}>1.7, !- Program Line 10
  SET {3b02e850-19fb-4cc8-b122-8471a0ce79d0} = 29.4, !- Program Line 11
  SET {5b8a26ad-eea2-4d7f-969c-d52f97e7479d} = 15.6, !- Program Line 12
  ELSE,                                   !- Program Line 13
  SET {3b02e850-19fb-4cc8-b122-8471a0ce79d0} = NULL, !- Program Line 14
  SET {5b8a26ad-eea2-4d7f-969c-d52f97e7479d} = NULL, !- Program Line 15
  ENDIF;                                  !- Program Line 16

