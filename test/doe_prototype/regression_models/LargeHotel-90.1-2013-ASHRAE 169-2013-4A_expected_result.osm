OS:EnergyManagementSystem:Program,
  {9e22cad3-1b50-4222-b9ec-a7907ac50e88}, !- Handle
  ems_VAV_WITH_REHEAT_OptimumStartProg0,  !- Name
  IF DaylightSavings==0 && DayOfWeek>1 && Hour==5 && {c1a7dc5f-29d0-4577-bb1e-1233c968bc08}<23.9 && {c1a7dc5f-29d0-4577-bb1e-1233c968bc08}>1.7, !- Program Line 1
  SET {0a86553b-7f08-456f-afb2-7f412aff655d} = 29.4, !- Program Line 2
  SET {6449487c-3f60-40b4-bea5-24c0e2ae4649} = 15.6, !- Program Line 3
  ELSEIF DaylightSavings==0 && DayOfWeek==1 && Hour==7 && {c1a7dc5f-29d0-4577-bb1e-1233c968bc08}<23.9 && {c1a7dc5f-29d0-4577-bb1e-1233c968bc08}>1.7, !- Program Line 4
  SET {0a86553b-7f08-456f-afb2-7f412aff655d} = 29.4, !- Program Line 5
  SET {6449487c-3f60-40b4-bea5-24c0e2ae4649} = 15.6, !- Program Line 6
  ELSEIF DaylightSavings==1 && DayOfWeek>1 && Hour==4 && {c1a7dc5f-29d0-4577-bb1e-1233c968bc08}<23.9 && {c1a7dc5f-29d0-4577-bb1e-1233c968bc08}>1.7, !- Program Line 7
  SET {0a86553b-7f08-456f-afb2-7f412aff655d} = 29.4, !- Program Line 8
  SET {6449487c-3f60-40b4-bea5-24c0e2ae4649} = 15.6, !- Program Line 9
  ELSEIF DaylightSavings==1 && DayOfWeek==1 && Hour==6 && {c1a7dc5f-29d0-4577-bb1e-1233c968bc08}<23.9 && {c1a7dc5f-29d0-4577-bb1e-1233c968bc08}>1.7, !- Program Line 10
  SET {0a86553b-7f08-456f-afb2-7f412aff655d} = 29.4, !- Program Line 11
  SET {6449487c-3f60-40b4-bea5-24c0e2ae4649} = 15.6, !- Program Line 12
  ELSE,                                   !- Program Line 13
  SET {0a86553b-7f08-456f-afb2-7f412aff655d} = NULL, !- Program Line 14
  SET {6449487c-3f60-40b4-bea5-24c0e2ae4649} = NULL, !- Program Line 15
  ENDIF;                                  !- Program Line 16

