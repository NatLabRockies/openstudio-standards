OS:EnergyManagementSystem:Program,
  {5545cd81-00c6-4ffb-819c-0420c271c703}, !- Handle
  ems_VAV_WITH_REHEAT_OptimumStartProg0,  !- Name
  IF DaylightSavings==0 && DayOfWeek>1 && Hour==5 && {8d024fd6-fa94-4122-b6aa-1da8384aad88}<23.9 && {8d024fd6-fa94-4122-b6aa-1da8384aad88}>1.7, !- Program Line 1
  SET {e3448c9b-cea7-4fe6-a6dd-561dda4020f1} = 29.4, !- Program Line 2
  SET {c128f17e-d0df-4d88-9a55-e60d44cf87e4} = 15.6, !- Program Line 3
  ELSEIF DaylightSavings==0 && DayOfWeek==1 && Hour==7 && {8d024fd6-fa94-4122-b6aa-1da8384aad88}<23.9 && {8d024fd6-fa94-4122-b6aa-1da8384aad88}>1.7, !- Program Line 4
  SET {e3448c9b-cea7-4fe6-a6dd-561dda4020f1} = 29.4, !- Program Line 5
  SET {c128f17e-d0df-4d88-9a55-e60d44cf87e4} = 15.6, !- Program Line 6
  ELSEIF DaylightSavings==1 && DayOfWeek>1 && Hour==4 && {8d024fd6-fa94-4122-b6aa-1da8384aad88}<23.9 && {8d024fd6-fa94-4122-b6aa-1da8384aad88}>1.7, !- Program Line 7
  SET {e3448c9b-cea7-4fe6-a6dd-561dda4020f1} = 29.4, !- Program Line 8
  SET {c128f17e-d0df-4d88-9a55-e60d44cf87e4} = 15.6, !- Program Line 9
  ELSEIF DaylightSavings==1 && DayOfWeek==1 && Hour==6 && {8d024fd6-fa94-4122-b6aa-1da8384aad88}<23.9 && {8d024fd6-fa94-4122-b6aa-1da8384aad88}>1.7, !- Program Line 10
  SET {e3448c9b-cea7-4fe6-a6dd-561dda4020f1} = 29.4, !- Program Line 11
  SET {c128f17e-d0df-4d88-9a55-e60d44cf87e4} = 15.6, !- Program Line 12
  ELSE,                                   !- Program Line 13
  SET {e3448c9b-cea7-4fe6-a6dd-561dda4020f1} = NULL, !- Program Line 14
  SET {c128f17e-d0df-4d88-9a55-e60d44cf87e4} = NULL, !- Program Line 15
  ENDIF;                                  !- Program Line 16

