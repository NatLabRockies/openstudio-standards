OS:EnergyManagementSystem:Program,
  {bb3fefeb-7d20-4577-8374-924ee650f5eb}, !- Handle
  ems_VAV_WITH_REHEAT_OptimumStartProg0,  !- Name
  IF DaylightSavings==0 && DayOfWeek>1 && Hour==5 && {3b87312a-7f2d-41cd-88fc-84109acc7bf5}<23.9 && {3b87312a-7f2d-41cd-88fc-84109acc7bf5}>1.7, !- Program Line 1
  SET {2be3ca10-51f6-4c5f-acd1-8025059a4a3d} = 29.4, !- Program Line 2
  SET {a30ae6a6-e28c-4808-9f50-3c67ed059dbe} = 15.6, !- Program Line 3
  ELSEIF DaylightSavings==0 && DayOfWeek==1 && Hour==7 && {3b87312a-7f2d-41cd-88fc-84109acc7bf5}<23.9 && {3b87312a-7f2d-41cd-88fc-84109acc7bf5}>1.7, !- Program Line 4
  SET {2be3ca10-51f6-4c5f-acd1-8025059a4a3d} = 29.4, !- Program Line 5
  SET {a30ae6a6-e28c-4808-9f50-3c67ed059dbe} = 15.6, !- Program Line 6
  ELSEIF DaylightSavings==1 && DayOfWeek>1 && Hour==4 && {3b87312a-7f2d-41cd-88fc-84109acc7bf5}<23.9 && {3b87312a-7f2d-41cd-88fc-84109acc7bf5}>1.7, !- Program Line 7
  SET {2be3ca10-51f6-4c5f-acd1-8025059a4a3d} = 29.4, !- Program Line 8
  SET {a30ae6a6-e28c-4808-9f50-3c67ed059dbe} = 15.6, !- Program Line 9
  ELSEIF DaylightSavings==1 && DayOfWeek==1 && Hour==6 && {3b87312a-7f2d-41cd-88fc-84109acc7bf5}<23.9 && {3b87312a-7f2d-41cd-88fc-84109acc7bf5}>1.7, !- Program Line 10
  SET {2be3ca10-51f6-4c5f-acd1-8025059a4a3d} = 29.4, !- Program Line 11
  SET {a30ae6a6-e28c-4808-9f50-3c67ed059dbe} = 15.6, !- Program Line 12
  ELSE,                                   !- Program Line 13
  SET {2be3ca10-51f6-4c5f-acd1-8025059a4a3d} = NULL, !- Program Line 14
  SET {a30ae6a6-e28c-4808-9f50-3c67ed059dbe} = NULL, !- Program Line 15
  ENDIF;                                  !- Program Line 16

