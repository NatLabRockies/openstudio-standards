OS:EnergyManagementSystem:Program,
  {a09614e5-fa8c-439c-925b-63fa26775fbe}, !- Handle
  ems_VAV_WITH_REHEAT_OptimumStartProg0,  !- Name
  IF DaylightSavings==0 && DayOfWeek>1 && Hour==5 && {b71c9e66-0d82-457a-90b3-2eaa4854d769}<23.9 && {b71c9e66-0d82-457a-90b3-2eaa4854d769}>1.7, !- Program Line 1
  SET {a955cea8-ed94-498a-89e1-3f8043111d12} = 29.4, !- Program Line 2
  SET {b1f0623b-6818-4512-b6c9-797537e856ec} = 15.6, !- Program Line 3
  ELSEIF DaylightSavings==0 && DayOfWeek==1 && Hour==7 && {b71c9e66-0d82-457a-90b3-2eaa4854d769}<23.9 && {b71c9e66-0d82-457a-90b3-2eaa4854d769}>1.7, !- Program Line 4
  SET {a955cea8-ed94-498a-89e1-3f8043111d12} = 29.4, !- Program Line 5
  SET {b1f0623b-6818-4512-b6c9-797537e856ec} = 15.6, !- Program Line 6
  ELSEIF DaylightSavings==1 && DayOfWeek>1 && Hour==4 && {b71c9e66-0d82-457a-90b3-2eaa4854d769}<23.9 && {b71c9e66-0d82-457a-90b3-2eaa4854d769}>1.7, !- Program Line 7
  SET {a955cea8-ed94-498a-89e1-3f8043111d12} = 29.4, !- Program Line 8
  SET {b1f0623b-6818-4512-b6c9-797537e856ec} = 15.6, !- Program Line 9
  ELSEIF DaylightSavings==1 && DayOfWeek==1 && Hour==6 && {b71c9e66-0d82-457a-90b3-2eaa4854d769}<23.9 && {b71c9e66-0d82-457a-90b3-2eaa4854d769}>1.7, !- Program Line 10
  SET {a955cea8-ed94-498a-89e1-3f8043111d12} = 29.4, !- Program Line 11
  SET {b1f0623b-6818-4512-b6c9-797537e856ec} = 15.6, !- Program Line 12
  ELSE,                                   !- Program Line 13
  SET {a955cea8-ed94-498a-89e1-3f8043111d12} = NULL, !- Program Line 14
  SET {b1f0623b-6818-4512-b6c9-797537e856ec} = NULL, !- Program Line 15
  ENDIF;                                  !- Program Line 16

