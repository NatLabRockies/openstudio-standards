  SET {854f3414-5178-42ad-aa7a-723534aad5ff} = 15.6, !- Program Line 3
  ELSEIF DaylightSavings==0 && DayOfWeek==1 && Hour==7 && {1c4300f7-f9ba-4187-8668-5895c33f15dd}<23.9 && {1c4300f7-f9ba-4187-8668-5895c33f15dd}>1.7, !- Program Line 4
  SET {5576f37b-6d73-49d8-a5dd-288f4e1416fa} = 29.4, !- Program Line 5
  SET {854f3414-5178-42ad-aa7a-723534aad5ff} = 15.6, !- Program Line 6
  ELSEIF DaylightSavings==1 && DayOfWeek>1 && Hour==4 && {1c4300f7-f9ba-4187-8668-5895c33f15dd}<23.9 && {1c4300f7-f9ba-4187-8668-5895c33f15dd}>1.7, !- Program Line 7
  SET {5576f37b-6d73-49d8-a5dd-288f4e1416fa} = 29.4, !- Program Line 8
  SET {854f3414-5178-42ad-aa7a-723534aad5ff} = 15.6, !- Program Line 9
  ELSEIF DaylightSavings==1 && DayOfWeek==1 && Hour==6 && {1c4300f7-f9ba-4187-8668-5895c33f15dd}<23.9 && {1c4300f7-f9ba-4187-8668-5895c33f15dd}>1.7, !- Program Line 10
  SET {5576f37b-6d73-49d8-a5dd-288f4e1416fa} = 29.4, !- Program Line 11
  SET {854f3414-5178-42ad-aa7a-723534aad5ff} = 15.6, !- Program Line 12
