  {165199e9-a7df-4e82-9a86-c45e54b5cfb7}, !- Handle
  ems_VAV_WITH_REHEAT_OptimumStartProg0,  !- Name
  IF DaylightSavings==0 && DayOfWeek>1 && Hour==5 && {1c4300f7-f9ba-4187-8668-5895c33f15dd}<23.9 && {1c4300f7-f9ba-4187-8668-5895c33f15dd}>1.7, !- Program Line 1
