  {218865e6-d76c-46c5-b86f-2b8948a9dd17}, !- Handle
  ems_VAV_WITH_REHEAT_OptimumStartProg0,  !- Name
  IF DaylightSavings==0 && DayOfWeek>1 && Hour==5 && {dc4a72ec-078e-45a9-91a9-8182e0909cc7}<23.9 && {dc4a72ec-078e-45a9-91a9-8182e0909cc7}>1.7, !- Program Line 1
  SET {cc9816af-efe5-435e-b2c6-d5589b6d33c0} = 29.4, !- Program Line 2
  SET {f26d89c1-d9b7-4a47-9811-f91ff5cbd189} = 15.6, !- Program Line 3
  ELSEIF DaylightSavings==0 && DayOfWeek==1 && Hour==7 && {dc4a72ec-078e-45a9-91a9-8182e0909cc7}<23.9 && {dc4a72ec-078e-45a9-91a9-8182e0909cc7}>1.7, !- Program Line 4
  SET {cc9816af-efe5-435e-b2c6-d5589b6d33c0} = 29.4, !- Program Line 5
  SET {f26d89c1-d9b7-4a47-9811-f91ff5cbd189} = 15.6, !- Program Line 6
  ELSEIF DaylightSavings==1 && DayOfWeek>1 && Hour==4 && {dc4a72ec-078e-45a9-91a9-8182e0909cc7}<23.9 && {dc4a72ec-078e-45a9-91a9-8182e0909cc7}>1.7, !- Program Line 7
  SET {cc9816af-efe5-435e-b2c6-d5589b6d33c0} = 29.4, !- Program Line 8
  SET {f26d89c1-d9b7-4a47-9811-f91ff5cbd189} = 15.6, !- Program Line 9
  ELSEIF DaylightSavings==1 && DayOfWeek==1 && Hour==6 && {dc4a72ec-078e-45a9-91a9-8182e0909cc7}<23.9 && {dc4a72ec-078e-45a9-91a9-8182e0909cc7}>1.7, !- Program Line 10
  SET {cc9816af-efe5-435e-b2c6-d5589b6d33c0} = 29.4, !- Program Line 11
  SET {f26d89c1-d9b7-4a47-9811-f91ff5cbd189} = 15.6, !- Program Line 12
  ELSE,                                   !- Program Line 13
  SET {cc9816af-efe5-435e-b2c6-d5589b6d33c0} = NULL, !- Program Line 14
  SET {f26d89c1-d9b7-4a47-9811-f91ff5cbd189} = NULL, !- Program Line 15
  ENDIF;                                  !- Program Line 16

