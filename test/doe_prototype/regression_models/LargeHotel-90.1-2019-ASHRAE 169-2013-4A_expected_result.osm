  {2d5b5667-e977-48f3-97f5-265c1079496c}, !- Handle
  ems_VAV_WITH_REHEAT_OptimumStartProg0,  !- Name
  IF DaylightSavings==0 && DayOfWeek>1 && Hour==5 && {6b43711f-a018-439a-8c63-afdfc40e5fa4}<23.9 && {6b43711f-a018-439a-8c63-afdfc40e5fa4}>1.7, !- Program Line 1
  SET {cbf2b9e7-dcac-4bd8-ada2-57f5ce88ad49} = 29.4, !- Program Line 2
  SET {2307ea12-df82-41ce-858b-b383728e445b} = 15.6, !- Program Line 3
  ELSEIF DaylightSavings==0 && DayOfWeek==1 && Hour==7 && {6b43711f-a018-439a-8c63-afdfc40e5fa4}<23.9 && {6b43711f-a018-439a-8c63-afdfc40e5fa4}>1.7, !- Program Line 4
  SET {cbf2b9e7-dcac-4bd8-ada2-57f5ce88ad49} = 29.4, !- Program Line 5
  SET {2307ea12-df82-41ce-858b-b383728e445b} = 15.6, !- Program Line 6
  ELSEIF DaylightSavings==1 && DayOfWeek>1 && Hour==4 && {6b43711f-a018-439a-8c63-afdfc40e5fa4}<23.9 && {6b43711f-a018-439a-8c63-afdfc40e5fa4}>1.7, !- Program Line 7
  SET {cbf2b9e7-dcac-4bd8-ada2-57f5ce88ad49} = 29.4, !- Program Line 8
  SET {2307ea12-df82-41ce-858b-b383728e445b} = 15.6, !- Program Line 9
  ELSEIF DaylightSavings==1 && DayOfWeek==1 && Hour==6 && {6b43711f-a018-439a-8c63-afdfc40e5fa4}<23.9 && {6b43711f-a018-439a-8c63-afdfc40e5fa4}>1.7, !- Program Line 10
  SET {cbf2b9e7-dcac-4bd8-ada2-57f5ce88ad49} = 29.4, !- Program Line 11
  SET {2307ea12-df82-41ce-858b-b383728e445b} = 15.6, !- Program Line 12
  ELSE,                                   !- Program Line 13
  SET {cbf2b9e7-dcac-4bd8-ada2-57f5ce88ad49} = NULL, !- Program Line 14
  SET {2307ea12-df82-41ce-858b-b383728e445b} = NULL, !- Program Line 15
  ENDIF;                                  !- Program Line 16

