  {db0bb5ac-abe2-4cea-aa10-4cb25c6baabb}, !- Handle
  ems_VAV_WITH_REHEAT_OptimumStartProg0,  !- Name
  IF DaylightSavings==0 && DayOfWeek>1 && Hour==5 && {ccc5ce11-1595-4a30-9f83-9ec72975f509}<23.9 && {ccc5ce11-1595-4a30-9f83-9ec72975f509}>1.7, !- Program Line 1
  SET {3337a232-1d62-4645-aa0d-e55d74b6689d} = 29.4, !- Program Line 2
  SET {30fef1ed-9e4e-450d-9b54-2f329c3c19b2} = 15.6, !- Program Line 3
  ELSEIF DaylightSavings==0 && DayOfWeek==1 && Hour==7 && {ccc5ce11-1595-4a30-9f83-9ec72975f509}<23.9 && {ccc5ce11-1595-4a30-9f83-9ec72975f509}>1.7, !- Program Line 4
  SET {3337a232-1d62-4645-aa0d-e55d74b6689d} = 29.4, !- Program Line 5
  SET {30fef1ed-9e4e-450d-9b54-2f329c3c19b2} = 15.6, !- Program Line 6
  ELSEIF DaylightSavings==1 && DayOfWeek>1 && Hour==4 && {ccc5ce11-1595-4a30-9f83-9ec72975f509}<23.9 && {ccc5ce11-1595-4a30-9f83-9ec72975f509}>1.7, !- Program Line 7
  SET {3337a232-1d62-4645-aa0d-e55d74b6689d} = 29.4, !- Program Line 8
  SET {30fef1ed-9e4e-450d-9b54-2f329c3c19b2} = 15.6, !- Program Line 9
  ELSEIF DaylightSavings==1 && DayOfWeek==1 && Hour==6 && {ccc5ce11-1595-4a30-9f83-9ec72975f509}<23.9 && {ccc5ce11-1595-4a30-9f83-9ec72975f509}>1.7, !- Program Line 10
  SET {3337a232-1d62-4645-aa0d-e55d74b6689d} = 29.4, !- Program Line 11
  SET {30fef1ed-9e4e-450d-9b54-2f329c3c19b2} = 15.6, !- Program Line 12
  ELSE,                                   !- Program Line 13
  SET {3337a232-1d62-4645-aa0d-e55d74b6689d} = NULL, !- Program Line 14
  SET {30fef1ed-9e4e-450d-9b54-2f329c3c19b2} = NULL, !- Program Line 15
  ENDIF;                                  !- Program Line 16

