  {84bc1289-5a9d-4b3c-8115-2d3b5f98bced}, !- Handle
  ems_VAV_WITH_REHEAT_OptimumStartProg0,  !- Name
  IF DaylightSavings==0 && DayOfWeek>1 && Hour==5 && {ade4ae02-c8ea-4666-a776-6cbf06db743b}<23.9 && {ade4ae02-c8ea-4666-a776-6cbf06db743b}>1.7, !- Program Line 1
  SET {d1a1d268-4661-479b-a243-bef418bd82ed} = 29.4, !- Program Line 2
  SET {190732fe-b5aa-4343-ab7e-9134db19044a} = 15.6, !- Program Line 3
  ELSEIF DaylightSavings==0 && DayOfWeek==1 && Hour==7 && {ade4ae02-c8ea-4666-a776-6cbf06db743b}<23.9 && {ade4ae02-c8ea-4666-a776-6cbf06db743b}>1.7, !- Program Line 4
  SET {d1a1d268-4661-479b-a243-bef418bd82ed} = 29.4, !- Program Line 5
  SET {190732fe-b5aa-4343-ab7e-9134db19044a} = 15.6, !- Program Line 6
  ELSEIF DaylightSavings==1 && DayOfWeek>1 && Hour==4 && {ade4ae02-c8ea-4666-a776-6cbf06db743b}<23.9 && {ade4ae02-c8ea-4666-a776-6cbf06db743b}>1.7, !- Program Line 7
  SET {d1a1d268-4661-479b-a243-bef418bd82ed} = 29.4, !- Program Line 8
  SET {190732fe-b5aa-4343-ab7e-9134db19044a} = 15.6, !- Program Line 9
  ELSEIF DaylightSavings==1 && DayOfWeek==1 && Hour==6 && {ade4ae02-c8ea-4666-a776-6cbf06db743b}<23.9 && {ade4ae02-c8ea-4666-a776-6cbf06db743b}>1.7, !- Program Line 10
  SET {d1a1d268-4661-479b-a243-bef418bd82ed} = 29.4, !- Program Line 11
  SET {190732fe-b5aa-4343-ab7e-9134db19044a} = 15.6, !- Program Line 12
  ELSE,                                   !- Program Line 13
  SET {d1a1d268-4661-479b-a243-bef418bd82ed} = NULL, !- Program Line 14
  SET {190732fe-b5aa-4343-ab7e-9134db19044a} = NULL, !- Program Line 15
  ENDIF;                                  !- Program Line 16

