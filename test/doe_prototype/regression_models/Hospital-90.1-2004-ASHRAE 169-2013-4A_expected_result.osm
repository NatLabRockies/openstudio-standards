OS:EnergyManagementSystem:Program,
  {69fe9169-0346-45b0-9101-068049274d70}, !- Handle
  ems_CAV_KITCHEN_OptimumStartProg0,      !- Name
  IF DaylightSavings==0 && DayOfWeek>1 && Hour==5 && {5ed1ac1a-b919-4d9d-b33e-159e81eaecf0}<23.9 && {5ed1ac1a-b919-4d9d-b33e-159e81eaecf0}>1.7, !- Program Line 1
  SET {b28f2b6b-e20c-4501-bfcb-dfacf68db33e} = 29.4, !- Program Line 2
  SET {38998f6a-6dfa-452c-8aa4-dace62c5d2e6} = 15.6, !- Program Line 3
  ELSEIF DaylightSavings==0 && DayOfWeek==1 && Hour==7 && {5ed1ac1a-b919-4d9d-b33e-159e81eaecf0}<23.9 && {5ed1ac1a-b919-4d9d-b33e-159e81eaecf0}>1.7, !- Program Line 4
