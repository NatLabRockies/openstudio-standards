OS:EnergyManagementSystem:Program,
  {062420a8-d855-46b3-bf44-43fe09062734}, !- Handle
  SET_ems_Core_bottom_Light_EMS_Program,  !- Name
  SET ems_Core_bottom_LSr_IP=0.093*ems_Core_bottom_LSr/983.5365718200001, !- Program Line 1
  IF (Business_Sensor <= 0) && (ems_Core_bottom_LSr_IP >= 0.02), !- Program Line 2
