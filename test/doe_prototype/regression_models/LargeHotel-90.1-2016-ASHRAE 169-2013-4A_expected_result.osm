OS:EnergyManagementSystem:Program,
  {17317b59-dc27-43ed-b508-ac9c3b3dd1ba}, !- Handle
  ems_VAV_WITH_REHEAT_OptimumStartProg0,  !- Name
  IF DaylightSavings==0 && DayOfWeek>1 && Hour==5 && {3dce23d3-b69b-464e-a248-0377d2a5e2d8}<23.9 && {3dce23d3-b69b-464e-a248-0377d2a5e2d8}>1.7, !- Program Line 1
  SET {4d35ded3-2041-40cf-b804-b86a59f7e3c4} = 29.4, !- Program Line 2
  SET {35fcc212-f8ca-491f-b535-47513755a3c0} = 15.6, !- Program Line 3
  ELSEIF DaylightSavings==0 && DayOfWeek==1 && Hour==7 && {3dce23d3-b69b-464e-a248-0377d2a5e2d8}<23.9 && {3dce23d3-b69b-464e-a248-0377d2a5e2d8}>1.7, !- Program Line 4
  SET {4d35ded3-2041-40cf-b804-b86a59f7e3c4} = 29.4, !- Program Line 5
  SET {35fcc212-f8ca-491f-b535-47513755a3c0} = 15.6, !- Program Line 6
  ELSEIF DaylightSavings==1 && DayOfWeek>1 && Hour==4 && {3dce23d3-b69b-464e-a248-0377d2a5e2d8}<23.9 && {3dce23d3-b69b-464e-a248-0377d2a5e2d8}>1.7, !- Program Line 7
  SET {4d35ded3-2041-40cf-b804-b86a59f7e3c4} = 29.4, !- Program Line 8
  SET {35fcc212-f8ca-491f-b535-47513755a3c0} = 15.6, !- Program Line 9
  ELSEIF DaylightSavings==1 && DayOfWeek==1 && Hour==6 && {3dce23d3-b69b-464e-a248-0377d2a5e2d8}<23.9 && {3dce23d3-b69b-464e-a248-0377d2a5e2d8}>1.7, !- Program Line 10
  SET {4d35ded3-2041-40cf-b804-b86a59f7e3c4} = 29.4, !- Program Line 11
  SET {35fcc212-f8ca-491f-b535-47513755a3c0} = 15.6, !- Program Line 12
  ELSE,                                   !- Program Line 13
  SET {4d35ded3-2041-40cf-b804-b86a59f7e3c4} = NULL, !- Program Line 14
  SET {35fcc212-f8ca-491f-b535-47513755a3c0} = NULL, !- Program Line 15
  ENDIF;                                  !- Program Line 16

