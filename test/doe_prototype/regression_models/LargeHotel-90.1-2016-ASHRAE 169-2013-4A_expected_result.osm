OS:EnergyManagementSystem:Program,
  {6e0824eb-3217-4c7c-a780-2f5041e83f1d}, !- Handle
  ems_VAV_WITH_REHEAT_OptimumStartProg0,  !- Name
  IF DaylightSavings==0 && DayOfWeek>1 && Hour==5 && {eb38c5ea-ae67-4099-aa51-385b9f5a8b55}<23.9 && {eb38c5ea-ae67-4099-aa51-385b9f5a8b55}>1.7, !- Program Line 1
  SET {c51a7b68-13bf-4c6e-b9bb-8d1dd51846c5} = 29.4, !- Program Line 2
  SET {734a4b04-52ea-4ff9-8a71-572248d1c120} = 15.6, !- Program Line 3
  ELSEIF DaylightSavings==0 && DayOfWeek==1 && Hour==7 && {eb38c5ea-ae67-4099-aa51-385b9f5a8b55}<23.9 && {eb38c5ea-ae67-4099-aa51-385b9f5a8b55}>1.7, !- Program Line 4
  SET {c51a7b68-13bf-4c6e-b9bb-8d1dd51846c5} = 29.4, !- Program Line 5
  SET {734a4b04-52ea-4ff9-8a71-572248d1c120} = 15.6, !- Program Line 6
  ELSEIF DaylightSavings==1 && DayOfWeek>1 && Hour==4 && {eb38c5ea-ae67-4099-aa51-385b9f5a8b55}<23.9 && {eb38c5ea-ae67-4099-aa51-385b9f5a8b55}>1.7, !- Program Line 7
  SET {c51a7b68-13bf-4c6e-b9bb-8d1dd51846c5} = 29.4, !- Program Line 8
  SET {734a4b04-52ea-4ff9-8a71-572248d1c120} = 15.6, !- Program Line 9
  ELSEIF DaylightSavings==1 && DayOfWeek==1 && Hour==6 && {eb38c5ea-ae67-4099-aa51-385b9f5a8b55}<23.9 && {eb38c5ea-ae67-4099-aa51-385b9f5a8b55}>1.7, !- Program Line 10
  SET {c51a7b68-13bf-4c6e-b9bb-8d1dd51846c5} = 29.4, !- Program Line 11
  SET {734a4b04-52ea-4ff9-8a71-572248d1c120} = 15.6, !- Program Line 12
  ELSE,                                   !- Program Line 13
  SET {c51a7b68-13bf-4c6e-b9bb-8d1dd51846c5} = NULL, !- Program Line 14
  SET {734a4b04-52ea-4ff9-8a71-572248d1c120} = NULL, !- Program Line 15
  ENDIF;                                  !- Program Line 16

