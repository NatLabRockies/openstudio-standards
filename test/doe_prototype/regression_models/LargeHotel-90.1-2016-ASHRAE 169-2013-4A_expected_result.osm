OS:EnergyManagementSystem:Program,
  {95453c58-5d9b-4446-bac4-39229127d194}, !- Handle
  ems_VAV_WITH_REHEAT_OptimumStartProg0,  !- Name
  IF DaylightSavings==0 && DayOfWeek>1 && Hour==5 && {251d36d4-ed6c-4b94-a760-5ba5542b831d}<23.9 && {251d36d4-ed6c-4b94-a760-5ba5542b831d}>1.7, !- Program Line 1
  SET {b58cbadc-9a53-4976-be75-ec5bc5354196} = 29.4, !- Program Line 2
  SET {86c7fabb-c662-4c62-bd9f-1a150c5a4caa} = 15.6, !- Program Line 3
  ELSEIF DaylightSavings==0 && DayOfWeek==1 && Hour==7 && {251d36d4-ed6c-4b94-a760-5ba5542b831d}<23.9 && {251d36d4-ed6c-4b94-a760-5ba5542b831d}>1.7, !- Program Line 4
