OS:EnergyManagementSystem:Program,
  {ea80b7cf-c768-4689-a6e7-4b6e29b9725c}, !- Handle
  ems_VAV_WITH_REHEAT_OptimumStartProg0,  !- Name
  IF DaylightSavings==0 && DayOfWeek>1 && Hour==5 && {b91c0381-3bb0-4b5d-9e10-55d7346c95bf}<23.9 && {b91c0381-3bb0-4b5d-9e10-55d7346c95bf}>1.7, !- Program Line 1
  SET {fd7490d8-9ae9-4057-84bc-00fb1bf30b9f} = 29.4, !- Program Line 2
  SET {55e58886-6c20-4ee1-ab24-7d280d8f3cb3} = 15.6, !- Program Line 3
  ELSEIF DaylightSavings==0 && DayOfWeek==1 && Hour==7 && {b91c0381-3bb0-4b5d-9e10-55d7346c95bf}<23.9 && {b91c0381-3bb0-4b5d-9e10-55d7346c95bf}>1.7, !- Program Line 4
  SET {fd7490d8-9ae9-4057-84bc-00fb1bf30b9f} = 29.4, !- Program Line 5
  SET {55e58886-6c20-4ee1-ab24-7d280d8f3cb3} = 15.6, !- Program Line 6
  ELSEIF DaylightSavings==1 && DayOfWeek>1 && Hour==4 && {b91c0381-3bb0-4b5d-9e10-55d7346c95bf}<23.9 && {b91c0381-3bb0-4b5d-9e10-55d7346c95bf}>1.7, !- Program Line 7
