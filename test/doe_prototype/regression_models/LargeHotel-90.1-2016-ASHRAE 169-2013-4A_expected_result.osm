OS:EnergyManagementSystem:Program,
  {72c18175-b6b5-4deb-a169-443ff61489cb}, !- Handle
  ems_VAV_WITH_REHEAT_OptimumStartProg0,  !- Name
  IF DaylightSavings==0 && DayOfWeek>1 && Hour==5 && {a9810bc5-e68e-45bb-9afb-d79c1cca0d06}<23.9 && {a9810bc5-e68e-45bb-9afb-d79c1cca0d06}>1.7, !- Program Line 1
  SET {12f6fa97-375e-41ab-af65-60e7c0b4bf2e} = 29.4, !- Program Line 2
  SET {81a4e66a-7650-4e6f-b082-fbe7d65179b8} = 15.6, !- Program Line 3
  ELSEIF DaylightSavings==0 && DayOfWeek==1 && Hour==7 && {a9810bc5-e68e-45bb-9afb-d79c1cca0d06}<23.9 && {a9810bc5-e68e-45bb-9afb-d79c1cca0d06}>1.7, !- Program Line 4
  SET {12f6fa97-375e-41ab-af65-60e7c0b4bf2e} = 29.4, !- Program Line 5
  SET {81a4e66a-7650-4e6f-b082-fbe7d65179b8} = 15.6, !- Program Line 6
  ELSEIF DaylightSavings==1 && DayOfWeek>1 && Hour==4 && {a9810bc5-e68e-45bb-9afb-d79c1cca0d06}<23.9 && {a9810bc5-e68e-45bb-9afb-d79c1cca0d06}>1.7, !- Program Line 7
  SET {12f6fa97-375e-41ab-af65-60e7c0b4bf2e} = 29.4, !- Program Line 8
  SET {81a4e66a-7650-4e6f-b082-fbe7d65179b8} = 15.6, !- Program Line 9
  ELSEIF DaylightSavings==1 && DayOfWeek==1 && Hour==6 && {a9810bc5-e68e-45bb-9afb-d79c1cca0d06}<23.9 && {a9810bc5-e68e-45bb-9afb-d79c1cca0d06}>1.7, !- Program Line 10
  SET {12f6fa97-375e-41ab-af65-60e7c0b4bf2e} = 29.4, !- Program Line 11
  SET {81a4e66a-7650-4e6f-b082-fbe7d65179b8} = 15.6, !- Program Line 12
  ELSE,                                   !- Program Line 13
  SET {12f6fa97-375e-41ab-af65-60e7c0b4bf2e} = NULL, !- Program Line 14
  SET {81a4e66a-7650-4e6f-b082-fbe7d65179b8} = NULL, !- Program Line 15
  ENDIF;                                  !- Program Line 16

