OS:EnergyManagementSystem:Program,
  {d9e7351f-7f66-4b17-a8cf-3e487a59fa12}, !- Handle
  ems_Core_Retail_ZN_PSZ_AC_OptimumStartProg0, !- Name
  IF DaylightSavings==0 && DayOfWeek>1 && Hour==5 && {cfa8a8ed-e837-4a00-bbc8-e4257bd42d12}<23.9 && {cfa8a8ed-e837-4a00-bbc8-e4257bd42d12}>1.7, !- Program Line 1
  SET {fb9e0dff-fa88-4edc-963d-7a5c260dfff3} = 29.4, !- Program Line 2
  SET {831210bb-a118-446a-ab16-9093e946958d} = 15.6, !- Program Line 3
  ELSEIF DaylightSavings==0 && DayOfWeek==1 && Hour==7 && {cfa8a8ed-e837-4a00-bbc8-e4257bd42d12}<23.9 && {cfa8a8ed-e837-4a00-bbc8-e4257bd42d12}>1.7, !- Program Line 4
  SET {fb9e0dff-fa88-4edc-963d-7a5c260dfff3} = 29.4, !- Program Line 5
  SET {831210bb-a118-446a-ab16-9093e946958d} = 15.6, !- Program Line 6
  ELSEIF DaylightSavings==1 && DayOfWeek>1 && Hour==4 && {cfa8a8ed-e837-4a00-bbc8-e4257bd42d12}<23.9 && {cfa8a8ed-e837-4a00-bbc8-e4257bd42d12}>1.7, !- Program Line 7
  SET {fb9e0dff-fa88-4edc-963d-7a5c260dfff3} = 29.4, !- Program Line 8
  SET {831210bb-a118-446a-ab16-9093e946958d} = 15.6, !- Program Line 9
  ELSEIF DaylightSavings==1 && DayOfWeek==1 && Hour==6 && {cfa8a8ed-e837-4a00-bbc8-e4257bd42d12}<23.9 && {cfa8a8ed-e837-4a00-bbc8-e4257bd42d12}>1.7, !- Program Line 10
  SET {fb9e0dff-fa88-4edc-963d-7a5c260dfff3} = 29.4, !- Program Line 11
  SET {831210bb-a118-446a-ab16-9093e946958d} = 15.6, !- Program Line 12
  ELSE,                                   !- Program Line 13
  SET {fb9e0dff-fa88-4edc-963d-7a5c260dfff3} = NULL, !- Program Line 14
  SET {831210bb-a118-446a-ab16-9093e946958d} = NULL, !- Program Line 15
  ENDIF;                                  !- Program Line 16

