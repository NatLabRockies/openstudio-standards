  ELSEIF DaylightSavings==1 && DayOfWeek==1 && Hour==6 && {ea52d36a-030d-4287-9ec0-48c4a34d36be}<23.9 && {ea52d36a-030d-4287-9ec0-48c4a34d36be}>1.7, !- Program Line 10
