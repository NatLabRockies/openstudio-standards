  {5b13631e-9f3f-4b58-bcfc-a255b87e1869}, !- Handle
  ems_Core_Retail_ZN_PSZ_AC_OptimumStartProg0, !- Name
  IF DaylightSavings==0 && DayOfWeek>1 && Hour==5 && {a3963a25-a4f8-4c04-aef9-51657e581898}<23.9 && {a3963a25-a4f8-4c04-aef9-51657e581898}>1.7, !- Program Line 1
  SET {c9a0d3b8-b4ac-4946-93c0-f2d4db792562} = 29.4, !- Program Line 2
  SET {b1a6f1e1-f938-4b1e-a5f3-0edef34a4604} = 15.6, !- Program Line 3
  ELSEIF DaylightSavings==0 && DayOfWeek==1 && Hour==7 && {a3963a25-a4f8-4c04-aef9-51657e581898}<23.9 && {a3963a25-a4f8-4c04-aef9-51657e581898}>1.7, !- Program Line 4
  SET {c9a0d3b8-b4ac-4946-93c0-f2d4db792562} = 29.4, !- Program Line 5
  SET {b1a6f1e1-f938-4b1e-a5f3-0edef34a4604} = 15.6, !- Program Line 6
  ELSEIF DaylightSavings==1 && DayOfWeek>1 && Hour==4 && {a3963a25-a4f8-4c04-aef9-51657e581898}<23.9 && {a3963a25-a4f8-4c04-aef9-51657e581898}>1.7, !- Program Line 7
  SET {c9a0d3b8-b4ac-4946-93c0-f2d4db792562} = 29.4, !- Program Line 8
  SET {b1a6f1e1-f938-4b1e-a5f3-0edef34a4604} = 15.6, !- Program Line 9
  ELSEIF DaylightSavings==1 && DayOfWeek==1 && Hour==6 && {a3963a25-a4f8-4c04-aef9-51657e581898}<23.9 && {a3963a25-a4f8-4c04-aef9-51657e581898}>1.7, !- Program Line 10
  SET {c9a0d3b8-b4ac-4946-93c0-f2d4db792562} = 29.4, !- Program Line 11
  SET {b1a6f1e1-f938-4b1e-a5f3-0edef34a4604} = 15.6, !- Program Line 12
  ELSE,                                   !- Program Line 13
  SET {c9a0d3b8-b4ac-4946-93c0-f2d4db792562} = NULL, !- Program Line 14
  SET {b1a6f1e1-f938-4b1e-a5f3-0edef34a4604} = NULL, !- Program Line 15
