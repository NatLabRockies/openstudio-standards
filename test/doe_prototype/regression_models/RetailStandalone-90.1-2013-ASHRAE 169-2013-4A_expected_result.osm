  SET {482231a2-aa52-4584-a7bd-630835a7fcb9} = 15.6, !- Program Line 9
  ELSEIF DaylightSavings==1 && DayOfWeek==1 && Hour==6 && {e9476d61-86ec-4c34-b422-79458b7c7bf4}<23.9 && {e9476d61-86ec-4c34-b422-79458b7c7bf4}>1.7, !- Program Line 10
  SET {162f9c58-c69a-4e82-8b88-f0a0557018a4} = 29.4, !- Program Line 11
  SET {482231a2-aa52-4584-a7bd-630835a7fcb9} = 15.6, !- Program Line 12
