  ELSEIF DaylightSavings==1 && DayOfWeek>1 && Hour==4 && {e9476d61-86ec-4c34-b422-79458b7c7bf4}<23.9 && {e9476d61-86ec-4c34-b422-79458b7c7bf4}>1.7, !- Program Line 7
