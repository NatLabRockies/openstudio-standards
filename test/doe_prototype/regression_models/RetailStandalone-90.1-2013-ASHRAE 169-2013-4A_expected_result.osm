  {e20ab11e-d0e4-4110-83ad-b1c1ded327aa}, !- Handle
  ems_Core_Retail_ZN_PSZ_AC_OptimumStartProg0, !- Name
  IF DaylightSavings==0 && DayOfWeek>1 && Hour==5 && {5094750c-a7e3-40ce-bda1-211a173afba4}<23.9 && {5094750c-a7e3-40ce-bda1-211a173afba4}>1.7, !- Program Line 1
  SET {c4060e03-f7fe-4cc0-88cc-5b4b4f4de87d} = 29.4, !- Program Line 2
  SET {06334e0a-5767-4d66-a2c5-3c8dd8bbcbb0} = 15.6, !- Program Line 3
  ELSEIF DaylightSavings==0 && DayOfWeek==1 && Hour==7 && {5094750c-a7e3-40ce-bda1-211a173afba4}<23.9 && {5094750c-a7e3-40ce-bda1-211a173afba4}>1.7, !- Program Line 4
  SET {c4060e03-f7fe-4cc0-88cc-5b4b4f4de87d} = 29.4, !- Program Line 5
  SET {06334e0a-5767-4d66-a2c5-3c8dd8bbcbb0} = 15.6, !- Program Line 6
  ELSEIF DaylightSavings==1 && DayOfWeek>1 && Hour==4 && {5094750c-a7e3-40ce-bda1-211a173afba4}<23.9 && {5094750c-a7e3-40ce-bda1-211a173afba4}>1.7, !- Program Line 7
  SET {c4060e03-f7fe-4cc0-88cc-5b4b4f4de87d} = 29.4, !- Program Line 8
  SET {06334e0a-5767-4d66-a2c5-3c8dd8bbcbb0} = 15.6, !- Program Line 9
  ELSEIF DaylightSavings==1 && DayOfWeek==1 && Hour==6 && {5094750c-a7e3-40ce-bda1-211a173afba4}<23.9 && {5094750c-a7e3-40ce-bda1-211a173afba4}>1.7, !- Program Line 10
  SET {c4060e03-f7fe-4cc0-88cc-5b4b4f4de87d} = 29.4, !- Program Line 11
  SET {06334e0a-5767-4d66-a2c5-3c8dd8bbcbb0} = 15.6, !- Program Line 12
