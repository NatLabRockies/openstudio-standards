OS:EnergyManagementSystem:Program,
  {e5170e40-8a7e-467d-be26-e557ef46db71}, !- Handle
  ems_Core_Retail_ZN_PSZ_AC_OptimumStartProg0, !- Name
  IF DaylightSavings==0 && DayOfWeek>1 && Hour==5 && {ff55612a-4b83-441a-a8f3-05e6964d4728}<23.9 && {ff55612a-4b83-441a-a8f3-05e6964d4728}>1.7, !- Program Line 1
  SET {dd2cb32f-49ad-4008-be4c-1fb2312656bb} = 29.4, !- Program Line 2
