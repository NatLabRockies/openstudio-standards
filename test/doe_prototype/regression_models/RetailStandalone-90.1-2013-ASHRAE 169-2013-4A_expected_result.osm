  SET {7451d463-2795-4494-a4f1-a956c9acbe28} = 15.6, !- Program Line 3
  ELSEIF DaylightSavings==0 && DayOfWeek==1 && Hour==7 && {6aac3d82-0ad5-4fd7-b793-afcc225a7e31}<23.9 && {6aac3d82-0ad5-4fd7-b793-afcc225a7e31}>1.7, !- Program Line 4
  SET {88a6bde9-0ef5-4867-986a-d3ee37196a2f} = 29.4, !- Program Line 5
  SET {7451d463-2795-4494-a4f1-a956c9acbe28} = 15.6, !- Program Line 6
  ELSEIF DaylightSavings==1 && DayOfWeek>1 && Hour==4 && {6aac3d82-0ad5-4fd7-b793-afcc225a7e31}<23.9 && {6aac3d82-0ad5-4fd7-b793-afcc225a7e31}>1.7, !- Program Line 7
  SET {88a6bde9-0ef5-4867-986a-d3ee37196a2f} = 29.4, !- Program Line 8
  SET {7451d463-2795-4494-a4f1-a956c9acbe28} = 15.6, !- Program Line 9
  ELSEIF DaylightSavings==1 && DayOfWeek==1 && Hour==6 && {6aac3d82-0ad5-4fd7-b793-afcc225a7e31}<23.9 && {6aac3d82-0ad5-4fd7-b793-afcc225a7e31}>1.7, !- Program Line 10
  SET {88a6bde9-0ef5-4867-986a-d3ee37196a2f} = 29.4, !- Program Line 11
  SET {7451d463-2795-4494-a4f1-a956c9acbe28} = 15.6, !- Program Line 12
  ELSE,                                   !- Program Line 13
  SET {88a6bde9-0ef5-4867-986a-d3ee37196a2f} = NULL, !- Program Line 14
  SET {7451d463-2795-4494-a4f1-a956c9acbe28} = NULL, !- Program Line 15
