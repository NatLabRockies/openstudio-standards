  SET {88f6a3c8-fcbc-4684-b256-f1d62b7beb98} = 15.6, !- Program Line 3
  ELSEIF DaylightSavings==0 && DayOfWeek==1 && Hour==7 && {778aa277-61c8-43d4-97fe-aa1f41ae6e71}<23.9 && {778aa277-61c8-43d4-97fe-aa1f41ae6e71}>1.7, !- Program Line 4
  SET {ea27291c-f22f-4022-a49e-2a3672a26558} = 29.4, !- Program Line 5
