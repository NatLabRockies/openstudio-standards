  ELSEIF DaylightSavings==0 && DayOfWeek==1 && Hour==7 && {9c398959-f11b-4f21-8945-9718a615f969}<23.9 && {9c398959-f11b-4f21-8945-9718a615f969}>1.7, !- Program Line 4
