  {5a246e0f-ed01-471b-91d8-f04b27a87b93}, !- Handle
  ems_Auditorium_ZN_1_FLR_1_ZN_PSZ_AC_3_7_OptimumStartProg0, !- Name
  IF DaylightSavings==0 && DayOfWeek>1 && Hour==5 && {776b7e70-b3ef-4d80-b8d8-4fd036a0f68a}<23.9 && {776b7e70-b3ef-4d80-b8d8-4fd036a0f68a}>1.7, !- Program Line 1
