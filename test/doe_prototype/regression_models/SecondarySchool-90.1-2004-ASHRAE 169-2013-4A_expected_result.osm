OS:EnergyManagementSystem:Program,
  {b33a7f06-108d-4b0e-ada7-a926759ed35c}, !- Handle
  ems_VAV_POD_3_OptimumStartProg0,        !- Name
  IF DaylightSavings==0 && DayOfWeek>1 && Hour==5 && {531a1f36-e068-45b9-81ad-d43f75c0a3d7}<23.9 && {531a1f36-e068-45b9-81ad-d43f75c0a3d7}>1.7, !- Program Line 1
  SET {76a3acc2-680f-4866-8fdf-62c6782a1de5} = 29.4, !- Program Line 2
  SET {e5454384-a55a-47d3-9d3e-6e8ce7a344e0} = 15.6, !- Program Line 3
  ELSEIF DaylightSavings==0 && DayOfWeek==1 && Hour==7 && {531a1f36-e068-45b9-81ad-d43f75c0a3d7}<23.9 && {531a1f36-e068-45b9-81ad-d43f75c0a3d7}>1.7, !- Program Line 4
  SET {76a3acc2-680f-4866-8fdf-62c6782a1de5} = 29.4, !- Program Line 5
  SET {e5454384-a55a-47d3-9d3e-6e8ce7a344e0} = 15.6, !- Program Line 6
  ELSEIF DaylightSavings==1 && DayOfWeek>1 && Hour==4 && {531a1f36-e068-45b9-81ad-d43f75c0a3d7}<23.9 && {531a1f36-e068-45b9-81ad-d43f75c0a3d7}>1.7, !- Program Line 7
  SET {76a3acc2-680f-4866-8fdf-62c6782a1de5} = 29.4, !- Program Line 8
  SET {e5454384-a55a-47d3-9d3e-6e8ce7a344e0} = 15.6, !- Program Line 9
  ELSEIF DaylightSavings==1 && DayOfWeek==1 && Hour==6 && {531a1f36-e068-45b9-81ad-d43f75c0a3d7}<23.9 && {531a1f36-e068-45b9-81ad-d43f75c0a3d7}>1.7, !- Program Line 10
  SET {76a3acc2-680f-4866-8fdf-62c6782a1de5} = 29.4, !- Program Line 11
  SET {e5454384-a55a-47d3-9d3e-6e8ce7a344e0} = 15.6, !- Program Line 12
  ELSE,                                   !- Program Line 13
  SET {76a3acc2-680f-4866-8fdf-62c6782a1de5} = NULL, !- Program Line 14
  SET {e5454384-a55a-47d3-9d3e-6e8ce7a344e0} = NULL, !- Program Line 15
  ENDIF;                                  !- Program Line 16

