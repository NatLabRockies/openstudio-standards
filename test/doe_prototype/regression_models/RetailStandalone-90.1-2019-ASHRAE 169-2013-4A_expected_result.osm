  ELSEIF DaylightSavings==0 && DayOfWeek==1 && Hour==7 && {3f9a40ba-1b72-4e2c-98bf-fbcaf2316f46}<23.9 && {3f9a40ba-1b72-4e2c-98bf-fbcaf2316f46}>1.7, !- Program Line 4
  SET {88336385-b842-4863-89e6-59c4f36c74cd} = 29.4, !- Program Line 5
  SET {09736c79-71e9-4bd6-8371-9a9c15774c96} = 15.6, !- Program Line 6
  ELSEIF DaylightSavings==1 && DayOfWeek>1 && Hour==4 && {3f9a40ba-1b72-4e2c-98bf-fbcaf2316f46}<23.9 && {3f9a40ba-1b72-4e2c-98bf-fbcaf2316f46}>1.7, !- Program Line 7
  SET {88336385-b842-4863-89e6-59c4f36c74cd} = 29.4, !- Program Line 8
  SET {09736c79-71e9-4bd6-8371-9a9c15774c96} = 15.6, !- Program Line 9
  ELSEIF DaylightSavings==1 && DayOfWeek==1 && Hour==6 && {3f9a40ba-1b72-4e2c-98bf-fbcaf2316f46}<23.9 && {3f9a40ba-1b72-4e2c-98bf-fbcaf2316f46}>1.7, !- Program Line 10
  SET {88336385-b842-4863-89e6-59c4f36c74cd} = 29.4, !- Program Line 11
  SET {09736c79-71e9-4bd6-8371-9a9c15774c96} = 15.6, !- Program Line 12
  ELSE,                                   !- Program Line 13
  SET {88336385-b842-4863-89e6-59c4f36c74cd} = NULL, !- Program Line 14
  SET {09736c79-71e9-4bd6-8371-9a9c15774c96} = NULL, !- Program Line 15
