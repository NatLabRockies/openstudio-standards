OS:EnergyManagementSystem:Program,
  {6126f61b-a3b2-4ec9-9715-de25a33d2dbe}, !- Handle
  ems_Core_Retail_ZN_PSZ_AC_OptimumStartProg0, !- Name
  IF DaylightSavings==0 && DayOfWeek>1 && Hour==5 && {5159a922-c4f5-4d51-a895-08a656edc67b}<23.9 && {5159a922-c4f5-4d51-a895-08a656edc67b}>1.7, !- Program Line 1
  SET {3a5d6aa3-1a1e-408e-89db-401ec2846afe} = 29.4, !- Program Line 2
  SET {0dcf69ed-f944-44b0-b24f-4fd47d8c6616} = 15.6, !- Program Line 3
  ELSEIF DaylightSavings==0 && DayOfWeek==1 && Hour==7 && {5159a922-c4f5-4d51-a895-08a656edc67b}<23.9 && {5159a922-c4f5-4d51-a895-08a656edc67b}>1.7, !- Program Line 4
  SET {3a5d6aa3-1a1e-408e-89db-401ec2846afe} = 29.4, !- Program Line 5
  SET {0dcf69ed-f944-44b0-b24f-4fd47d8c6616} = 15.6, !- Program Line 6
  ELSEIF DaylightSavings==1 && DayOfWeek>1 && Hour==4 && {5159a922-c4f5-4d51-a895-08a656edc67b}<23.9 && {5159a922-c4f5-4d51-a895-08a656edc67b}>1.7, !- Program Line 7
  SET {3a5d6aa3-1a1e-408e-89db-401ec2846afe} = 29.4, !- Program Line 8
  SET {0dcf69ed-f944-44b0-b24f-4fd47d8c6616} = 15.6, !- Program Line 9
  ELSEIF DaylightSavings==1 && DayOfWeek==1 && Hour==6 && {5159a922-c4f5-4d51-a895-08a656edc67b}<23.9 && {5159a922-c4f5-4d51-a895-08a656edc67b}>1.7, !- Program Line 10
  SET {3a5d6aa3-1a1e-408e-89db-401ec2846afe} = 29.4, !- Program Line 11
  SET {0dcf69ed-f944-44b0-b24f-4fd47d8c6616} = 15.6, !- Program Line 12
  ELSE,                                   !- Program Line 13
  SET {3a5d6aa3-1a1e-408e-89db-401ec2846afe} = NULL, !- Program Line 14
  SET {0dcf69ed-f944-44b0-b24f-4fd47d8c6616} = NULL, !- Program Line 15
  ENDIF;                                  !- Program Line 16

