  {0c11f897-48ae-43d8-a749-32981db780a7}, !- Handle
  ems_Core_Retail_ZN_PSZ_AC_OptimumStartProg0, !- Name
  IF DaylightSavings==0 && DayOfWeek>1 && Hour==5 && {3f9a40ba-1b72-4e2c-98bf-fbcaf2316f46}<23.9 && {3f9a40ba-1b72-4e2c-98bf-fbcaf2316f46}>1.7, !- Program Line 1
