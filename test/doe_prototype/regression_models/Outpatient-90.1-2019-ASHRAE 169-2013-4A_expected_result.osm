OS:EnergyManagementSystem:Program,
  {08506777-9cf9-4ee8-9299-d895858b3c1f}, !- Handle
  ems_PVAV_Outpatient_F2_F3_OptimumStartProg2, !- Name
  IF DaylightSavings==0 && DayOfWeek>1 && Hour==5 && {97b8a0ad-1ec4-4b2b-b987-82d0afb4c4b6}<23.9 && {97b8a0ad-1ec4-4b2b-b987-82d0afb4c4b6}>1.7, !- Program Line 1
  SET {71968587-5f8c-48e7-afbf-deee6dfef9a0} = 29.4, !- Program Line 2
  SET {8659b2ae-6aba-464d-a8d5-5da7188b55f1} = 15.6, !- Program Line 3
  ELSEIF DaylightSavings==0 && DayOfWeek==1 && Hour==7 && {97b8a0ad-1ec4-4b2b-b987-82d0afb4c4b6}<23.9 && {97b8a0ad-1ec4-4b2b-b987-82d0afb4c4b6}>1.7, !- Program Line 4
  SET {71968587-5f8c-48e7-afbf-deee6dfef9a0} = 29.4, !- Program Line 5
  SET {8659b2ae-6aba-464d-a8d5-5da7188b55f1} = 15.6, !- Program Line 6
  ELSEIF DaylightSavings==1 && DayOfWeek>1 && Hour==4 && {97b8a0ad-1ec4-4b2b-b987-82d0afb4c4b6}<23.9 && {97b8a0ad-1ec4-4b2b-b987-82d0afb4c4b6}>1.7, !- Program Line 7
  SET {71968587-5f8c-48e7-afbf-deee6dfef9a0} = 29.4, !- Program Line 8
  SET {8659b2ae-6aba-464d-a8d5-5da7188b55f1} = 15.6, !- Program Line 9
  ELSEIF DaylightSavings==1 && DayOfWeek==1 && Hour==6 && {97b8a0ad-1ec4-4b2b-b987-82d0afb4c4b6}<23.9 && {97b8a0ad-1ec4-4b2b-b987-82d0afb4c4b6}>1.7, !- Program Line 10
  SET {71968587-5f8c-48e7-afbf-deee6dfef9a0} = 29.4, !- Program Line 11
  SET {8659b2ae-6aba-464d-a8d5-5da7188b55f1} = 15.6, !- Program Line 12
  ELSE,                                   !- Program Line 13
  SET {71968587-5f8c-48e7-afbf-deee6dfef9a0} = NULL, !- Program Line 14
  SET {8659b2ae-6aba-464d-a8d5-5da7188b55f1} = NULL, !- Program Line 15
  ENDIF;                                  !- Program Line 16

