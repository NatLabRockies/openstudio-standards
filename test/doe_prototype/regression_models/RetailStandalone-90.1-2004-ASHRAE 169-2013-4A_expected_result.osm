OS:EnergyManagementSystem:Program,
  {fbf093cd-1b53-469b-b562-7eaac8b18721}, !- Handle
  ems_Core_Retail_ZN_PSZ_AC_OptimumStartProg0, !- Name
  IF DaylightSavings==0 && DayOfWeek>1 && Hour==5 && {f256c7fc-70f1-4d00-a4d2-90bfd6010952}<23.9 && {f256c7fc-70f1-4d00-a4d2-90bfd6010952}>1.7, !- Program Line 1
  SET {2f4190a0-2c2b-4ca7-b83a-32e4b12e44e0} = 29.4, !- Program Line 2
  SET {d619fc6c-eb07-4f73-9ff9-87365e6cb5af} = 15.6, !- Program Line 3
  ELSEIF DaylightSavings==0 && DayOfWeek==1 && Hour==7 && {f256c7fc-70f1-4d00-a4d2-90bfd6010952}<23.9 && {f256c7fc-70f1-4d00-a4d2-90bfd6010952}>1.7, !- Program Line 4
  SET {2f4190a0-2c2b-4ca7-b83a-32e4b12e44e0} = 29.4, !- Program Line 5
  SET {d619fc6c-eb07-4f73-9ff9-87365e6cb5af} = 15.6, !- Program Line 6
  ELSEIF DaylightSavings==1 && DayOfWeek>1 && Hour==4 && {f256c7fc-70f1-4d00-a4d2-90bfd6010952}<23.9 && {f256c7fc-70f1-4d00-a4d2-90bfd6010952}>1.7, !- Program Line 7
  SET {2f4190a0-2c2b-4ca7-b83a-32e4b12e44e0} = 29.4, !- Program Line 8
  SET {d619fc6c-eb07-4f73-9ff9-87365e6cb5af} = 15.6, !- Program Line 9
  ELSEIF DaylightSavings==1 && DayOfWeek==1 && Hour==6 && {f256c7fc-70f1-4d00-a4d2-90bfd6010952}<23.9 && {f256c7fc-70f1-4d00-a4d2-90bfd6010952}>1.7, !- Program Line 10
  SET {2f4190a0-2c2b-4ca7-b83a-32e4b12e44e0} = 29.4, !- Program Line 11
  SET {d619fc6c-eb07-4f73-9ff9-87365e6cb5af} = 15.6, !- Program Line 12
  ELSE,                                   !- Program Line 13
  SET {2f4190a0-2c2b-4ca7-b83a-32e4b12e44e0} = NULL, !- Program Line 14
  SET {d619fc6c-eb07-4f73-9ff9-87365e6cb5af} = NULL, !- Program Line 15
  ENDIF;                                  !- Program Line 16

