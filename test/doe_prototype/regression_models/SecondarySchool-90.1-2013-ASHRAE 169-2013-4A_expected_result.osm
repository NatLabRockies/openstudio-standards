  ELSEIF DaylightSavings==1 && DayOfWeek>1 && Hour==4 && {ed7a2544-de8c-437a-a8b7-d7835b5dff9c}<23.9 && {ed7a2544-de8c-437a-a8b7-d7835b5dff9c}>1.7, !- Program Line 7
  SET {aa383e08-069f-4e51-9683-fc2d0baebdc7} = 29.4, !- Program Line 8
  SET {598bdef0-8d5c-452d-90c3-f926886a899b} = 15.6, !- Program Line 9
  ELSEIF DaylightSavings==1 && DayOfWeek==1 && Hour==6 && {ed7a2544-de8c-437a-a8b7-d7835b5dff9c}<23.9 && {ed7a2544-de8c-437a-a8b7-d7835b5dff9c}>1.7, !- Program Line 10
