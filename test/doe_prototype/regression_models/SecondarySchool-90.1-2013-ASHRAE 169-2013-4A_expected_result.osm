  ELSEIF DaylightSavings==1 && DayOfWeek>1 && Hour==4 && {ea8d324d-91ba-4a32-9445-78f9c3a9f36d}<23.9 && {ea8d324d-91ba-4a32-9445-78f9c3a9f36d}>1.7, !- Program Line 7
