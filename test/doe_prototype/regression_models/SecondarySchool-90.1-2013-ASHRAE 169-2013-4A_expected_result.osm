  ELSEIF DaylightSavings==0 && DayOfWeek==1 && Hour==7 && {ed7a2544-de8c-437a-a8b7-d7835b5dff9c}<23.9 && {ed7a2544-de8c-437a-a8b7-d7835b5dff9c}>1.7, !- Program Line 4
