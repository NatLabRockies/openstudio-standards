  ems_VAV_POD_3_OptimumStartProg0,        !- Name
  IF DaylightSavings==0 && DayOfWeek>1 && Hour==5 && {ee71d573-b1d6-41b0-b315-39ce29a0975f}<23.9 && {ee71d573-b1d6-41b0-b315-39ce29a0975f}>1.7, !- Program Line 1
