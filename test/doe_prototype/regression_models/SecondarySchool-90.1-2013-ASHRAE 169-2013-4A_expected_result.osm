OS:EnergyManagementSystem:Program,
  {f89e22af-a5d2-4468-9989-38f0e78ba0e0}, !- Handle
  ems_VAV_POD_1_OptimumStartProg0,        !- Name
  IF DaylightSavings==0 && DayOfWeek>1 && Hour==5 && {63ef5e49-e960-44ea-86b2-c0add36fb569}<23.9 && {63ef5e49-e960-44ea-86b2-c0add36fb569}>1.7, !- Program Line 1
  SET {b55ef8a7-610b-4b2f-bcbb-5ac750adc09c} = 29.4, !- Program Line 2
  SET {6db5062e-79a0-4d5a-bd2e-9d543f07eacb} = 15.6, !- Program Line 3
  ELSEIF DaylightSavings==0 && DayOfWeek==1 && Hour==7 && {63ef5e49-e960-44ea-86b2-c0add36fb569}<23.9 && {63ef5e49-e960-44ea-86b2-c0add36fb569}>1.7, !- Program Line 4
  SET {b55ef8a7-610b-4b2f-bcbb-5ac750adc09c} = 29.4, !- Program Line 5
  SET {6db5062e-79a0-4d5a-bd2e-9d543f07eacb} = 15.6, !- Program Line 6
  ELSEIF DaylightSavings==1 && DayOfWeek>1 && Hour==4 && {63ef5e49-e960-44ea-86b2-c0add36fb569}<23.9 && {63ef5e49-e960-44ea-86b2-c0add36fb569}>1.7, !- Program Line 7
  SET {b55ef8a7-610b-4b2f-bcbb-5ac750adc09c} = 29.4, !- Program Line 8
  SET {6db5062e-79a0-4d5a-bd2e-9d543f07eacb} = 15.6, !- Program Line 9
  ELSEIF DaylightSavings==1 && DayOfWeek==1 && Hour==6 && {63ef5e49-e960-44ea-86b2-c0add36fb569}<23.9 && {63ef5e49-e960-44ea-86b2-c0add36fb569}>1.7, !- Program Line 10
  SET {b55ef8a7-610b-4b2f-bcbb-5ac750adc09c} = 29.4, !- Program Line 11
  SET {6db5062e-79a0-4d5a-bd2e-9d543f07eacb} = 15.6, !- Program Line 12
  ELSE,                                   !- Program Line 13
  SET {b55ef8a7-610b-4b2f-bcbb-5ac750adc09c} = NULL, !- Program Line 14
  SET {6db5062e-79a0-4d5a-bd2e-9d543f07eacb} = NULL, !- Program Line 15
  ENDIF;                                  !- Program Line 16

