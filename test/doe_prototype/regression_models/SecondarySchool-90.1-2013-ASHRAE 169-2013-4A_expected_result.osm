OS:EnergyManagementSystem:Program,
  {a3c2ea74-ffa9-4c78-8883-426fc2ff8055}, !- Handle
  ems_VAV_POD_3_OptimumStartProg0,        !- Name
  IF DaylightSavings==0 && DayOfWeek>1 && Hour==5 && {5edb7b51-f7d8-4cd1-bcd5-34b5bf7a2394}<23.9 && {5edb7b51-f7d8-4cd1-bcd5-34b5bf7a2394}>1.7, !- Program Line 1
  SET {64f22a21-1799-421c-8b76-07538517b882} = 29.4, !- Program Line 2
  SET {928fbd01-94f7-42e6-8351-79e14bd159f7} = 15.6, !- Program Line 3
  ELSEIF DaylightSavings==0 && DayOfWeek==1 && Hour==7 && {5edb7b51-f7d8-4cd1-bcd5-34b5bf7a2394}<23.9 && {5edb7b51-f7d8-4cd1-bcd5-34b5bf7a2394}>1.7, !- Program Line 4
  SET {64f22a21-1799-421c-8b76-07538517b882} = 29.4, !- Program Line 5
  SET {928fbd01-94f7-42e6-8351-79e14bd159f7} = 15.6, !- Program Line 6
  ELSEIF DaylightSavings==1 && DayOfWeek>1 && Hour==4 && {5edb7b51-f7d8-4cd1-bcd5-34b5bf7a2394}<23.9 && {5edb7b51-f7d8-4cd1-bcd5-34b5bf7a2394}>1.7, !- Program Line 7
  SET {64f22a21-1799-421c-8b76-07538517b882} = 29.4, !- Program Line 8
  SET {928fbd01-94f7-42e6-8351-79e14bd159f7} = 15.6, !- Program Line 9
  ELSEIF DaylightSavings==1 && DayOfWeek==1 && Hour==6 && {5edb7b51-f7d8-4cd1-bcd5-34b5bf7a2394}<23.9 && {5edb7b51-f7d8-4cd1-bcd5-34b5bf7a2394}>1.7, !- Program Line 10
  SET {64f22a21-1799-421c-8b76-07538517b882} = 29.4, !- Program Line 11
  SET {928fbd01-94f7-42e6-8351-79e14bd159f7} = 15.6, !- Program Line 12
  ELSE,                                   !- Program Line 13
  SET {64f22a21-1799-421c-8b76-07538517b882} = NULL, !- Program Line 14
  SET {928fbd01-94f7-42e6-8351-79e14bd159f7} = NULL, !- Program Line 15
  ENDIF;                                  !- Program Line 16

