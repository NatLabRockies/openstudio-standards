OS:EnergyManagementSystem:Program,
  {19448daa-bda9-4280-b613-0032fb440910}, !- Handle
  ems_Auditorium_ZN_1_FLR_1_ZN_PSZ_AC_3_7_OptimumStartProg0, !- Name
  IF DaylightSavings==0 && DayOfWeek>1 && Hour==5 && {cd3ca05b-324a-4c59-86fe-5a4c17cdf7a2}<23.9 && {cd3ca05b-324a-4c59-86fe-5a4c17cdf7a2}>1.7, !- Program Line 1
  SET {4f650875-99ca-43c5-8137-db3202b3c122} = 29.4, !- Program Line 2
  SET {ace7ecde-652d-4091-94c3-25610cc5b294} = 15.6, !- Program Line 3
  ELSEIF DaylightSavings==0 && DayOfWeek==1 && Hour==7 && {cd3ca05b-324a-4c59-86fe-5a4c17cdf7a2}<23.9 && {cd3ca05b-324a-4c59-86fe-5a4c17cdf7a2}>1.7, !- Program Line 4
  SET {4f650875-99ca-43c5-8137-db3202b3c122} = 29.4, !- Program Line 5
  SET {ace7ecde-652d-4091-94c3-25610cc5b294} = 15.6, !- Program Line 6
  ELSEIF DaylightSavings==1 && DayOfWeek>1 && Hour==4 && {cd3ca05b-324a-4c59-86fe-5a4c17cdf7a2}<23.9 && {cd3ca05b-324a-4c59-86fe-5a4c17cdf7a2}>1.7, !- Program Line 7
  SET {4f650875-99ca-43c5-8137-db3202b3c122} = 29.4, !- Program Line 8
  SET {ace7ecde-652d-4091-94c3-25610cc5b294} = 15.6, !- Program Line 9
  ELSEIF DaylightSavings==1 && DayOfWeek==1 && Hour==6 && {cd3ca05b-324a-4c59-86fe-5a4c17cdf7a2}<23.9 && {cd3ca05b-324a-4c59-86fe-5a4c17cdf7a2}>1.7, !- Program Line 10
  SET {4f650875-99ca-43c5-8137-db3202b3c122} = 29.4, !- Program Line 11
  SET {ace7ecde-652d-4091-94c3-25610cc5b294} = 15.6, !- Program Line 12
  ELSE,                                   !- Program Line 13
  SET {4f650875-99ca-43c5-8137-db3202b3c122} = NULL, !- Program Line 14
  SET {ace7ecde-652d-4091-94c3-25610cc5b294} = NULL, !- Program Line 15
  ENDIF;                                  !- Program Line 16

