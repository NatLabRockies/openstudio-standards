  SET {766790b9-2fb3-4800-a3d0-87d912174221} = 15.6, !- Program Line 3
  ELSEIF DaylightSavings==0 && DayOfWeek==1 && Hour==7 && {ee71d573-b1d6-41b0-b315-39ce29a0975f}<23.9 && {ee71d573-b1d6-41b0-b315-39ce29a0975f}>1.7, !- Program Line 4
  SET {86f7931c-4004-46d3-977b-8c2038f1c51b} = 29.4, !- Program Line 5
  SET {766790b9-2fb3-4800-a3d0-87d912174221} = 15.6, !- Program Line 6
  ELSEIF DaylightSavings==1 && DayOfWeek>1 && Hour==4 && {ee71d573-b1d6-41b0-b315-39ce29a0975f}<23.9 && {ee71d573-b1d6-41b0-b315-39ce29a0975f}>1.7, !- Program Line 7
  SET {86f7931c-4004-46d3-977b-8c2038f1c51b} = 29.4, !- Program Line 8
  SET {766790b9-2fb3-4800-a3d0-87d912174221} = 15.6, !- Program Line 9
  ELSEIF DaylightSavings==1 && DayOfWeek==1 && Hour==6 && {ee71d573-b1d6-41b0-b315-39ce29a0975f}<23.9 && {ee71d573-b1d6-41b0-b315-39ce29a0975f}>1.7, !- Program Line 10
  SET {86f7931c-4004-46d3-977b-8c2038f1c51b} = 29.4, !- Program Line 11
  SET {766790b9-2fb3-4800-a3d0-87d912174221} = 15.6, !- Program Line 12
