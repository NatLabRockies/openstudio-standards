  ELSEIF DaylightSavings==0 && DayOfWeek==1 && Hour==7 && {7b227949-cb89-4596-a62b-b403515cbc68}<23.9 && {7b227949-cb89-4596-a62b-b403515cbc68}>1.7, !- Program Line 4
  SET {fe680da0-ccc5-4760-9d39-7eca7c902e54} = 29.4, !- Program Line 5
