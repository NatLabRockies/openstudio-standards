  {e56363ea-18f9-47b8-ad75-8345e57e4805}, !- Handle
  ems_Gym_ZN_1_FLR_1_ZN_PSZ_AC_1_5_OptimumStartProg0, !- Name
  IF DaylightSavings==0 && DayOfWeek>1 && Hour==5 && {d5a0c3d7-d429-4ad0-97fa-bdba808848f4}<23.9 && {d5a0c3d7-d429-4ad0-97fa-bdba808848f4}>1.7, !- Program Line 1
  SET {ad5fab32-f51e-47d3-8f6b-8a6ebca2df13} = 29.4, !- Program Line 2
  SET {7bcd84fb-8754-4c14-84f7-7b385e92f1cd} = 15.6, !- Program Line 3
  ELSEIF DaylightSavings==0 && DayOfWeek==1 && Hour==7 && {d5a0c3d7-d429-4ad0-97fa-bdba808848f4}<23.9 && {d5a0c3d7-d429-4ad0-97fa-bdba808848f4}>1.7, !- Program Line 4
  SET {ad5fab32-f51e-47d3-8f6b-8a6ebca2df13} = 29.4, !- Program Line 5
  SET {7bcd84fb-8754-4c14-84f7-7b385e92f1cd} = 15.6, !- Program Line 6
  ELSEIF DaylightSavings==1 && DayOfWeek>1 && Hour==4 && {d5a0c3d7-d429-4ad0-97fa-bdba808848f4}<23.9 && {d5a0c3d7-d429-4ad0-97fa-bdba808848f4}>1.7, !- Program Line 7
  SET {ad5fab32-f51e-47d3-8f6b-8a6ebca2df13} = 29.4, !- Program Line 8
  SET {7bcd84fb-8754-4c14-84f7-7b385e92f1cd} = 15.6, !- Program Line 9
  ELSEIF DaylightSavings==1 && DayOfWeek==1 && Hour==6 && {d5a0c3d7-d429-4ad0-97fa-bdba808848f4}<23.9 && {d5a0c3d7-d429-4ad0-97fa-bdba808848f4}>1.7, !- Program Line 10
  SET {ad5fab32-f51e-47d3-8f6b-8a6ebca2df13} = 29.4, !- Program Line 11
  SET {7bcd84fb-8754-4c14-84f7-7b385e92f1cd} = 15.6, !- Program Line 12
  ELSE,                                   !- Program Line 13
  SET {ad5fab32-f51e-47d3-8f6b-8a6ebca2df13} = NULL, !- Program Line 14
  SET {7bcd84fb-8754-4c14-84f7-7b385e92f1cd} = NULL, !- Program Line 15
