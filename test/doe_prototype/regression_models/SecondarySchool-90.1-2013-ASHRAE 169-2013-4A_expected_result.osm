  ELSEIF DaylightSavings==0 && DayOfWeek==1 && Hour==7 && {d14bd759-f846-4d87-804b-1719ecb01f61}<23.9 && {d14bd759-f846-4d87-804b-1719ecb01f61}>1.7, !- Program Line 4
  SET {a6d9bb66-b96c-4dac-89b6-6831c36d8169} = 29.4, !- Program Line 5
  SET {dd490125-8f58-46f4-94aa-540c6a378546} = 15.6, !- Program Line 6
